        "y0": 0.6148989898989898,
        "x1": 0.4526686200908586,
        "y1": 0.6287878787878788
      },
      "text": "DARHT is a LANL high-explosives (HE) firing",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5036195742538552,
        "y0": 0.6148926706025095,
        "x1": 0.7494300393497243,
        "y1": 0.6287815594913984
      },
      "text": "• have a very large field of view,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
