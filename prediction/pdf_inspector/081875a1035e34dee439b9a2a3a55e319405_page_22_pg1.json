        "y0": 0.6856060606060606,
        "x1": 0.4731300640729518,
        "y1": 0.6994949494949495
      },
      "text": "wherein the tested metals flow like fluids. Scientists",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
