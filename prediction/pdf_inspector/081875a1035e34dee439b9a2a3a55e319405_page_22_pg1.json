        "x1": 0.8664578705831291,
        "y1": 0.7701843338783341
      },
      "text": "• diagnose early-time implosion with pins, and",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
