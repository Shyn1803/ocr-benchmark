        "y0": 0.6502398866595644,
        "x1": 0.8762535145080167,
        "y1": 0.6641287755484533
      },
      "text": "• can “see through” transparent object features",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0773727130266576,
        "y0": 0.6679292929292929,
        "x1": 0.48649373397328494,
        "y1": 0.6818181818181819
      },
      "text": "tures and pressures generated by the detonating HE,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
