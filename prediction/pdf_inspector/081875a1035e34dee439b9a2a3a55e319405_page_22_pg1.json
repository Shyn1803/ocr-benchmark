      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.4991351358251634,
        "y0": 0.827020202020202,
        "x1": 0.8776882396024817,
        "y1": 0.8409090909090909
      },
      "text": "The manufacture of some W76 replacement com-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
