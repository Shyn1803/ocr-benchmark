        "x1": 0.48127008097765106,
        "y1": 0.7334827900226653
      },
      "text": "do not. Thus, our definition of violations becomes very",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
