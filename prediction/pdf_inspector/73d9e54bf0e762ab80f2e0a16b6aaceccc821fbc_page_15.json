        "x1": 0.8954115870842806,
        "y1": 0.7377388083825533
      },
      "text": "nism – i.e., the user must provide consent. The consent",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
