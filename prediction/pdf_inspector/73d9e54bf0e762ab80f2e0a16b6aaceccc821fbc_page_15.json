        "y0": 0.705134709100472,
        "x1": 0.4806477085020009,
        "y1": 0.7171038259289214
      },
      "text": "filing cookies need prior users’s consent, while all others",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
