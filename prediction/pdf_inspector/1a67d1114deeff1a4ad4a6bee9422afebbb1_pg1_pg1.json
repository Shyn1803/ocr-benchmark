        "x1": 0.574753484536972,
        "y1": 0.7747475298150311
      },
      "text": "fact that the majority of s95 appeals related to complex destitution appeals.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
