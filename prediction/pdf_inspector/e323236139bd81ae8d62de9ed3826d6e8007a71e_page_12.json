        "x0": 0.30769190475325797,
        "y0": 0.34061689023973474,
        "x1": 0.3589438063687192,
        "y1": 0.35053877195767547
      },
      "text": "landbrug",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11538438664350903,
        "y0": 0.36046724780815986,
        "x1": 0.20336861690361321,
        "y1": 0.3703891295261006
      },
      "text": "Kunstige gasser",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.30769190475325797,
        "y0": 0.36046724780815986,
        "x1": 0.48292768120651336,
        "y1": 0.3703891295261006
      },
      "text": "Freon fra køleanlæg og industri",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.36046724780815986,
        "x1": 0.8722685700301185,
        "y1": 0.3703891295261006
      },
      "text": "Graden af forurening med gasser, som ødelægger",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.3736931263658091,
        "x1": 0.7136649641302594,
        "y1": 0.3836150080837498
      },
      "text": "atmosfærens ozonlag",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11538438664350903,
        "y0": 0.3935401868679623,
        "x1": 0.24555953397862487,
        "y1": 0.40346206858590306
      },
      "text": "Tungmetaller, f.eks. bly",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.30769190475325797,
        "y0": 0.3935401868679623,
        "x1": 0.5483938483358621,
        "y1": 0.40346206858590306
      },
      "text": "Blyudvinding og afbrænding, minedrift og",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.3935401868679623,
        "x1": 0.8474425696866261,
        "y1": 0.40346206858590306
      },
      "text": "Graden af blyforurening, belastningen af det",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.30769190475325797,
        "y0": 0.40676606542561156,
        "x1": 0.3512627249920328,
        "y1": 0.4166879471435523
      },
      "text": "industri",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.40676606542561156,
        "x1": 0.7642818411419855,
        "y1": 0.4166879471435523
      },
      "text": "arktiske miljø fra tungmetaller",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11538438664350903,
        "y0": 0.4266131259277649,
        "x1": 0.268224189822824,
        "y1": 0.43653500764570563
      },
      "text": "Kulstof-14, beryllium-10 og",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3076919461607047,
        "y0": 0.4266131259277649,
        "x1": 0.46519655701571955,
        "y1": 0.43653500764570563
      },
      "text": "Naturlige radioaktive stoffer",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.4266131259277649,
        "x1": 0.837734345345643,
        "y1": 0.43653500764570563
      },
      "text": "Kosmisk stråling, Solens stråleintensitet og",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11538437629164734,
        "y0": 0.439839004485414,
        "x1": 0.15393625166618266,
        "y1": 0.44976088620335475
      },
      "text": "klor-36",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.439839004485414,
        "x1": 0.736732555839022,
        "y1": 0.44976088620335475
      },
      "text": "Jordens magnetfelt; alder",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11538438664350903,
        "y0": 0.45968606498756737,
        "x1": 0.2723150385269195,
        "y1": 0.4696079467055081
      },
      "text": "Cæsium-137 og strontium-90",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.30769190475325797,
        "y0": 0.45968606498756737,
        "x1": 0.5040536777360154,
        "y1": 0.4696079467055081
      },
      "text": "Menneskeskabte radioaktive stoffer",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.45968606498756737,
        "x1": 0.8768479851987074,
        "y1": 0.4696079467055081
      },
      "text": "Atombombesprængninger og A-kraftværksulykker",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11538438664350903,
        "y0": 0.4795298284234488,
        "x1": 0.1447043268335859,
        "y1": 0.48945171014138955
      },
      "text": "DNA",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.30769190475325797,
        "y0": 0.4795298284234488,
        "x1": 0.43779381266689127,
        "y1": 0.48945171014138955
      },
      "text": "Biologisk arvemateriale",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5961531974456739,
        "y0": 0.4795298284234488,
        "x1": 0.7811948784068538,
        "y1": 0.48945171014138955
      },
      "text": "Tidligere tiders plante- og dyreliv",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.2615380879846842,
        "y0": 0.5232668192395253,
        "x1": 0.5500401256047264,
        "y1": 0.5336296730577192
      },
      "text": "Ved at undersøge, hvorledes syren fra et givet ud-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.5231840897909291,
        "x1": 0.8846233099242529,
        "y1": 0.5335469436091231
      },
      "text": "så det kunne komme fra en anden vulkan. Men ved at",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.5386971230352273,
        "x1": 0.5499508511494803,
        "y1": 0.5490599768534212
      },
      "text": "brud fordeler sig i årlagene, kan vi desuden bestem -",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.5386143935866311,
        "x1": 0.8845723787647201,
        "y1": 0.5489772474048251
      },
      "text": "tage prøver ud fra iskernen i netop dette lag har man",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.5541274268309293,
        "x1": 0.5499635632356401,
        "y1": 0.5644902806491232
      },
      "text": "me, om udbruddet er sket langt fra Grønland, f.eks. i",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.5540446973823331,
        "x1": 0.8846106392455398,
        "y1": 0.5644075512005271
      },
      "text": "fundet mikroskopiske askepartikler. Og disse askepar-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.5695577306266313,
        "x1": 0.5499636046430869,
        "y1": 0.5799205844448252
      },
      "text": "Indonesien eller i Middelhavet, tættere på, f.eks. i",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.5694750011780351,
        "x1": 0.8845978857519332,
        "y1": 0.579837854996229
      },
      "text": "tiklers kemiske sammensætning har Santorinis kemi-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.5849880344223333,
        "x1": 0.4322542416224931,
        "y1": 0.5953508882405272
      },
      "text": "Alas ka, eller helt tæt på, i Island.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.584905304973737,
        "x1": 0.8846360634178594,
        "y1": 0.595268158791931
      },
      "text": "ske »fingeraftryk«. Vi er derfor overbevist om, at San-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.2615380879846842,
        "y0": 0.6004183382180353,
        "x1": 0.5499763581366934,
        "y1": 0.6107811920362292
      },
      "text": "Vesuvs udbrud i år 79 efter Kristi fødsel er det æld-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.600335608769439,
        "x1": 0.8845722959498266,
        "y1": 0.6106984625876329
      },
      "text": "torini i Grækenland eksploderede mellem år 1636 og",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.6158486420137372,
        "x1": 0.5499891116303001,
        "y1": 0.6262114958319311
      },
      "text": "ste udbrud, vi har historiske kilder om. Det var dette",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.615765912565141,
        "x1": 0.8845467889626134,
        "y1": 0.6261287663833349
      },
      "text": "år 1646 f.Kr. Vi regner nemlig med, at vi højst har talt",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.6312789458094392,
        "x1": 0.5500146186175132,
        "y1": 0.6416417996276331
      },
      "text": "udbrud, som begravede de romerske byer Pompeji og",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769133929316479,
        "y0": 0.6311962163608429,
        "x1": 0.8025622803510517,
        "y1": 0.6415590701790369
      },
      "text": "10 år forkert i denne dybde af iskernen.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.6467092496051412,
        "x1": 0.5500018237164598,
        "y1": 0.6570721034233351
      },
      "text": "Herculanum uden for Napoli. Det forhold, at vi fin -",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.6621395534008432,
        "x1": 0.5500274135185665,
        "y1": 0.6725024072190371
      },
      "text": "der spor af udbruddet netop i det rigtige år, bekræfter,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769228752369593,
        "y0": 0.6681262919009161,
        "x1": 0.8175325630281497,
        "y1": 0.6802530362228436
      },
      "text": "Aldersbestemmelse dybt nede i isen",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.6775698571965452,
        "x1": 0.5161264329176148,
        "y1": 0.6879327110147391
      },
      "text": "at vi tæller rigtigt i vores bestemmelser af årlag.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.2615380879846842,
        "y0": 0.6930001609922471,
        "x1": 0.5499763167292466,
        "y1": 0.7033630148104411
      },
      "text": "Tidspunktet for udbruddet, eller rettere eksplosio-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769228752369593,
        "y0": 0.6930412397465116,
        "x1": 0.8846455871306176,
        "y1": 0.7034040935647055
      },
      "text": "Efterhånden som lagene synker dybere ned i isen, bli-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.7084304479661825,
        "x1": 0.5499890702228533,
        "y1": 0.7187933017843764
      },
      "text": "nen af øen Santorini (Thera) i det Ægæiske Hav har",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769228752369593,
        "y0": 0.7084715267204468,
        "x1": 0.8139485828800219,
        "y1": 0.7188343805386407
      },
      "text": "ver de tyndere, og samtidig diffunderer",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8153884854341614,
        "y0": 0.7085855004979544,
        "x1": 0.8229596714471081,
        "y1": 0.715200088309915
      },
      "text": "16",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8229595886322145,
        "y0": 0.7084752779744192,
        "x1": 0.8606739880438721,
        "y1": 0.7188381317926132
      },
      "text": "O- og",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8621147187469471,
        "y0": 0.7085855004979544,
        "x1": 0.8697184510130587,
        "y1": 0.715200088309915
      },
      "text": "18",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8697186994577393,
        "y0": 0.7084752779744192,
        "x1": 0.8846156909540462,
        "y1": 0.7188381317926132
      },
      "text": "O-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.7238607349401177,
        "x1": 0.5499763167292466,
        "y1": 0.7342235887583117
      },
      "text": "stor arkæologisk betydning. Udbruddet skete i den",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.7239055649483546,
        "x1": 0.8846030202753332,
        "y1": 0.7342684187665485
      },
      "text": "iso toperne i isen så forskellene mellem sommer- og",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.7392910219140529,
        "x1": 0.5500273307036729,
        "y1": 0.749653875732247
      },
      "text": "minoiske periode, og både selve eksplosionen og den",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.7393358519222899,
        "x1": 0.884641280756153,
        "y1": 0.7496987057404838
      },
      "text": "vintersne langsomt bliver udvisket. Vi kan derfor ikke",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.7547213088879883,
        "x1": 0.5500018651239066,
        "y1": 0.7650841627061822
      },
      "text": "efterfølgende flodbølge ødelagde mange havnebyer i",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.7547661388962251,
        "x1": 0.8845902667817267,
        "y1": 0.7651289927144191
      },
      "text": "tælle årlag med isotoper hele vejen ned. Det viser sig,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.7701515958619236,
        "x1": 0.5500018651239066,
        "y1": 0.7805144496801175
      },
      "text": "Middelhavet. Ved at datere arkæologiske fund bl.a.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.7701964258701605,
        "x1": 0.8845775132881201,
        "y1": 0.7805592796883544
      },
      "text": "at mange andre af de målte stoffer også har sæson-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.7855818828358588,
        "x1": 0.5500146186175132,
        "y1": 0.7959447366540529
      },
      "text": "med kulstof 14-metoden mente arkæologerne, at ud-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.7856267128440957,
        "x1": 0.8845902667817267,
        "y1": 0.7959895666622897
      },
      "text": "mæssige udsving, og de overtager rollen som årlagsin-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.8010121698097941,
        "x1": 0.5499891116303001,
        "y1": 0.8113750236279881
      },
      "text": "bruddet skete 1400-1500 år f.Kr. Der har dog været",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.801056999818031,
        "x1": 0.8845775132881201,
        "y1": 0.8114198536362249
      },
      "text": "dikatorer. Særligt isens indhold af uopløselige mikro-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.8164424567837294,
        "x1": 0.5499636046430869,
        "y1": 0.8268053106019233
      },
      "text": "stor usikkerhed om tidspunktet. Iskernerne viser et",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.8164872867919664,
        "x1": 0.8846157737689399,
        "y1": 0.8268501406101603
      },
      "text": "partikler viser sig at være en god dateringsparameter.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.8318727437576647,
        "x1": 0.5499636046430869,
        "y1": 0.8422355975758586
      },
      "text": "lag med svovlsyre i år 1643 f.Kr. Imidlertid kan man",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.8319175737659016,
        "x1": 0.8846157737689399,
        "y1": 0.8422804275840955
      },
      "text": "De store forårsstorme bringer nemlig store mængder",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.8473030307316,
        "x1": 0.5499890702228533,
        "y1": 0.857665884549794
      },
      "text": "ikke ud fra svovlsyren alene bestemme, om dette lag",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.8473478607398368,
        "x1": 0.8846030202753332,
        "y1": 0.8577107145580308
      },
      "text": "støv ind over isen, således at vi kan se forhøjede kon-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.24230461881001472,
        "y0": 0.8627333177055353,
        "x1": 0.5499635632356401,
        "y1": 0.8730961715237292
      },
      "text": "virkelig stammer fra Santorini. Svovlsyre er svovlsyre,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5769185274550479,
        "y0": 0.8627781477137721,
        "x1": 0.8846030202753332,
        "y1": 0.873141001531966
      },
      "text": "centrationer af uopløselige mikropartikler i forårsla-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.718893068360019,
        "y0": 0.8978630436652885,
        "x1": 0.8846174300668108,
        "y1": 0.9088873566852227
      },
      "text": "indlandsisen på grønland",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
