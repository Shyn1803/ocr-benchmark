      },
      "text": "′",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7486266591190512,
        "y0": 0.7089958768902402,
        "x1": 0.8823526419845282,
        "y1": 0.7240908266317965
      },
      "text": "for some g ∈ G.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11764680949691074,
        "y0": 0.7267228906804866,
        "x1": 0.37392153771095027,
        "y1": 0.7418178404220427
      },
      "text": "If A is idempotent then A = A",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
