        "x1": 0.8325377905068277,
        "y1": 0.5270071142926069
      },
      "text": "In Problem 1 we pose an intriguing question about the structures of possible alge-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
