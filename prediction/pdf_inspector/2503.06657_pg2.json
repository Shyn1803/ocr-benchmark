        "y0": 0.6444948971129936,
        "x1": 0.47637118812368695,
        "y1": 0.658693472166809
      },
      "text": "Quasi relation algebras",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
