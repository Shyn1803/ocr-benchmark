        "y0": 0.4960567674251518,
        "x1": 0.7931367961409824,
        "y1": 0.5086358580926452
      },
      "text": "into resolution-based systems while preserving derivational structure. This extends",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
