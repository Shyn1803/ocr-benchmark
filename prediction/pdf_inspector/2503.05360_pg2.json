        "y0": 0.5831779795463639,
        "x1": 0.7929406259574142,
        "y1": 0.5957570702138573
      },
      "text": "(†)",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.20705832687078737,
        "y0": 0.6102993211360893,
        "x1": 0.6756851595211653,
        "y1": 0.6228784118035827
      },
      "text": "Each subformula χ of ϕ is associated with an basic counterpart χ",
      "html": null,
