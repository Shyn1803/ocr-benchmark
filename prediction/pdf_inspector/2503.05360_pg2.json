        "x1": 0.7931337044909109,
        "y1": 0.8207572590221058
      },
      "text": "More significantly, this bijection estab-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
