      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3704871426109506,
        "y0": 0.8799076091648563,
        "x1": 0.3765375730370273,
        "y1": 0.8870068729065377
      },
      "text": "0",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3858154040424764,
        "y0": 0.8682075600159707,
        "x1": 0.5779660008534664,
        "y1": 0.8811637352877728
      },
      "text": "have the following from:",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
