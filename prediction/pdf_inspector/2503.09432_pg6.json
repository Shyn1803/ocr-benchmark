        "y0": 0.45195366141348725,
        "x1": 0.8797325326615021,
        "y1": 0.4661522364673025
      },
      "text": "Thus, Dynamical degree comparison conjecture holds",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
