        "x1": 0.8816076961213365,
        "y1": 0.5685149843793191
      },
      "text": "80,9% of the participants are upper level manager. Rest of them are middle and lower level manager.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
