    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.47289157815883415,
        "y0": 0.5838828819137247,
        "x1": 0.8565123347359304,
        "y1": 0.5968407500186522
      },
      "text": "To showcase the effectiveness of our framework",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
