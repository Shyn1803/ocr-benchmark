        "x1": 0.3691948784722222,
        "y1": 0.7833496055217705
      },
      "text": "Mechanical anisotropy",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.20088893915313522,
        "y0": 0.7896392526048602,
        "x1": 0.7646386140312245,
        "y1": 0.8022182926987157
