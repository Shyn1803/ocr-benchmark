        "y0": 0.7254864675830108,
        "x1": 0.8231291428110958,
        "y1": 0.7380655076768663
      },
      "text": "15%, likely due to the disregarded plasticity in the",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
