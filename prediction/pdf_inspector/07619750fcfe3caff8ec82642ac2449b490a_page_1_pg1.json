      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.7681445407327097,
        "x1": 0.25595237603204,
        "y1": 0.7800225770557447
      },
      "text": "tiukalla tautisuojauksella. Jo-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
