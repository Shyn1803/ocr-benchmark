      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.6256080867318436,
        "x1": 0.9571583206190806,
        "y1": 0.6374861230548787
      },
      "text": "linen käsittely jopa levittää",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.6398617303194858,
        "x1": 0.25595237603204,
        "y1": 0.6517397666425209
      },
      "text": "gatiivisia, joten voidaan olet-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3032801597756755,
        "y0": 0.6398617303194858,
        "x1": 0.488102023131917,
        "y1": 0.6517397666425209
      },
      "text": "loilta, jotka on todettu IB-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.6398617303194858,
        "x1": 0.7250491706656871,
        "y1": 0.6517397666425209
      },
      "text": "Tällä hetkellä Suomessa ei",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.6398617303194858,
        "x1": 0.9570239004680182,
        "y1": 0.6517397666425209
      },
      "text": "rokotevirusta tilalta toiselle.",
