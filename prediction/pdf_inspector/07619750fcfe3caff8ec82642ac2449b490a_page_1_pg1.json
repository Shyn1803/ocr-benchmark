      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.7538908971450675,
        "x1": 0.26073018701541156,
        "y1": 0.7657689334681026
      },
      "text": "selvitään vain ehdottoman",
