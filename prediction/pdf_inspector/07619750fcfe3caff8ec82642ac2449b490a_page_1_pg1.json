      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.66836901749477,
        "x1": 0.25595237603204,
        "y1": 0.680247053817805
      },
      "text": "pikarjayksiköt ovat IB-tartun-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3035712752706439,
        "y0": 0.66836901749477,
        "x1": 0.4880951021859241,
        "y1": 0.680247053817805
      },
      "text": "- Siipikarja maahantuo-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
