      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.7396372535574255,
        "x1": 0.9523804071031757,
        "y1": 0.7515152898804606
      },
      "text": "muusta syystä johtuva rokot-",
