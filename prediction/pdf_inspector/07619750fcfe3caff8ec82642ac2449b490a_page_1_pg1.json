      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3035712752706439,
        "y0": 0.7538908971450675,
        "x1": 0.49274402977502774,
        "y1": 0.7657689334681026
      },
      "text": "reisiin on heti reagoitava:",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5357138764630032,
        "y0": 0.7538908971450675,
        "x1": 0.7247690517849074,
        "y1": 0.7657689334681026
      },
      "text": "Rokotusten mahdollinen",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.7538908971450675,
        "x1": 0.9570407158034677,
        "y1": 0.7657689334681026
      },
      "text": "teiden tehon heikentyminen,",
