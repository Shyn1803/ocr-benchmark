      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.7681445407327097,
        "x1": 0.7202376264788833,
        "y1": 0.7800225770557447
      },
      "text": "käyttöönotto vaatii huolellis-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.7681445407327097,
        "x1": 0.9343118165000879,
        "y1": 0.7800225770557447
      },
      "text": "parven epätasaisuus jne.).",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
