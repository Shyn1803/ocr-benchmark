      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3032801597756755,
        "y0": 0.682622661082412,
        "x1": 0.4880951021859241,
        "y1": 0.6945006974054471
      },
      "text": "daan ETT:n ohjeiden mu-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.682622661082412,
        "x1": 0.7202376264788833,
        "y1": 0.6945006974054471
      },
      "text": "n varalta. Päätös niiden mah-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.682622661082412,
        "x1": 0.9570407158034677,
        "y1": 0.6945006974054471
      },
      "text": "tä tai toisesta epäonnistuttua",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.07142854591261817,
        "y0": 0.6968763227944992,
        "x1": 0.25595237282789834,
        "y1": 0.7087543591175343
      },
      "text": "Tuotantosiipikarjan suo-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3032801597756755,
        "y0": 0.6968763227944992,
        "x1": 0.49285604656757964,
        "y1": 0.7087543591175343
      },
      "text": "kaisesti. Karanteeniaikana",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.6968763227944992,
        "x1": 0.7202376264788833,
        "y1": 0.7087543591175343
      },
      "text": "dollisesta käyttöönotosta tuo-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.6968763227944992,
        "x1": 0.9570575311389171,
        "y1": 0.7087543591175343
      },
      "text": "(virusten muuntautumiskyky,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.7111299663821413,
        "x1": 0.2606125821997987,
        "y1": 0.7230080027051764
      },
      "text": "jaaminen tartunnalta, joka jo",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3032801597756755,
        "y0": 0.7111299663821413,
        "x1": 0.4880951021859241,
        "y1": 0.7230080027051764
      },
      "text": "linnut tutkitaan IB:n varal-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.7111299663821413,
        "x1": 0.724981960590156,
        "y1": 0.7230080027051764
      },
      "text": "tantosiipikarjatiloilla tehdään",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.7111299663821413,
        "x1": 0.8785225322476465,
        "y1": 0.7230080027051764
      },
      "text": "rokotustekniikka,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8885850750586703,
        "y0": 0.7111299663821413,
        "x1": 0.9523804071031757,
        "y1": 0.7230080027051764
      },
      "text": "rokottei-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
