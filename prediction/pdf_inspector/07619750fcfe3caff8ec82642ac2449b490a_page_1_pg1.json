      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3032801597756755,
        "y0": 0.7253836099697835,
        "x1": 0.32101982601216705,
        "y1": 0.7372616462928185
      },
      "text": "ta.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.7253836099697835,
        "x1": 0.7202376264788833,
        "y1": 0.7372616462928185
      },
      "text": "jatkossa yhteisesti alan ja vi-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.7253836099697835,
        "x1": 0.9570407158034677,
        "y1": 0.7372616462928185
      },
      "text": "den väärästä säilytyksestä tai",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.7396372535574255,
        "x1": 0.2606125821997987,
        "y1": 0.7515152898804606
      },
      "text": "on uudenlainen haaste. Siitä",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.27976165743390463,
        "y0": 0.7396372535574255,
        "x1": 0.2923104603769145,
        "y1": 0.7515152898804606
      },
      "text": "l",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3035712752706439,
        "y0": 0.7396372535574255,
        "x1": 0.4880951021859241,
        "y1": 0.7515152898804606
      },
      "text": "Kaikkiin epäilyttäviin oi-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
