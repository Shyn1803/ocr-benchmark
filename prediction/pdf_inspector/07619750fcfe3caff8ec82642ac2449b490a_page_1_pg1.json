      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3035712752706439,
        "y0": 0.7681445407327097,
        "x1": 0.4880951021859241,
        "y1": 0.7800225770557447
      },
      "text": "lintuja ei myydä eteen-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
