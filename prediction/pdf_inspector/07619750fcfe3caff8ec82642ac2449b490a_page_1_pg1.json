      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.7966518279079938,
        "x1": 0.25595237603204,
        "y1": 0.8085298642310289
      },
      "text": "päivittäisiä rutiinejaan kriitti-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3035712752706439,
        "y0": 0.7966518279079938,
        "x1": 0.4880951021859241,
        "y1": 0.8085298642310289
      },
      "text": "pakkaamolle, mikäli lin-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.7966518279079938,
        "x1": 0.7248980377117086,
        "y1": 0.8085298642310289
      },
      "text": "vät lisätyötä ja kustannuksia",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.7966518279079938,
        "x1": 0.9523804071031757,
        "y1": 0.8085298642310289
      },
      "text": "tus ei käytännössä ole mah-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.810905471495636,
        "x1": 0.25595237603204,
        "y1": 0.822783507818671
      },
      "text": "sesti ja ryhtyä korjaaviin toi-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3035712752706439,
