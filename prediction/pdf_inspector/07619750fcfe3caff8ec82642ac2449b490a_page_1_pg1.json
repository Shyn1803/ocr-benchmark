        "y0": 0.6541153739071279,
        "x1": 0.25595237603204,
        "y1": 0.665993410230163
      },
      "text": "taa, että Suomen tuotantosii-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3032801597756755,
        "y0": 0.6541153739071279,
        "x1": 0.3663601479689805,
        "y1": 0.665993410230163
      },
      "text": "vapaiksi.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.6541153739071279,
        "x1": 0.7202376264788833,
        "y1": 0.665993410230163
      },
      "text": "ole käytettävissä elävää vi-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.6541153739071279,
        "x1": 0.9571246899481817,
        "y1": 0.665993410230163
      },
      "text": "Taudinpurkauksia havaitaan",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
