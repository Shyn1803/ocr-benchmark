      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.7823981843203518,
        "x1": 0.2605621361934504,
        "y1": 0.7942762206433869
      },
      "text": "kaisen on nyt syytä tarkastella",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3035712752706439,
        "y0": 0.7823981843203518,
        "x1": 0.49274402977502774,
        "y1": 0.7942762206433869
      },
      "text": "päin eikä munia toimiteta",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119043867919304,
        "y0": 0.7823981843203518,
        "x1": 0.7202376264788833,
        "y1": 0.7942762206433869
      },
      "text": "ta valmistelua. Ne merkitse-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7678566058210289,
        "y0": 0.7823981843203518,
        "x1": 0.9523804071031757,
        "y1": 0.7942762206433869
      },
      "text": "Harrastekanaloissa roko-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
