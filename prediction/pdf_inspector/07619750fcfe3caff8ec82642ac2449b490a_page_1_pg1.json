        "y0": 0.66836901749477,
        "x1": 0.7202279371544933,
        "y1": 0.680247053817805
      },
      "text": "rusta sisältäviä rokotteita IB:",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7440471161499561,
        "y0": 0.66836901749477,
        "x1": 0.9523804071031757,
        "y1": 0.680247053817805
      },
      "text": "myös esim. rokotusten syys-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.04761891846345389,
        "y0": 0.682622661082412,
        "x1": 0.1508483525035239,
        "y1": 0.6945006974054471
      },
      "text": "nasta vapaita.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
