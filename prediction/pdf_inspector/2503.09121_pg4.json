        "y1": 0.7303804773616112
      },
      "text": "of |A| and |B| are smaller than 3.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.12383076643743435,
