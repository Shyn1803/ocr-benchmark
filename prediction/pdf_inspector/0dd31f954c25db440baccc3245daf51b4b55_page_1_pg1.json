      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08551881413911061,
        "y0": 0.6939491216213473,
        "x1": 0.4419503308031234,
        "y1": 0.709274204828406
      },
      "text": "This workshop focusses eco-cosmology as a worldview prevalent in shamanic",
