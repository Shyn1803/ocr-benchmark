      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5210946422708845,
        "y0": 0.5697555506742129,
        "x1": 0.6065540103484632,
        "y1": 0.5850806338812715
      },
      "text": "world and cosmos.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
