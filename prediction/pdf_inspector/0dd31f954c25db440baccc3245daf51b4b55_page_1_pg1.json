        "x1": 0.8453731616609952,
        "y1": 0.6737903164279077
      },
      "text": "Descola, Philippe 1992. Societies of nature and the nature of society. In",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
