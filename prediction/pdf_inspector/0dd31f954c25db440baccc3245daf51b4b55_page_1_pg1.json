      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08551881413911061,
        "y0": 0.7116910530033932,
        "x1": 0.43510888656796,
        "y1": 0.7270161362104519
      },
      "text": "cultures worldwide. Contemporary shamanisms are embedded in analogous",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
