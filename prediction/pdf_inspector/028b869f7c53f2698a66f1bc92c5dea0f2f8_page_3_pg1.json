        "x1": 0.9342542957489468,
        "y1": 0.3787335341881436
      },
      "text": "verbindungen bilden können. Durch gezielte Zugaben",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
