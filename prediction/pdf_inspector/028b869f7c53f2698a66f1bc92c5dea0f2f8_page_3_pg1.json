        "x1": 0.9313060752885007,
        "y1": 0.4440507718310883
      },
      "text": "zu verzeichnen. Wie erwartet, wird das Chlor überwiegend",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": null,
