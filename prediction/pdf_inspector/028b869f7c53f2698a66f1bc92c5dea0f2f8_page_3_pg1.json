        "x1": 0.9328784116855564,
        "y1": 0.45711421935967733
      },
      "text": "im Staub des Ofengases als Calciumchlorid gebunden.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
