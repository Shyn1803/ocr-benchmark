        "y0": 0.4594874341975347,
        "x1": 0.931699185020898,
        "y1": 0.47017766688826623
      },
      "text": "Daher ist im Abgas des Elektroniederschachtofens keine",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5768250646548828,
        "y0": 0.4725508817261237,
        "x1": 0.9285694819766378,
        "y1": 0.48324111441685524
      },
      "text": "Steigerung der Dioxinwerte messbar. Auch die Schwer-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
