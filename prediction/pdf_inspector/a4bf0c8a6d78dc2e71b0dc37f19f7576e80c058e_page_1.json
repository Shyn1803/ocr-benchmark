    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08823529411764706,
        "y0": 0.5828867825594815,
        "x1": 0.34113236969592525,
        "y1": 0.5942504189231179
      },
      "text": "Your fleet has moved into a Dust Cloud.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.058823529411764705,
        "y0": 0.5954629146691525,
        "x1": 0.34115443510167737,
        "y1": 0.6068265510327888
      },
      "text": "Anyone shooting at you, or anyone you at-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.058823529411764705,
        "y0": 0.6081901704422151,
        "x1": 0.34111621333103553,
        "y1": 0.6195538068058515
      },
      "text": "tack, has a penalty of one Electronic War-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
