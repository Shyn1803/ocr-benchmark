        "y0": 0.5310291629849058,
        "x1": 0.8736426658879698,
        "y1": 0.543656435879794
      },
      "text": "ONE EW POINT PENALTY",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
