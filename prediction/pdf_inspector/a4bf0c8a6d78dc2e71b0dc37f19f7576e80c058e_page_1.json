        "y0": 0.7469799157344934,
        "x1": 0.1200882406795726,
        "y1": 0.7583435520981298
      },
      "text": "NEBULA",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
