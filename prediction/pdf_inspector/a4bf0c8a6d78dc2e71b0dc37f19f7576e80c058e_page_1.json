        "y0": 0.633342434661557,
        "x1": 0.34168677236519607,
        "y1": 0.6447060710251933
      },
      "text": "dividual attack card used by one point.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.058823529411764705,
        "y0": 0.6460696904346197,
        "x1": 0.3411264855877247,
        "y1": 0.657433326798256
      },
      "text": "(Tholian ships have no special benefit.) This",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
