        "y0": 0.5613345822902641,
        "x1": 0.6003704195708232,
        "y1": 0.5739618551851523
      },
      "text": "CANNOT ATTACK THOLIANS",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
