      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.058823529411764705,
        "y0": 0.7975867300322561,
        "x1": 0.34121616837245966,
        "y1": 0.8089503663958926
      },
      "text": "either. Your fleet cannot use a Wild Weasel",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
