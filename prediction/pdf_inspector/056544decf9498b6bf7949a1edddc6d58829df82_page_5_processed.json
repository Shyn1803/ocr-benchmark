        "y0": 0.7185837141872131,
        "x1": 0.8588069246027215,
        "y1": 0.7316965989765674
      },
      "text": ".  Estas obras, que sirven como referencia para la",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
