        "x1": 0.9048995390832888,
        "y1": 0.4900745014449446
      },
      "text": "Minbarra l-kitba Fr. Adami kellu sehem f ’radjijiet tal-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
