        "y0": 0.6962408435013501,
        "x1": 0.652870266041771,
        "y1": 0.712870094353599
      },
      "text": "Issa u l-ġejjieni",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
