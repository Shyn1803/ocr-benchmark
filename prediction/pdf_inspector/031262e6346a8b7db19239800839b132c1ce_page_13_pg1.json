        "y0": 0.7443373934004238,
        "x1": 0.7498253370600361,
        "y1": 0.7574032333557624
      },
      "text": "festa  ta’ San  Lawrenz u għal Għid.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524993576582871,
        "y0": 0.759161177656727,
        "x1": 0.4915283592030899,
        "y1": 0.7722270176120656
      },
      "text": "l-karozza fil-garaxx taċ-ċentru u mmur ix-xogħol bil-karozza",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
