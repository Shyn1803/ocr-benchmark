        "y0": 0.7146327872591728,
        "x1": 0.49150995461337543,
        "y1": 0.7276986272145114
      },
      "text": "provinċjali u magħha hemm iċ-ċentru tal-Maltin ftit il-barra",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119473991896196,
        "y0": 0.7146517998020544,
        "x1": 0.9082627087057097,
        "y1": 0.727717639757393
      },
      "text": "Bħalissa  hu għadu jagħti s-sehem tiegħu f ’ Parkville,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524993576582871,
        "y0": 0.7294755840583576,
        "x1": 0.49162063848299536,
        "y1": 0.742541424013696
      },
      "text": "mil-Belt propja u hemm kont niltaqa’ miegħu. Fil-fatt jien",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119473991896196,
        "y0": 0.7294945966012392,
        "x1": 0.9082997229502051,
        "y1": 0.7425604365565777
      },
      "text": "l-Awstralja  u jiġi Malta  għall-vaganzi  speċjalment  għall-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524993576582871,
        "y0": 0.7443183808575422,
        "x1": 0.4913990144124224,
        "y1": 0.7573842208128808
      },
      "text": "meta kien imissni xogħol fl-uffiċċju tas-City kont nipparkja",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
