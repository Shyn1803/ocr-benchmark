        "y0": 0.6552461580352318,
        "x1": 0.9082997229502051,
        "y1": 0.6683119979905703
      },
      "text": "Dwar il-każin hu qal li jsiru ħafna attivitajiet sbieħ li ma’",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524993576582871,
        "y0": 0.6701043968616187,
        "x1": 0.49163919687150964,
        "y1": 0.6831702368169572
      },
      "text": "Sant’Agata , r-Rabat. Sena wara reġa intbagħat fl-ewwel art",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
