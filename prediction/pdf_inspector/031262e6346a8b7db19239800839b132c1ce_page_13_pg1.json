        "y0": 0.699789990459988,
        "x1": 0.49128817674400266,
        "y1": 0.7128558304153267
      },
      "text": "eżattament f ’Parkville, Melbourne.  Din hija d-dar",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
