        "y0": 0.655261600062434,
        "x1": 0.49162074101552855,
        "y1": 0.6683274400177726
      },
      "text": "Fis- sena 1988 hu  ntbagħat  lura Malta fejn kien joqgħod",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
