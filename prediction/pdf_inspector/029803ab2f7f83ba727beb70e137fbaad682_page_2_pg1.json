      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6906262792722143,
        "y0": 0.8194771186978209,
        "x1": 0.9746069089330808,
        "y1": 0.8374509749069713
      },
      "text": "These are thin tattoo lines to indicate",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.350171715322167,
        "y0": 0.8423856224109924,
        "x1": 0.6596383759469697,
        "y1": 0.8603594786201427
      },
      "text": "If anything, it’s the opposite.   Our vets",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6906262792722143,
