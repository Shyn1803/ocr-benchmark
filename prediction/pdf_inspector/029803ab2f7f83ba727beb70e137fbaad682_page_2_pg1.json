      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6906262792722143,
        "y0": 0.7737254847108928,
        "x1": 0.9733068292791193,
        "y1": 0.7916993409200431
      },
      "text": "female rabbit has two small dark lines,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.350171715322167,
        "y0": 0.7966176450642106,
        "x1": 0.657939795291785,
        "y1": 0.8145915012733609
      },
      "text": "private practice spay/neuter rates.   Does",
