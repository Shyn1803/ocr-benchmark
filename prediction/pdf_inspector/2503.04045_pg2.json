        "y0": 0.7749966407063031,
        "x1": 0.46215421389910133,
        "y1": 0.7875757313737966
      },
      "text": "addition, for sufficiently large k ≥ k",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.46215446322571996,
        "y0": 0.7805888393912652,
