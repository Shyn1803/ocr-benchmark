      },
      "text": "Course Description:",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11768627790064594,
        "y0": 0.6767550574408637,
        "x1": 0.8801537058711831,
        "y1": 0.6919065725923789
      },
      "text": "This course in public rhetoric and practical communication examines the use of digital media as",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.11768627790064594,
        "y0": 0.6952399051550663,
        "x1": 0.8610653596765855,
        "y1": 0.7103914203065814
      },
      "text": "a demonstration of expertise, and gives students opportunities to create their own expertise-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
