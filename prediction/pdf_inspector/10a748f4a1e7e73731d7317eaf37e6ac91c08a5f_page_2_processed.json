        "y0": 0.8478471004601681,
        "x1": 0.9191846411212597,
        "y1": 0.8598420499551176
      },
      "text": "Pain before (p<0.001) and after PrePex device removal (p = 0.001) were associated with",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
