        "y1": 0.8775226034299292
      },
      "text": "discharge status, although very few cases were reported, and pain was more commonly",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.05882310555651297,
        "y0": 0.8850987475327771,
        "x1": 0.21090748107511234,
        "y1": 0.8951996311996923
      },
      "text": "that no competing interests exist.",
