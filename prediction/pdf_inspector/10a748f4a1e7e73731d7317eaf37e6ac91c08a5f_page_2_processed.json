        "x0": 0.326817805470984,
        "y0": 0.8301665469853565,
        "x1": 0.941202375623915,
        "y1": 0.842161496480306
      },
      "text": "problems that could delay the healing time. Most (70.7%) defaulted before formal discharge.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
