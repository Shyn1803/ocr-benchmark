        "x1": 0.2797549752628102,
        "y1": 0.7689305315114031
      },
      "text": "publicly available are that these data are clients’",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.05882310555651297,
        "y0": 0.772716340392527,
        "x1": 0.2803288378746681,
