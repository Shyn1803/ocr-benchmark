      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6803634420341363,
        "y0": 0.4202211864358022,
        "x1": 0.9047517897029068,
        "y1": 0.4332870263911408
      },
      "text": "Wagner kien ħareġ bil-komposiz-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.4306865310120681,
        "x1": 0.3359550736660652,
        "y1": 0.4437523709674066
      },
      "text": "opra sempliċiment meta tismagħha",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6803634420341363,
        "y0": 0.4359002088817645,
        "x1": 0.7377401862322845,
        "y1": 0.4489660488371031
      },
      "text": "zjoni ta’",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7378510751669709,
        "y0": 0.4359002088817645,
        "x1": 0.9009820785862357,
        "y1": 0.4489660488371031
      },
      "text": "Sinfonija in Do maggiore",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.9009820785862357,
        "y0": 0.4359002088817645,
        "x1": 0.9082627087057097,
        "y1": 0.4489660488371031
      },
      "text": ",",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.4463655534580304,
        "x1": 0.33601051813340843,
        "y1": 0.459431393413369
      },
      "text": "l-ewwel darba, imma żgur li mhux",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "picture",
      "box": {
        "page": 0,
        "x0": 0.3428568460752607,
        "y0": 0.15169317811894956,
        "x1": 0.6700048877996825,
        "y1": 0.46465130609217054
      },
      "text": "[Image: Im0]",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6803634420341363,
        "y0": 0.4515792313277269,
        "x1": 0.9047517897029068,
        "y1": 0.4646450712830654
      },
      "text": "liema sinfonija smajt u li vera-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.46204457590399284,
        "x1": 0.33604748111163724,
        "y1": 0.47511041585933134
      },
      "text": "se nismagħha t-tieni darba. Aktar",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6803634420341363,
        "y0": 0.46725825377368924,
        "x1": 0.9082811645616908,
        "y1": 0.48032409372902785
      },
      "text": "ment għoġbitni u nirrakomanda",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.47772359834995515,
        "x1": 0.2985169853114223,
        "y1": 0.49078943830529376
      },
      "text": "riċenti, Woody Allen fil-film",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3004572597039677,
        "y0": 0.47772359834995515,
        "x1": 0.48799882413722273,
        "y1": 0.49078943830529376
      },
      "text": "Manhatten Murder Mystery",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.48293727621965166,
        "x1": 0.9082629137707762,
        "y1": 0.49600311617499016
      },
      "text": "lill-qarreja biex jisimgħu. Minn hawn, Wagner ma’ ħarisx",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.49340262079591746,
        "x1": 0.4881281689278902,
        "y1": 0.5064684607512562
      },
      "text": "qal li hu ma jistax jisma ħafna mużika ta’ Wagner għax in-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.49861629866561397,
        "x1": 0.8177350433316595,
        "y1": 0.5116821386209526
      },
      "text": "lura u beda jikkomponi l-ewwel opra tiegħu",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8183817672849969,
        "y0": 0.49861629866561397,
        "x1": 0.9047333338469257,
        "y1": 0.5116821386209526
      },
      "text": "Die Hochzeit",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.5090816432418799,
        "x1": 0.4919163359005424,
        "y1": 0.5221474831972184
      },
      "text": "kella jqanqal fih l-aptit li jinvadi l-Polonja. F’idejkhom biex",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.5142953211115764,
        "x1": 0.5909259538196359,
        "y1": 0.5273611610669149
      },
      "text": "(iż-żwieġ).",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.5247606656878423,
        "x1": 0.49160227875126417,
        "y1": 0.5378265056431808
      },
      "text": "tiddeċiedu jekk għandhomx raġun, kemm mill-ħajja tiegħu",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.5404396881338046,
        "x1": 0.49178709364240814,
        "y1": 0.5535055280891432
      },
      "text": "u kemm, forsi għal min jinteressah jisma naqra mużika",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.5456533297546109,
        "x1": 0.9078562697439928,
        "y1": 0.5587191697099495
      },
      "text": "Fl-1833, ta’ 20 sena, wara li ħuh Albert kien irranġalu, daħal",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.5561187105797669,
        "x1": 0.35419371447551223,
        "y1": 0.5691845505351055
      },
      "text": "tiegħu, mill-kompożizzjonijiet tiegħu.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.5613323522005733,
        "x1": 0.9082998254827384,
        "y1": 0.5743981921559118
      },
      "text": "surmast tal-kor tat-teatru ta’ Wurzberg. Fl-istess sena, kien",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.5770113746465356,
        "x1": 0.634739233125947,
        "y1": 0.5900772146018742
      },
      "text": "lesta l-opra tiegħu",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6337413865125694,
        "y0": 0.5770113746465356,
        "x1": 0.6890115485492759,
        "y1": 0.5900772146018742
      },
      "text": "Die Feen",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6889006596145896,
        "y0": 0.5770113746465356,
        "x1": 0.9082627087057097,
        "y1": 0.5900772146018742
      },
      "text": "(The Fairies). Interessanti ħafna",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.5874767192228015,
        "x1": 0.49158377162901645,
        "y1": 0.6005425591781401
      },
      "text": "Wagner twieled f ’Leipzig, nhar it-22 ta’ Mejju 1813. Kien",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.5926903970924979,
        "x1": 0.9082998254827384,
        "y1": 0.6057562370478365
      },
      "text": "li din l-opra indaqqet l-ewwel darba fl-1883 wara l-mewt",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.6031557416687638,
        "x1": 0.4916577488517407,
        "y1": 0.6162215816241025
      },
      "text": "id-disa’ wild ta’ Carl Freidrich Wagner (skrivan mal-pulizija",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.6083694195384604,
        "x1": 0.9082813696267572,
        "y1": 0.6214352594937989
      },
      "text": "ta’ Wagner stess. Fl-1834, Wagner laħaq surmast direttur",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.6188347641147263,
        "x1": 0.491565367039302,
        "y1": 0.6319006040700648
      },
      "text": "ta’ Leipzig) u Johanna Rosine nee Paetz. Wara biss 6 xhur",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.6240484419844228,
        "x1": 0.9084661332516346,
        "y1": 0.6371142819397613
      },
      "text": "tat-Teatru tal-Opra Magdeburg, fejn hemm kiteb l-opra",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.6345137865606886,
        "x1": 0.491546757384521,
        "y1": 0.6475796265160272
      },
      "text": "mit-twelid, missier Wagner miet, u ommu Johanna marret",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.639727464430385,
        "x1": 0.6241323963622809,
        "y1": 0.6527933043857237
      },
      "text": "Das Liebesverbot",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6241323963622809,
        "y0": 0.639727464430385,
        "x1": 0.9081704294258043,
        "y1": 0.6527933043857237
      },
      "text": "(The ban of love) li kienet ibbażata fuq",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.6501928090066509,
        "x1": 0.4915469111833209,
        "y1": 0.6632586489619896
      },
      "text": "tgħix mal-ħabib ta’ Carl, Ludwig Geyer. Dan Geyer kien",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.6554064868763474,
        "x1": 0.6715860419945958,
        "y1": 0.668472326831686
      },
      "text": "ir-reċta ta’ Shakespeare",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6711610446443645,
        "y0": 0.6554064868763474,
        "x1": 0.8067586793182385,
        "y1": 0.668472326831686
      },
      "text": "Measure for Measure",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8067586793182385,
        "y0": 0.6554064868763474,
        "x1": 0.9082443553822618,
        "y1": 0.668472326831686
      },
      "text": ". Din indaqqet",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499293575454,
        "y0": 0.6658718314526133,
        "x1": 0.48809125721592805,
        "y1": 0.6789376714079519
      },
      "text": "attur u skrittur, u x’uħud jaħsbu li kien hu l-verament mis-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.6710855093223098,
        "x1": 0.908244457914795,
        "y1": 0.6841513492776483
      },
      "text": "darba fl-1836 għaliex it-teatru kien falla finanzjarjament.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.6815508538985757,
        "x1": 0.49162073460724526,
        "y1": 0.6946166938539142
      },
      "text": "sier. Li hu zgur hu li Johanna kienet issetiljat ma’ Geyer.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.6867645136438271,
        "x1": 0.9082629137707762,
        "y1": 0.6998303535991657
      },
      "text": "Minn hemm, Wagner kien iltaqa’ ma’ Christine Wilhelmine",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.697229858220093,
        "x1": 0.22077658791953755,
        "y1": 0.7102956981754316
      },
      "text": "Fl-awtobijografija",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.2212570553702453,
        "y0": 0.697229858220093,
        "x1": 0.29870180020256626,
        "y1": 0.7102956981754316
      },
      "text": "Mein Leben",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.29870180020256626,
        "y0": 0.697229858220093,
        "x1": 0.49162073460724526,
        "y1": 0.7102956981754316
      },
      "text": ", Wagner jiftakar li darba ħa",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.7024435179653443,
        "x1": 0.9082997229502051,
        "y1": 0.7155093579206829
      },
      "text": "Planer ‘’Minna’’, u li kien iżżewwiġha fl-24 ta’ Novembru",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524996780724536,
        "y0": 0.7129088625416102,
        "x1": 0.4915838357118497,
        "y1": 0.7259747024969488
      },
      "text": "sehem f ’reċta bħala anġlu. Fl-1820, Wagner daħal fl-iskola",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.7181225222868617,
        "x1": 0.908226002058814,
        "y1": 0.7311883622422002
      },
      "text": "1836. Sena wara, Minna telqitu ma’ raġel ieħor, iżda wara",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524996780724536,
        "y0": 0.7285878668631276,
        "x1": 0.49162090122261176,
        "y1": 0.7416537068184661
      },
      "text": "Pastor Wetzel ta’ Possendorf fejn kien qed jirċievi xi tagħlim",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.7338015266083788,
        "x1": 0.9082997229502051,
        "y1": 0.7468673665637175
      },
      "text": "li Wagner mar fir-Russja bħala direttur muzikali, permezz",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524996780724536,
        "y0": 0.7442668711846447,
        "x1": 0.4880912700324947,
        "y1": 0.7573327111399835
      },
      "text": "tal-pjano, liema tagħlim sabu diffiċli ferm, tant li kien jip-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.7494805309298962,
        "x1": 0.9046595104230013,
        "y1": 0.7625463708852348
      },
      "text": "ta’ oħt Minna Amalie, kien reġa irranġa ma Minna fl-1838.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.7599458755061621,
        "x1": 0.39111439803435194,
        "y1": 0.7730117154615007
      },
      "text": "preferi li jdoqq bl-udit milli jaqra l-mużika.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.7651595352514134,
        "x1": 0.9082443553822618,
        "y1": 0.7782253752067521
      },
      "text": "Fl-1839, il-koppja Wagner akkumulat numru kbir ta’ djun,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.7808385395729307,
        "x1": 0.9081704294258043,
        "y1": 0.7939043795282693
      },
      "text": "tant, li kellhom jemigraw lejn Riga, u wara lejn Pariġi. F’",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.7913039022736418,
        "x1": 0.49163924172949297,
        "y1": 0.8043697422289804
      },
      "text": "Wara l-mewt ta’ Ludwig Geyer, ħu Ludwig kien ħallaslu li",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.7965175438944481,
        "x1": 0.9082073411377665,
        "y1": 0.8095833838497867
      },
      "text": "dan il-vjaġġ abbord xini, f ’lejl ta’ maltemp, Wagner ġietu",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.806982906595159,
        "x1": 0.1454014879035628,
        "y1": 0.8200487465504976
      },
      "text": "jmur il-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.1454014879035628,
        "y0": 0.806982906595159,
        "x1": 0.2459817247997804,
        "y1": 0.8200487465504976
      },
      "text": "boarding school",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.2459817247997804,
        "y0": 0.806982906595159,
        "x1": 0.49158372036274983,
        "y1": 0.8200487465504976
      },
      "text": "Kreuzschule. F’din l-eta’ tant tenera",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.8121965482159653,
        "x1": 0.735134680764154,
        "y1": 0.8252623881713039
      },
      "text": "l-ispirazzjoni biex jikteb l-opra",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7369086986540697,
        "y0": 0.8121965482159653,
        "x1": 0.9048072598033833,
        "y1": 0.8252623881713039
      },
      "text": "Der Fliegende Hollander",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.8226619109166763,
        "x1": 0.49165769758547406,
        "y1": 0.8357277508720149
      },
      "text": "ta’ 9 snin, Wagner kien impressjonat ferm mill-Mużika",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.8278755525374826,
        "x1": 0.9078562697439928,
        "y1": 0.8409413924928212
      },
      "text": "(The flying Dutchman). Sakemm dam Pariġi, Wagner lesta",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.8383409152381935,
        "x1": 0.48809141101472786,
        "y1": 0.8514067551935321
      },
      "text": "Gotika ta’ Carl Maria Von Weber. Hawn hu kien kiteb l-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5118920316216764,
        "y0": 0.8435545568589999,
        "x1": 0.6397839875595785,
        "y1": 0.8566203968143384
      },
      "text": "din l-opra u anke",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6418350996205437,
        "y0": 0.8435545568589999,
        "x1": 0.6852049257206426,
        "y1": 0.8566203968143384
      },
      "text": "Rienzi",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.6854451081797299,
        "y0": 0.8435545568589999,
        "x1": 0.9080965034693467,
        "y1": 0.8566203968143384
      },
      "text": ". Wara l-għajnuna ta’ Giacomo",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.8540199195597109,
        "x1": 0.4292177687308466,
        "y1": 0.8670857595150494
      },
      "text": "ewwel biċċa xogħol tiegħu, it-traġedja li semma",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.43041886045821603,
        "y0": 0.8540199195597109,
        "x1": 0.48432159736552355,
        "y1": 0.8670857595150494
      },
      "text": "Leubald",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.48432159736552355,
        "y0": 0.8540199195597109,
        "x1": 0.49160227875126417,
        "y1": 0.8670857595150494
      },
      "text": ".",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119104874776574,
        "y0": 0.8592335611805172,
        "x1": 0.9082628112382429,
        "y1": 0.8722994011358558
      },
      "text": "Meyerbeer, kompożitur ieħor famuż li xi darba jsib ix-xorti",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.8696989238812282,
        "x1": 0.4914174638601202,
        "y1": 0.8827647638365668
      },
      "text": "Wara li beda l-iskola fl-1826, hu kien ferm influwenzat minn",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119104874776574,
        "y0": 0.8749125655020344,
        "x1": 0.7675650032965277,
        "y1": 0.887978405457373
      },
      "text": "f ’din ir-rokna, Wagner esebixxa l-opra",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7666965014738174,
        "y0": 0.8749125655020344,
        "x1": 0.8122467844255491,
        "y1": 0.887978405457373
      },
      "text": "Rienzi",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.8113413196246101,
        "y0": 0.8749125655020344,
        "x1": 0.9082442528497287,
        "y1": 0.887978405457373
      },
      "text": "b’suċċess kbir.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.8853779282027454,
        "x1": 0.48809125721592805,
        "y1": 0.898443768158084
      },
      "text": "Shakespeare u Goethe. Fl-1827 familtu marret lura Leip-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119104874776574,
        "y0": 0.8905915698235518,
        "x1": 0.908281267094224,
        "y1": 0.9036574097788903
      },
      "text": "Fl-1842, Wagner mar Dresden u hemm ikkompona opra",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.9010569325242628,
        "x1": 0.4916023812837974,
        "y1": 0.9141227724796013
      },
      "text": "zig, u beda jitgħallem l-armonija taħt Christian Gottlieb",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5119104874776574,
        "y0": 0.9062705741450691,
        "x1": 0.9082813696267572,
        "y1": 0.9193364141004077
      },
      "text": "oħra kbira, Tannhauser. F’dan iż-żmien, Wagner kien attiv",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0952499549906787,
        "y0": 0.9167359413768913,
        "x1": 0.49156526450676874,
        "y1": 0.9298017813322299
      },
      "text": "Muller. Sena wara, sema’ għall-ewwel darba lil Beethoven",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09524993576582871,
        "y0": 0.9536023698809549,
        "x1": 0.10532929391230196,
        "y1": 0.9678560134685971
      },
      "text": "8",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.2162022271152242,
        "y0": 0.9536023698809549,
        "x1": 0.38249148888925316,
        "y1": 0.9678560134685971
      },
      "text": "MEJJU - ĠUNJU",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.3825116365320325,
        "y0": 0.9536023698809549,
        "x1": 0.5017907827793588,
        "y1": 0.9678560134685971
      },
      "text": "Ħarġa Nru. 87",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
