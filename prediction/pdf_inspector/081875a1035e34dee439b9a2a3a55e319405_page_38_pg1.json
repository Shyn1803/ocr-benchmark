      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.500123017753651,
        "y0": 0.8093434343434344,
        "x1": 0.8997280145782272,
        "y1": 0.8232323232323232
      },
      "text": "ations with experiments on beryllium crystals of dif-",
