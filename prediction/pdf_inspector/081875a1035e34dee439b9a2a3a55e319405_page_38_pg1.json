        "x1": 0.4840606552323485,
        "y1": 0.5934343434343434
      },
      "text": "tions of compression. Again, the values we predicted",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.49985145120059743,
