      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.07837271222881242,
        "y0": 0.8977272727272727,
        "x1": 0.47047464831981783,
        "y1": 0.9116161616161617
      },
      "text": "inferred parameters in a plasticity model that repre-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.49974364237068525,
        "y0": 0.8977272727272727,
        "x1": 0.8996979956533394,
        "y1": 0.9116161616161617
      },
      "text": "microstructure to loading and heating. Because it is",
      "html": null,
      "level": null,
      "section_hierarchy": []
