        "x1": 0.44385498645258886,
        "y1": 0.8585858585858586
      },
      "text": "similar to the 150-μm thickness of the ignition",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
