        "y0": 0.5578754779064294,
        "x1": 0.7803909202027165,
        "y1": 0.5704545685739228
      },
      "text": "In [6] it was in fact shown that the dimension of the weight",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
