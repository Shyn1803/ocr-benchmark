        "y0": 0.7089359868656505,
        "x1": 0.7801954979990043,
        "y1": 0.7215150775331439
      },
      "text": "While we restrict",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.21862683265037786,
        "y0": 0.7239361086277046,
        "x1": 0.7803917180478962,
        "y1": 0.7365151992951982
      },
      "text": "to reference flows of the differential equations of the form (3), an extension to gen-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
