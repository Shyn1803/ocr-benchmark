        "x1": 0.779410343544156,
        "y1": 0.6610603717842487
      },
      "text": "ing quantitative rates are either established to approximate homoemorphism in the L₂",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
