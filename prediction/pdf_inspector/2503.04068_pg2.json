        "y0": 0.663632834800566,
        "x1": 0.780390621010774,
        "y1": 0.6762119254680595
      },
      "text": "norm [9] or for the purposes of generative modeling [9, 2]. In contrast, we are inter-",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
