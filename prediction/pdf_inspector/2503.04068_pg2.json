        "x1": 0.3666168911005157,
        "y1": 0.5704545685739228
      },
      "text": "using narrow NODEs.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
