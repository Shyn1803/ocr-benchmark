        "y0": 0.7390876237792199,
        "x1": 0.7803915185866013,
        "y1": 0.7516667144467133
      },
      "text": "eral flows is straightforward since shallow but wide neural networks are known to be",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
