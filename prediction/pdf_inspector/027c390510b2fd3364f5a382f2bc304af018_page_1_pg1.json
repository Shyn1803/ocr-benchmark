        "x1": 0.911066520113905,
        "y1": 0.557925535900758
      },
      "text": "The prevalence of type 2 diabetes and hypertension is increasing at an alarming rate. This study",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
