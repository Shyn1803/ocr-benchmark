        "y0": 0.6505129432460737,
        "x1": 0.35496876860212784,
        "y1": 0.6647660789359254
      },
      "text": "conformément à l'article II.26.3.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
