        "x1": 0.9105041335765323,
        "y1": 0.6483749873916353
      },
      "text": "conclusions ne lient pas les parties, qui se réservent le droit de porter le litige devant les tribunaux,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
