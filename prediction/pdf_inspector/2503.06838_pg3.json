      "box": {
        "page": 0,
        "x0": 0.206980512033101,
        "y0": 0.8257982285335811,
        "x1": 0.5590901094324449,
        "y1": 0.8383772686274364
      },
      "text": "a problem similar to that of the ICP algorithm.",
      "html": null,
