        "y0": 0.7495721927934254,
        "x1": 0.9098974806017863,
        "y1": 0.763825328483277
      },
      "text": "la nature de la violation de données à caractère personnel y compris, si possible, les catégories",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
