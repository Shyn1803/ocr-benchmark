        "x1": 0.7205383996925694,
        "y1": 0.8490590643221233
      },
      "text": "mesures destinées à en atténuer les éventuelles conséquences négatives.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
