        "y0": 0.8560430975478668,
        "x1": 0.9115079554115852,
        "y1": 0.8702962332377185
      },
      "text": "Le contractant informe immédiatement le responsable du traitement des données si, selon lui, une",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
