        "y0": 0.7147945431600908,
        "x1": 0.9161442364046332,
        "y1": 0.7290476788499427
      },
      "text": "personnel. Dans ce cas, le contractant communique au moins les informations suivantes au",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
