        "y0": 0.7639678540405598,
        "x1": 0.9131206601391569,
        "y1": 0.7782209897304115
      },
      "text": "et le nombre approximatif de personnes concernées par la violation et les catégories et le",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
