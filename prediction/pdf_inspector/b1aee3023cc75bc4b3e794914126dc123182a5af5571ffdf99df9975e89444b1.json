      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08822645165189212,
        "y0": 0.6757708369864526,
        "x1": 0.11219856614983621,
        "y1": 0.687648887418279
      },
      "text": "4.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
