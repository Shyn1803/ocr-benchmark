      "box": {
        "page": 0,
        "x0": 0.12182436217274842,
        "y0": 0.8608783343172318,
        "x1": 0.5188677813694301,
        "y1": 0.8727563847490584
      },
      "text": "Kostenkalkulation und Preisbildung durchführen und",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08822645165189212,
