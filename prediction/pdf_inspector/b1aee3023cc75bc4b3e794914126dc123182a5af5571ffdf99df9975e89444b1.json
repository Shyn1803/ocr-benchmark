      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.12182436217274842,
        "y0": 0.6757708369864526,
        "x1": 0.3061425364967216,
        "y1": 0.687648887418279
      },
      "text": "Ausbildung abschließen.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
