        "y1": 0.6068424755315873
      },
      "text": "Handlungsfelder geprüft werden:",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08822645165189212,
        "y0": 0.6151571108338658,
        "x1": 0.11219856614983621,
        "y1": 0.6270351612656924
      },
      "text": "1.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.12182436217274842,
        "y0": 0.6151571108338658,
        "x1": 0.5812591633478881,
        "y1": 0.6270351612656924
      },
      "text": "Ausbildungsvoraussetzungen prüfen und Ausbildung planen,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08822645165189212,
        "y0": 0.6353616862180614,
        "x1": 0.11219856614983621,
        "y1": 0.6472397366498879
      },
      "text": "2.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.12182436217274842,
        "y0": 0.6353616862180614,
        "x1": 0.7202704421095424,
        "y1": 0.6472397366498879
      },
      "text": "Ausbildung vorbereiten und bei der Einstellung von Auszubildenden mitwirken,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.08822645165189212,
        "y0": 0.655566261602257,
        "x1": 0.11219856614983621,
        "y1": 0.6674443120340835
      },
      "text": "3.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.12182436217274842,
        "y0": 0.655566261602257,
        "x1": 0.33700224062670614,
        "y1": 0.6674443120340835
      },
      "text": "Ausbildung durchführen und",
