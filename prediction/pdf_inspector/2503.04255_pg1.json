    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.34124471199612655,
        "y0": 0.890566654839595,
        "x1": 0.9293446003889837,
        "y1": 0.902398768626596
      },
      "text": "MRA also provides a theoretical framework for constructing multivariate scalar",
