        "x1": 0.5674890756302521,
        "y1": 0.513458432304038
      },
      "text": "1 − λr λr−1",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.23415126050420168,
        "y0": 0.49390498812351546,
        "x1": 0.7653915966386555,
        "y1": 0.5570356294536818
      },
      "text": "a(x,λ∇w1) · ∇w1 ⇐⇒ 1 − λr λr−1Φ(x,|∇w1|)|∇w1| = 1 − λr Ψ(x,λ|∇w1|)λ∇w1 · ∇w1 ⇐⇒ 1 − λr λr−1Φ(x,|∇w1|)|∇w1| = 1 − λr Φ(x,λ|∇w1|)|∇w1|",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "picture",
      "box": {
        "page": 0,
        "x0": 0.5227361344537815,
