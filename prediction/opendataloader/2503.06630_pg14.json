        "y1": 0.5141377672209027
      },
      "text": "λr−1 − λw1 ⇐⇒ 1 − λr a(x,∇w1) · ∇w1 =",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "picture",
      "box": {
        "page": 0,
        "x0": 0.6441478991596639,
        "y0": 0.47044180522565326,
        "x1": 0.6786352941176471,
        "y1": 0.47101187648456055
      },
      "text": null,
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
