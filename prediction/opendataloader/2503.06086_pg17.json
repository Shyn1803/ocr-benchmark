        "y0": 0.7454962121212121,
        "x1": 0.8288202614379085,
        "y1": 0.7611439393939394
      },
      "text": "x is part of a 4-cycle vvi",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
