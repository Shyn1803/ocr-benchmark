        "x1": 0.9449154929577465,
        "y1": 0.7368241379310345
      },
      "text": "is trodden with holes by heavy cattle. Var.diat.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5182028169014085,
        "y0": 0.7363913793103448,
        "x1": 0.8270957746478874,
        "y1": 0.7506241379310344
      },
      "text": "POACHING. Swampy. Devon.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
