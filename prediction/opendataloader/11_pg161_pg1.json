        "x1": 0.9497690140845071,
        "y1": 0.7912758620689655
      },
      "text": "POARE-BLIND. Dim-sighted. The word",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5182028169014085,
        "y0": 0.7933206896551724,
        "x1": 0.9052338028169015,
        "y1": 0.8177275862068966
      },
      "text": "occurs in Hollyband's Dictionarie, 1593. POAT. To kick. Devon.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.0696338028169014,
        "y0": 0.8127,
        "x1": 0.4542366197183098,
        "y1": 0.8272724137931035
      },
