      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5182028169014085,
        "y0": 0.8185051724137931,
        "x1": 0.774461971830986,
        "y1": 0.8313155172413793
      },
      "text": "POBS. Porridge. Craven.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.07003943661971831,
        "y0": 0.8261172413793103,
        "x1": 0.49998309859154927,
        "y1": 0.8406413793103449
      },
      "text": "PLUME. To pick or pluck the feathers off a",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.5186056338028169,
        "y0": 0.8300241379310345,
        "x1": 0.797143661971831,
        "y1": 0.8452741379310345
      },
      "text": "POCHE. A pocket. {A.-N.)",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.09109014084507043,
        "y0": 0.8409396551724138,
        "x1": 0.2667971830985915,
        "y1": 0.8535741379310344
      },
      "text": "hawk or other bird.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
