          0,
          255
        ],
        "name": "/OHUOWI+CMR10",
        "size": 9.962639808654785
      }
    },
    {
      "bbox": [
        512.0517735294118,
        404.28693972684084,
        410.19681722689086,
        12.127929038004709
      ],
      "text": "quite similar, with FeAs layers playing a similar role of",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/OHUOWI+CMR10",
        "size": 9.962639808654785
      }
    },
    {
      "bbox": [
        512.0517735294118,
        419.4794726840855,
        410.0628781512605,
        12.127916864608096
      ],
      "text": "CuO planes, and the observation that in both cases su-",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/OHUOWI+CMR10",
        "size": 9.962639808654785
      }
    },
    {
      "bbox": [
        512.0517735294118,
        434.6719934679335,
        410.35769915966387,
        12.127929038004822
      ],
      "text": "perconductivity appears doping a magnetically ordered",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/OHUOWI+CMR10",
        "size": 9.962639808654785
      }
    },
    {
      "bbox": [
        512.0517735294118,
        449.7185552256533,
        410.03574579831945,
        12.127916864607982
      ],
      "text": "parent compound, and follows a dome behavior as a",
      "font": {
        "color": [
          0,
          0,
          0,
