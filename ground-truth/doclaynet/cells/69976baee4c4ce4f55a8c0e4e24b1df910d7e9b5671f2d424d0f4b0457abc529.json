{
  "metadata": {
    "page_hash": "69976baee4c4ce4f55a8c0e4e24b1df910d7e9b5671f2d424d0f4b0457abc529",
    "original_filename": "Presidential Decree No. 1067, s. 1976 | Official Gazette of the Republic of the Philippines.pdf",
    "page_no": 10,
