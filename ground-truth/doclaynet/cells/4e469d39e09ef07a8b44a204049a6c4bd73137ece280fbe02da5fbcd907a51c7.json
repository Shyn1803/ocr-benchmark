        373.8304678030304,
        48.7307777777778,
        12.874698863636354
      ],
      "text": "Notes:",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Bold",
        "size": 1
      }
    },
    {
      "bbox": [
        290.7834056372549,
        393.30392771464653,
        13.937420751634022,
        11.944977272727215
      ],
      "text": "1.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
      "bbox": [
        317.25444934640524,
        393.11023895202027,
        583.240508986928,
        13.09421969696973
      ],
      "text": "You cannot directly change the overlay object. You need to change the source",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        317.24775,
        408.60638825757576,
        338.7007655228758,
        13.094245580808206
      ],
      "text": "overlay and create the overlay object from it.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.7850637254902,
        428.1702474747475,
        13.937420751633965,
        11.944977272727328
      ],
      "text": "2.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
      "bbox": [
        317.2561074346405,
        427.9765716540404,
        580.5999281045752,
        13.09420675505055
      ],
      "text": "You can work with the overlay object using the resource management utility.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        317.2494080882353,
        447.34675505050507,
        525.1679448529412,
        13.094245580808092
      ],
      "text": "See \u201cChapter 19. Work with Overlays Function\u201d on page 341 for more",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        317.2494080882353,
        462.8428914141415,
        92.33114583333332,
        13.094206755050436
      ],
      "text": "information.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        120.32194129901961,
        497.7439343434344,
        262.59437651143793,
        16.722667929292925
      ],
      "text": "Print Form and Overlay",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica-Bold",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        526.117655618687,
        622.7883084150326,
        13.094245580808092
      ],
      "text": "You can merge the overlay object with various spooled files as your final printout.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        541.6137919823232,
        611.9875216503269,
        13.09420675505055
      ],
      "text": "You can use overlays at any time you want on various types of forms. Thus, you",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        557.1099283459596,
        365.97223039215686,
        13.094258522727273
      ],
      "text": "can eliminate the use of preprinted paper forms.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        588.1022010732324,
        624.3039685457516,
        13.094258522727273
      ],
      "text": "The overlay can be composed of text, images, graphics, lines, boxes, and bar codes",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        603.5983503787879,
        43.71732189542479,
        13.09420675505055
      ],
      "text": "called",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        340.0573496732026,
        603.6887496843435,
        68.68436233660128,
        12.874698863636354
      ],
      "text": "elements",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Bold",
        "size": 1
      }
    },
    {
      "bbox": [
        408.7383623366013,
        603.5983503787879,
        499.76306862745093,
        13.09420675505055
      ],
      "text": ". All of the environmental data (such as font references) is defined",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        619.0944867424244,
        570.8771666666667,
        13.094258522727216
      ],
      "text": "as a part of the overlay definition. The fonts defined for the overlay are not",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        634.5906231060605,
        526.5098909313726,
        13.09421969696973
      ],
      "text": "influenced by the fonts used for the variable data on the logical page.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        665.5829087752526,
        560.1852610294118,
        13.094206755050493
      ],
      "text": "The basic function of the overlay is to provide a template-like pattern that",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        681.0790451388889,
        459.97290359477125,
        13.094232638888911
      ],
      "text": "establishes fixed data for merging with various spooled files.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        712.0713178661616,
        595.0271548202616,
        13.094232638888911
      ],
      "text": "For each element, you must specify its position and the horizontal and vertical",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        727.5674671717172,
        606.2656433823529,
        13.094232638888911
      ],
      "text": "distances from the overlay origin. You can also specify the offset, and horizontal",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        743.0636035353535,
        619.4909738562092,
        13.094232638888911
      ],
      "text": "and vertical distances of the overlay origin from the origin of the page. The initial",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        758.5597398989898,
        626.5817295751633,
        13.094232638888911
      ],
      "text": "values are set to zero offset in both directions, which means the overlay origin will",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.77843137254905,
        774.0558762626263,
        627.8000392156864,
        13.094232638888911
      ],
      "text": "coincide with the page origin. This eliminates the need for preprinted paper forms.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        904.0885379901961,
        968.5220133838384,
        18.38302328431371,
        14.162431470959596
      ],
      "text": "23",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Palatino-Bold",
        "size": 1
      }
    }
  ]
