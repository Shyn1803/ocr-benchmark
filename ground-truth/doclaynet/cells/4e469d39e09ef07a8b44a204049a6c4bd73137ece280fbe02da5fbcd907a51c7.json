        ],
        "name": "/Palatino-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        290.7834056372549,
        350.4958251262626,
        555.6464370915033,
        13.094297348484929
      ],
      "text": "You can change the design of the overlay by changing the source overlay.",
