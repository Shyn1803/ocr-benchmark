        540.4704076797385,
        291.3950886994951,
        71.36011478758178,
        14.629558396464518
      ],
      "text": "An Act ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        426.6813558006536,
        315.9174242424243,
        296.0441176470589,
        9.753043244949367
      ],
      "text": "To provide a lactation room in public buildings. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.99183006535947,
        337.30523989898995,
        508.31290849673206,
        12.191274936868695
      ],
      "text": "Be it enacted by the Senate and House of Representatives of ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Italic",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4950980392157,
        350.2471590909091,
        408.1576964869281,
        12.191274936868695
      ],
      "text": "the United States of America in Congress assembled, ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Italic",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4950980392157,
        370.79116161616173,
        194.95096364379089,
        9.753043244949367
      ],
      "text": "SECTION 1. SHORT TITLE. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Bold",
        "size": 1
      }
    },
    {
      "bbox": [
        339.99183006535947,
        387.0022095959596,
        510.02122508169936,
        12.191261994949514
      ],
      "text": "This Act may be cited as the \u2018\u2018Fairness For Breastfeeding ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4950980392157,
        399.94412878787875,
        171.58702655228763,
        12.191261994949514
      ],
      "text": "Mothers Act of 2019\u2019\u2019. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4950980392157,
        420.35873800505055,
        369.30816993464055,
        9.753043244949481
      ],
      "text": "SEC. 2. LACTATION ROOM IN PUBLIC BUILDINGS. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Bold",
        "size": 1
      }
    },
    {
      "bbox": [
        339.99183006535947,
        436.5697859848485,
        20.03297181372551,
        12.191261994949514
      ],
      "text": "(a)",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        364.582199754902,
        436.5697859848485,
        485.16829125817,
        12.191261994949514
      ],
      "text": "LACTATION ROOM IN PUBLIC BUILDINGS.\u2014Chapter 33 of ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.49543300653596,
        449.5117051767677,
        542.3623366013071,
        12.191261994949514
      ],
      "text": "title 40, United States Code, is amended by adding at the end ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.49543300653596,
        462.45362436868686,
        204.14583333333331,
        12.191261994949514
      ],
      "text": "the following new section: ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.49543300653596,
        483.5489267676768,
        373.77323406862746,
        12.191274936868695
      ],
      "text": "\u2018\u2018\u00a7 3318. Lactation room in public buildings ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Bold",
        "size": 1
      }
    },
    {
      "bbox": [
        339.99216503267974,
        501.6676136363636,
        270.14879901960796,
        12.191274936868695
      ],
      "text": "\u2018\u2018(a) DEFINITIONS.\u2014In this section: ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.488227124183,
        514.6094163510102,
        146.82924019607844,
        12.191274936868695
      ],
      "text": "\u2018\u2018(1) APPROPRIATE",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        537.434297385621,
        516.8833374368687,
        318.6517320261438,
        9.28502462121213
      ],
      "text": "AUTHORITY.\u2014The term \u2018appropriate ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.9918635620915,
        527.5514520202021,
        507.1740028594772,
        12.191274936868695
      ],
      "text": "authority\u2019 means the head of a Federal agency, the Architect ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.9918635620915,
        540.4933712121212,
        508.3296401143792,
        12.191274936868638
      ],
      "text": "of the Capitol, or other official authority responsible for the ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.9918635620915,
        553.4352904040404,
        235.73321813725494,
        12.191274936868695
      ],
      "text": "operation of a public building. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.48859558823534,
        566.3772095959596,
        472.7090477941177,
        12.191274936868638
      ],
      "text": "\u2018\u2018(2) COVERED PUBLIC BUILDING.\u2014The term \u2018covered public ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.9916793300654,
        579.3191287878788,
        506.5710616830065,
        12.191274936868638
      ],
      "text": "building\u2019 means a public building (as defined in section 3301) ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.9916793300654,
        592.2610479797979,
        509.61928104575156,
        12.191274936868695
      ],
      "text": "that is open to the public and contains a public restroom, ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.9916793300654,
        605.2029671717172,
        420.01552287581694,
        12.191274936868638
      ],
      "text": "and includes a building listed in section 6301 or 5101. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.48841135620916,
        618.1448863636364,
        475.0415759803922,
        12.191274936868695
      ],
      "text": "\u2018\u2018(3) LACTATION ROOM.\u2014The term \u2018lactation room\u2019 means ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.99265073529415,
        631.0868055555557,
        370.47387295751633,
        12.191274936868638
      ],
      "text": "a hygienic place, other than a bathroom, that\u2014 ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        406.98611478758176,
        644.0287247474748,
        207.17730433006523,
        12.191274936868638
      ],
      "text": "\u2018\u2018(A) is shielded from view; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        406.98611478758176,
        656.970643939394,
        241.82967361111105,
        12.191274936868695
      ],
      "text": "\u2018\u2018(B) is free from intrusion; and ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        406.98611478758176,
        669.9125631313132,
        440.8002450980392,
        12.191274936868638
      ],
      "text": "\u2018\u2018(C) contains a chair, a working surface, and, if the ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.4893827614379,
        682.8544823232323,
        474.56490073529415,
        12.191287878787875
      ],
      "text": "public building is otherwise supplied with electricity, an ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.4893827614379,
        695.7964015151515,
        129.83331658496735,
        12.191287878787932
      ],
      "text": "electrical outlet. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.99265073529415,
        708.7383207070707,
        499.0666548202615,
        12.191287878787875
      ],
      "text": "\u2018\u2018(b) LACTATION ROOM REQUIRED.\u2014Except as provided in sub-",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4947630718954,
        721.6802398989898,
        540.7209799836601,
        12.191287878787932
      ],
      "text": "section (c), the appropriate authority of a covered public building ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4947630718954,
        734.6221590909091,
        541.9771074346406,
        12.191287878787875
      ],
      "text": "shall ensure that the building contains a lactation room that is ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4947630718954,
        747.5640782828283,
        539.4314227941177,
        12.191287878787875
      ],
      "text": "made available for use by members of the public to express breast ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.4947630718954,
        760.5059974747475,
        44.68465727124186,
        12.191287878787932
      ],
      "text": "milk. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        339.9914950980392,
        773.4479166666667,
        507.31651470588235,
        12.191287878787875
      ],
      "text": "\u2018\u2018(c) EXCEPTIONS.\u2014A covered public building may be excluded ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.49489705882354,
        786.3898358585859,
        542.6805890522876,
        12.191287878787904
      ],
      "text": "from the requirement in subsection (b) at the discretion of the ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        306.49489705882354,
        799.3317550505051,
        205.13400367647063,
        12.191287878787904
      ],
      "text": "appropriate authority if\u2014 ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.4883611111111,
        812.2736742424242,
        198.88684640522888,
        12.191287878787904
      ],
      "text": "\u2018\u2018(1) the public building\u2014 ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        406.9850931372549,
        825.2155934343434,
        440.41501593137264,
        12.191287878787904
      ],
      "text": "\u2018\u2018(A) does not contain a lactation room for employees ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.4883611111111,
        838.1575126262626,
        236.6042001633988,
        12.191287878787875
      ],
      "text": "who work in the building; and ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        406.9850931372549,
        851.0994318181818,
        440.73323488562096,
        12.191287878787904
      ],
      "text": "\u2018\u2018(B) does not have a room that could be repurposed ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.4883611111111,
        864.041351010101,
        472.2201964869281,
        12.191287878787875
      ],
      "text": "as a lactation room or a space that could be made private ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        373.4883611111111,
        876.9832702020202,
        381.66176470588243,
        12.191287878787875
      ],
      "text": "using portable materials, at a reasonable cost; or ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        485.45656565656566,
        14.069498366013079,
        9.753043244949595
      ],
      "text": "40",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        203.49373570261437,
        485.45656565656566,
        66.10889910130717,
        9.753043244949595
      ],
      "text": "USC 3318. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        352.1547979797981,
        78.10598815359478,
        9.753043244949367
      ],
      "text": "Fairness For ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        362.5083333333333,
        84.43690400326798,
        9.753043244949595
      ],
      "text": "Breastfeeding ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        372.86186868686866,
        75.29227941176472,
        9.753043244949595
      ],
      "text": "Mothers Act ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
