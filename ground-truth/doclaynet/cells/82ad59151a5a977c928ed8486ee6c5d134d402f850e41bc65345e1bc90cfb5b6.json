    {
      "bbox": [
        42.608149201680675,
        99.51751781472683,
        956.044716764706,
        10.613680225653297
      ],
      "text": "In certain transactions, including certain aircraft financing leases and loans, the lessors, lenders and/or other parties have rights to terminate the",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
