        237.01983135391924,
        956.0391524789917,
        10.61369239904991
      ],
      "text": "American is required to make principal and interest payments for certain special facility revenue bonds issued by municipalities primarily to build",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/QFUCAA+DejaVuSans",
        "size": 13
      }
    },
