        24.738352605042017,
        217.37121437054634,
        710.9538642016807,
        10.613680225653184
      ],
      "text": "liability insurance protecting American for some of the obligations it has undertaken under these indemnities.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/QFUCAA+DejaVuSans",
        "size": 13
      }
    },
    {
      "bbox": [
