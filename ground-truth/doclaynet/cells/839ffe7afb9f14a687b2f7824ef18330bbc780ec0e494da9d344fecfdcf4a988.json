      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        375.5660294117647,
        291.65449652777784,
        159.97238643790854,
        14.629558396464518
      ],
      "text": "Joint Resolution ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        316.17628851010113,
        532.6717487745099,
        9.753043244949367
      ],
      "text": "Requesting the Secretary of the Interior to authorize unique and one-time arrange-",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        199.30555555555557,
        327.8240157828284,
        525.3895592320262,
        9.753043244949367
      ],
      "text": "ments for displays on the National Mall and the Washington Monument during ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        199.30555555555557,
        339.47174305555563,
        418.52826797385626,
        9.753043244949367
      ],
      "text": "the period beginning on July 16, 2019 and ending on July 20, 2019. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        361.1183323863637,
        541.4914215686275,
        12.191300820707056
      ],
      "text": "Whereas Congress enacted the Act of August 12, 1946 (60 Stat. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        374.31914172979805,
        521.2091670751634,
        12.191261994949514
      ],
      "text": "997; ch. 955, 1), to establish a National Air Museum, later known ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        387.51991224747485,
        523.453448120915,
        12.19127493686858
      ],
      "text": "as the Smithsonian\u2019s National Air and Space Museum (NASM), ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        400.7206957070707,
        523.1687091503268,
        12.191261994949514
      ],
      "text": "to commemorate and memorialize the American story of human ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        413.9214662247475,
        342.8390690359477,
        12.191261994949514
      ],
      "text": "flight in the atmosphere and in outer space; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        431.00481250000007,
        542.4460784313726,
        12.191261994949514
      ],
      "text": "Whereas Congress enacted the Act of July 29, 1958 (commonly ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        444.2055830176769,
        526.3006368464053,
        12.1912619949494
      ],
      "text": "known as the National Aeronautics and Space Act) (72 Stat. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        457.40635353535356,
        523.1687091503268,
        12.191274936868695
      ],
      "text": "426\u2013438; 42 U.S.C. 2451 et seq.), to declare a policy of peaceful ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        470.60713699494954,
        525.3794934640523,
        12.1912619949494
      ],
      "text": "space activities designed for the benefit of humankind and to ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        483.80790751262623,
        527.0040849673203,
        12.191261994949514
      ],
      "text": "establish the National Aeronautics and Space Administration ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        496.8792458964647,
        68.8525326797386,
        12.191274936868695
      ],
      "text": "(NASA); ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        513.8331729797981,
        542.4795584150328,
        12.191261994949514
      ],
      "text": "Whereas in July of 1960, NASA announced the creation of the ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        526.9045243055556,
        522.1973206699347,
        12.191261994949514
      ],
      "text": "Apollo Program, the Nation\u2019s first orchestrated initiative to ferry ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        539.9758626893939,
        380.623382761438,
        12.191274936868751
      ],
      "text": "humankind out of Earth\u2019s orbit and to the Moon; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        556.9297897727272,
        542.7475490196078,
        12.191261994949514
      ],
      "text": "Whereas on July 20, 1969, the Apollo 11 Mission succeeded in ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        570.0011410984849,
        522.9341985294118,
        12.1912619949494
      ],
      "text": "landing the spacecraft Eagle on the surface of the Moon, piloted ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        583.0724794823233,
        526.4681372549019,
        12.191261994949457
      ],
      "text": "by two American astronauts, the first humans to ever make ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        596.1438308080808,
        266.4497549019608,
        12.191261994949514
      ],
      "text": "landfall on another celestial body; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        613.097744949495,
        539.9170751633987,
        12.191274936868638
      ],
      "text": "Whereas on July 20 and 21, 1969, those brave Americans became ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        626.1690962752525,
        523.0179738562092,
        12.191261994949514
      ],
      "text": "the first humans to set foot on the surface of the Moon, forever ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        639.2404476010101,
        376.7879901960785,
        12.191261994949514
      ],
      "text": "changing Earth\u2019s relationship with the heavens; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        656.1943617424242,
        537.3712900326798,
        12.191261994949514
      ],
      "text": "Whereas this momentous event was watched in wonder by hundreds ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        669.2657130681819,
        524.5588402777778,
        12.191261994949457
      ],
      "text": "of millions of people back on Earth, including the hundreds of ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        682.3370514520202,
        522.7835134803922,
        12.191287878787932
      ],
      "text": "thousands of NASA civilian and military staff and partners who ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        695.4084027777778,
        273.2663398692811,
        12.191287878787875
      ],
      "text": "made the Apollo Program possible; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        712.3623298611111,
        539.6993296568628,
        12.191274936868695
      ],
      "text": "Whereas the Apollo Program continued through December of 1972 ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        725.4336682449496,
        524.9105392156864,
        12.191287878787875
      ],
      "text": "and spurred the greatest development of human scientific and ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        738.5050195707071,
        522.9677287581699,
        12.191287878787875
      ],
      "text": "technological understanding of any decade to that point, leading ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        751.5763579545455,
        520.8072230392156,
        12.191287878787875
      ],
      "text": "to advances in rocketry, spaceflight, avionics, telecommunications, ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        764.647709280303,
        523.6711768790849,
        12.191287878787847
      ],
      "text": "and computers, on which the American public still relies today; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        781.6016363636363,
        532.4975490196078,
        12.191274936868695
      ],
      "text": "Whereas the National Air and Space Museum opened on the Amer-",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        794.6729747474748,
        522.9510138888888,
        12.191287878787904
      ],
      "text": "ican Bicentennial in July 1976 as a birthday gift to the country ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        807.7443260732323,
        524.6425653594772,
        12.191287878787904
      ],
      "text": "in celebration of the Nation\u2019s highest achievements, under the ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        820.8156773989899,
        522.1805555555554,
        12.191274936868695
      ],
      "text": "leadership and vision of Museum Director, NASA astronaut, and ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        833.8870157828283,
        394.1058006535948,
        12.191287878787847
      ],
      "text": "Apollo 11 Command Module Pilot Michael Collins; ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        185.90686274509804,
        850.8409169823233,
        542.1445743464052,
        12.191300820707056
      ],
      "text": "Whereas NASA continues to pursue space exploration on behalf ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        863.9122553661616,
        524.2406213235295,
        12.191300820707085
      ],
      "text": "of the American people to increase humankind\u2019s understanding ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        202.65522875816993,
        876.98359375,
        154.52040808823529,
        12.191287878787875
      ],
      "text": "of the heavens; and ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
    {
      "bbox": [
        750.8627618464053,
        322.6472481060607,
        77.06465849673202,
        9.753043244949367
      ],
      "text": "July 5, 2019 ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/NewCenturySchlbk-Roman",
        "size": 1
      }
    },
