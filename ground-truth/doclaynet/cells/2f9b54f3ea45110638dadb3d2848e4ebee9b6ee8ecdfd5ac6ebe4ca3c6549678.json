    {
      "bbox": [
        90.19320236318407,
        300.2503831417624,
        504.48356339137644,
        12.022425287356441
      ],
      "text": "Other accounts receivable consist primarily of debit card receivables and third-party credit receivables.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ArialNarrow",
        "size": 1
      }
    },
    {
      "bbox": [
        84.14179104477611,
        325.2902167943806,
        845.8884742951907,
        15.028070881225972
      ],
      "text": "Our credit card receivables are restricted under our securitization program. Our Series 2011-1 Class A Notes are secured by 100% of the ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ArialNarrow",
        "size": 1
      }
    },
    {
      "bbox": [
        84.14179104477611,
        340.99902905491706,
        809.4950758706466,
        15.028070881225972
      ],
      "text": "Nordstrom private label credit card receivables and 90% of the Nordstrom Visa credit card receivables. As of January 31, 2015 and ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ArialNarrow",
        "size": 1
      }
    },
    {
      "bbox": [
        84.14179104477611,
        356.7078413154534,
        853.0278117744609,
        15.028070881226085
      ],
      "text": "February 1, 2014, our restricted credit card receivables included more receivables than necessary to collateralize our outstanding secured ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ArialNarrow",
        "size": 1
      }
    },
    {
      "bbox": [
        84.14179104477611,
        372.4166535759897,
        862.4108283582088,
        15.028070881226085
      ],
      "text": "debt and variable funding facilities. As such, they can be utilized to increase the current usage of our securitization program. Our credit card ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ArialNarrow",
        "size": 1
      }
    },
    {
      "bbox": [
        84.14179104477611,
        388.12546583652613,
        836.7433665008291,
        15.028070881226085
      ],
      "text": "securitization agreements set a maximum percentage of receivables that can be associated with various receivable categories, such as ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ArialNarrow",
        "size": 1
      }
    },
    {
      "bbox": [
        84.14179104477611,
        403.83427809706257,
        750.1028702321724,
        15.028070881226085
      ],
      "text": "employee or foreign receivables, and as of January 31, 2015 and February 1, 2014, these maximums were not exceeded.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ArialNarrow",
        "size": 1
      }
    },
