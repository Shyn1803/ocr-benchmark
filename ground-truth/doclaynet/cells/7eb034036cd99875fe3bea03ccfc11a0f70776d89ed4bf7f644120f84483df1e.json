        229.11764705882356,
        410.91423011363645,
        126.60493504901959,
        11.923364267676675
      ],
      "text": "shortwave SFPs.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
