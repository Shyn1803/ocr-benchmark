        746.6426136363636,
        190.73047589869282,
        10.774160669191929
      ],
      "text": "Example of host connectivity",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica-Oblique",
        "size": 1
      }
    },
    {
      "bbox": [
        229.11764705882356,
        780.3054902146465,
        687.5078300653594,
        11.923377209595941
      ],
      "text": "In Figure 3-9, the optical distance between Storwize V7000 Node 1 and Host 2 is slightly over ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
      "bbox": [
        229.11764705882356,
        795.8355344065657,
        18.602326388888855,
        11.923390151515122
      ],
      "text": "40",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
      "bbox": [
        252.37055923202618,
        795.8355344065657,
        128.27566830065356,
        11.923390151515122
      ],
      "text": "km (24.85 miles).",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
      "bbox": [
        229.11764705882356,
        824.2557430555555,
        687.5043631535947,
        11.923377209595941
      ],
      "text": "To avoid latencies that lead to degraded performance, avoid ISL hops whenever possible. In ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
