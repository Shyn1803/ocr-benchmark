        229.11768055555555,
        839.7857872474748,
        687.5511413398692,
        11.923390151515122
      ],
      "text": "an optimal setup, the servers connect to the same SAN switch as the Storwize V7000 nodes.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
      "bbox": [
        239.16666666666669,
        876.0497825126263,
        42.76269852941175,
        11.923403093434331
