        642.2827532679739,
        11.923416035353512
      ],
      "text": "reclaim unused allocated disk space (zeros) when they are converting a fully allocated ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/Helvetica",
        "size": 1
      }
    },
    {
