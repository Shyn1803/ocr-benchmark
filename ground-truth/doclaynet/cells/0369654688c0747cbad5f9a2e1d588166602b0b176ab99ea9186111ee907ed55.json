        41.789100939542486,
        573.6156897095959,
        924.2268888480394,
        17.43490056818183
      ],
      "text": "declared unconstitutional or invalid for any reason, the other provisions or parts therein shall not be affected.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/PVVILW+Roboto-Regular",
        "size": 1
      }
