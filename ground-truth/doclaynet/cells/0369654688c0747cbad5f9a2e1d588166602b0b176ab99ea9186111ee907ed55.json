        41.789100939542486,
        204.68667613636376,
        941.4207446486929,
        17.43486174242412
      ],
      "text": "Any claim not registered within said period shall be considered waived and the use of the water deemed",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/PVVILW+Roboto-Regular",
        "size": 1
      }
