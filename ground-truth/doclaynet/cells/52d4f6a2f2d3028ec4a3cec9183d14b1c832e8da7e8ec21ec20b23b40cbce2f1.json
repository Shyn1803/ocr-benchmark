        357.992960807601,
        585.1773700420168,
        13.280104513064202
      ],
      "text": "ship is associated with improved environmental performance in terms of",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/SHFDQT+CMR10",
        "size": 10.90909957885742
      }
    },
    {
      "bbox": [
        714.6426962184875,
