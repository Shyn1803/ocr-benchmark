        97.52065779714006,
        167.7409642303536,
        846.7423773056108,
        14.60946442914917
      ],
      "text": "provided by e-Submission with the official date and time of receipt of the submission (timestamp) ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ABCDEE+Calibri",
        "size": 12
      }
    },
