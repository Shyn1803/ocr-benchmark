        97.52065779714006,
        238.74296135601855,
        845.8057209852562,
        14.609464429149284
      ],
      "text": "required by the contracting authority at the time of submission as set out in the procurement ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ABCDEE+Calibri",
        "size": 12
      }
    },
    {
      "bbox": [
        97.52065779714006,
        256.566532308688,
        103.87741044518224,
        14.609464429149284
      ],
