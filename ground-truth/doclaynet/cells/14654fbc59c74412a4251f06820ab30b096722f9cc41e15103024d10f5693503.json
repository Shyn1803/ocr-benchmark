        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ABCDEE+Calibri",
        "size": 12
      }
    },
    {
      "bbox": [
        97.52065779714006,
        220.91940257790293,
        845.7229213998702,
        14.60946442914917
      ],
      "text": "Tenderers must ensure that their submitted tenders contain all the information and documents ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ABCDEE+Calibri",
        "size": 12
      }
    },
