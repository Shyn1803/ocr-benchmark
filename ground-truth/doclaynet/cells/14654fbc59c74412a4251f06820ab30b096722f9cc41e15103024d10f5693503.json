        97.52065779714006,
        149.7713108079463,
        846.7836824013356,
        14.60946442914917
      ],
      "text": "A tender received after the time-limit for receipt of tenders will be rejected. The submission receipt ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/ABCDEE+Calibri",
        "size": 12
      }
