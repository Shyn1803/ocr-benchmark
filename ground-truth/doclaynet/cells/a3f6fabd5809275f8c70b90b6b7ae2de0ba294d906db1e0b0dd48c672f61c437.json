    {
      "bbox": [
        90.43210989266777,
        633.9443055187633,
        625.8048745687329,
        0.19249895633504366
      ],
      "text": " *) Berechnung der theoretischen Versorgungsfl\u00e4che f\u00fcr das Beitragsjahr 2014:",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 0.1000000014901161
      }
    },
    {
      "bbox": [
        123.14807351566675,
        634.5002282842567,
        799.2512163957426,
        19.248665958307242
      ],
      "text": "Die theoretische Versorgungsfl\u00e4che ist eine Berechnungsgr\u00f6\u00dfe zur Ermittlung des Beitrags. Sie basiert",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        649.1102306624799,
        825.6994612758989,
        19.2486659583073
      ],
      "text": "f\u00fcr alle Rundfunkdienste auf den internationalen Ausbreitungskurven der ITU\u2011R P.370, den internationalen",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        663.7202330407033,
        836.7023931644234,
        19.2486659583073
      ],
      "text": "Abkommen f\u00fcr T\u2011DAB Wiesbaden 1995 und Maastricht 2002 und f\u00fcr DVB\u2011T Chester 1997, sowie den jeweils",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        678.3302354189266,
        615.9212317946754,
        19.248665958307242
      ],
      "text": "g\u00fcltigen nationalen Richtlinien (zurzeit 176 TR 22 bzw. 5 R 22 vom M\u00e4rz 1992).",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        692.9402377971498,
        797.0471414624453,
        19.248702483313195
      ],
      "text": "Angaben f\u00fcr die jeweils frequenzabh\u00e4ngige Mindestnutzfeldst\u00e4rke sind f\u00fcr TV-analog der ITU\u2011R BT.417",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        707.5502767003792,
        811.269996387552,
        19.248665958307242
      ],
      "text": "zu entnehmen, Angaben f\u00fcr den Betrieb eines Kanals im Band II in analoger \u00dcbertragungstechnik (UKW-",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        722.1602790786026,
        833.3617998534527,
        19.248665958307242
      ],
      "text": "Tonrundfunk) sind dem Abkommen Genf 1984 zu entnehmen, Angaben f\u00fcr den Betrieb eines T\u2011DAB-Kanals",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        736.7702814568258,
        790.5900420195694,
        19.248665958307186
      ],
      "text": "dem Abkommen Wiesbaden 1995 (Pkt. 2.2.3, Tabelle 1, Position \u201eMedianwert der Mindestfeldst\u00e4rke\u201c)",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        751.3802838350491,
        815.8846529037958,
        19.248665958307242
      ],
      "text": "und Angaben f\u00fcr den Betrieb eines DVB\u2011T-Kanals dem Abkommen Chester 1997 (Tabelle A.1.50, Position",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        765.9902862132724,
        772.0624541325453,
        19.248665958307242
      ],
      "text": "\u201eMedianwert f\u00fcr die minimale \u00e4quivalente Feldst\u00e4rke\u201c). In Gleichwellennetzen werden theoretische",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        780.6002885914958,
        562.1292542646927,
        19.248665958307214
      ],
      "text": "Versorgungsfl\u00e4chen verschiedener Sender nicht mehrfach veranschlagt.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        795.210290969719,
        705.8556956161204,
        19.248665958307242
      ],
      "text": "Auf der Basis der oben genannten Ausbreitungskurven wird f\u00fcr eine Sendefunkanlage eine",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        809.8202933479424,
        807.0857959485685,
        19.248665958307214
      ],
      "text": "Mindestnutzfeldst\u00e4rkekontur gem\u00e4\u00df den jeweils g\u00fcltigen internationalen Abkommen errechnet. Hieraus",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        824.4302957261657,
        784.0123928348278,
        19.248665958307242
      ],
      "text": "ergibt sich f\u00fcr jeden 10\u00b0-Schritt eine Entfernung r vom Senderstandort bis zu dem Punkt, an dem die",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        839.040298104389,
        770.0478563252999,
        19.248665958307242
      ],
      "text": "Mindestnutzfeldst\u00e4rke erreicht ist. Daraus kann f\u00fcr jeden der 36 10\u00b0-Schritte ein Fl\u00e4chenelement A",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        853.6503004826124,
        146.77418023521295,
        19.248665958307214
      ],
      "text": "berechnet werden:",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        920.707776398261,
        845.2601506359196,
        19.248675698308816
      ],
      "text": "Durch Addition der 36 Fl\u00e4chenelemente ergibt sich die theoretische Versorgungsfl\u00e4che einer Sendeanlage in",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    },
    {
      "bbox": [
        123.14807351566675,
        935.3177787764843,
        151.52660542516975,
        19.24867569830883
      ],
      "text": "Quadratkilometern.",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/EAAAAB+DejaVuSansCondensed",
        "size": 10
      }
    }
  ]
