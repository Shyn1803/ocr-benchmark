    {
      "bbox": [
        121.3525637254902,
        454.13323863636367,
        829.4175392156862,
        10.794854797979838
      ],
      "text": "f i g u re has increased due to the increase in revenues for the Polish operations. In Hungary the majority of revenues received are denominated in",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/BKGONC+BauerBodoni-Roman",
        "size": 8.25
