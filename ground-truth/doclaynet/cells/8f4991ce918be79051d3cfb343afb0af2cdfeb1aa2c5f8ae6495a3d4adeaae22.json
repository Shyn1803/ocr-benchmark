    {
      "bbox": [
        121.24241642156862,
        526.9412534722222,
        829.3757788398693,
        10.79485479797978
      ],
      "text": "The Company estimates that a further 10% depreciation in foreign exchange rates of the Deutsche Mark, Hungarian Forint, Polish Zloty and the",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/BKGONC+BauerBodoni-Roman",
        "size": 8.25
      }
    },
    {
      "bbox": [
        121.3108050245098,
        540.5324040404041,
        828.8605773284313,
        10.79485479797978
      ],
      "text": "British Pound Sterling against the U.S. dollar, would have the combined effect of a $7.1 million decrease in the re p o rted net loss. This was",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/BKGONC+BauerBodoni-Roman",
        "size": 8.25
      }
