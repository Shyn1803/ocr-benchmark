    {
      "bbox": [
        121.30412242647058,
        614.9601647727272,
        829.4862292892158,
        10.79485479797978
      ],
      "text": "on the Central European currencies, the Company expects that the currencies of the markets where it invests will fluctuate less against the",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/BKGONC+BauerBodoni-Roman",
        "size": 8.25
