    {
      "bbox": [
        121.3975414624183,
        554.1235416666667,
        828.8119601715687,
        10.794867739898962
      ],
      "text": "estimated using 10% of the Company\u2019s net losses after adjusting for unusual impairment and other items including U.S. dollar denominated or",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/BKGONC+BauerBodoni-Roman",
        "size": 8.25
      }
    },
    {
      "bbox": [
        121.36585187908496,
        567.7146922348486,
        829.173023120915,
        10.794867739898962
      ],
      "text": "indexed expenses. The Company believes that this quantitative measure has inherent limitations. It does not take into account any govern m e n t a l",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/BKGONC+BauerBodoni-Roman",
        "size": 8.25
      }
    },
    {
      "bbox": [
        121.12061727941176,
        581.3058428030304,
        621.8152936683007,
        10.794854797979838
      ],
      "text": "actions or changes in either customer purchasing patterns or the Company\u2019s financing or operating strategies. ",
      "font": {
        "color": [
          0,
          0,
          0,
          255
