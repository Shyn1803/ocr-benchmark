    {
      "bbox": [
        121.42088700980392,
        601.3690142045455,
        829.2387102124184,
        10.794867739898962
      ],
      "text": "As a result of continued European economic convergence, including the increased influence of the Deutsche Mark, as opposed to the U.S. Dollar,",
      "font": {
        "color": [
          0,
          0,
          0,
          255
        ],
        "name": "/BKGONC+BauerBodoni-Roman",
        "size": 8.25
      }
