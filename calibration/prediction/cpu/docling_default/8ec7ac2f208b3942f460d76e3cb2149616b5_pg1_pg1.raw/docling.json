240.31622387347193,"coord_origin":"BOTTOMLEFT","l":110.51995579199999,"r":174.65993013599999,"t":250.44565982169593},"charspan":[0,12],"page_no":1}],"self_ref":"#/texts/49","text":"Introduction"},{"children":[],"content_layer":"body","label":"text","orig":"The meeting was designed to update the steering group on the progress made since the last meeting and to discuss new streams of work for the future of the FQP.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":201.66087933561596,"coord_origin":"BOTTOMLEFT","l":110.519955792,"r":503.69976788401226,"t":224.840550063744},"charspan":[0,159],"page_no":1}],"self_ref":"#/texts/50","text":"The meeting was designed to update the steering group on the progress made since the last meeting and to discuss new streams of work for the future of the FQP."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Legal Loading Initiative Implementation","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":175.51624979347196,"coord_origin":"BOTTOMLEFT","l":110.51995579200003,"r":309.779876088,"t":185.64568574169596},"charspan":[0,39],"page_no":1}],"self_ref":"#/texts/51","text":"Legal Loading Initiative Implementation"},{"children":[],"content_layer":"body","label":"text","orig":"RT quickly reviewed the main aim of the Legal Loading Initiative work, informing the group that the six site reports have now been finished in consultation with the key stakeholders in each of the areas which helped us to understand where the problems exist with respect to loading and unloading. The reports include a list of recommendations for each site to assist (un)loading conditions and these have been proposed  to  the  Boroughs  involved.  Since  then  plans  have  been  made  to  try  and obtain likely costings and timescales for the recommended work to be completed.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":71.94093122361596,"coord_origin":"BOTTOMLEFT","l":110.51995579199998,"r":503.6998186463918,"t":159.92057603174396},"charspan":[0,580],"page_no":1}],"self_ref":"#/texts/52","text":"RT quickly reviewed the main aim of the Legal Loading Initiative work, informing the group that the six site reports have now been finished in consultation with the key stakeholders in each of the areas which helped us to understand where the problems exist with respect to loading and unloading. The reports include a list of recommendations for each site to assist (un)loading conditions and these have been proposed  to  the  Boroughs  involved.  Since  then  plans  have  been  made  to  try  and obtain likely costings and timescales for the recommended work to be completed."}],"version":"1.10.0"}