,"l":136.8,"r":542.778564,"t":502.51128},"charspan":[0,228],"page_no":1}],"self_ref":"#/texts/7","text":"IBM Storwize V7000 can use SNMP traps, syslog messages, and Call Home email to notify you and the IBM Support Center when significant events are detected. Any combination of these notification methods can be used simultaneously."},{"children":[],"content_layer":"body","label":"text","orig":"Notifications are normally sent immediately after an event is raised. However, events can occur because of service actions that are performed. If a recommended service action is active, notifications about these events are sent only if the events are still unfixed when the service action completes.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":411.27967199999995,"coord_origin":"BOTTOMLEFT","l":136.80000000000004,"r":540.7287960000001,"t":456.49209599999995},"charspan":[0,299],"page_no":1}],"self_ref":"#/texts/8","text":"Notifications are normally sent immediately after an event is raised. However, events can occur because of service actions that are performed. If a recommended service action is active, notifications about these events are sent only if the events are still unfixed when the service action completes."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"SNMP notifications","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":383.49600000000004,"coord_origin":"BOTTOMLEFT","l":136.8,"r":246.0912000000002,"t":394.596},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/9","text":"SNMP notifications"},{"children":[],"content_layer":"body","label":"text","orig":"SNMP is a standard protocol for managing networks and exchanging messages. The system can send SNMP messages that notify personnel about an event. You can use an SNMP manager to view the SNMP messages that are sent by IBM Storwize V7000.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":346.298664,"coord_origin":"BOTTOMLEFT","l":136.8,"r":547.4338680000008,"t":379.51128},"charspan":[0,237],"page_no":1}],"self_ref":"#/texts/10","text":"SNMP is a standard protocol for managing networks and exchanging messages. The system can send SNMP messages that notify personnel about an event. You can use an SNMP manager to view the SNMP messages that are sent by IBM Storwize V7000."},{"children":[],"content_layer":"body","label":"text","orig":"To view the SNMP configuration, use the System window. Point to the Settings icon and click Notification → SNMP (see Figure 5-54).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":311.422728,"coord_origin":"BOTTOMLEFT","l":136.79800799999998,"r":547.416936,"t":333.49209599999995},"charspan":[0,130],"page_no":1}],"self_ref":"#/texts/11","text":"To view the SNMP configuration, use the System window. Point to the Settings icon and click Notification → SNMP (see Figure 5-54)."},{"children":[],"content_layer":"body","label":"caption","orig":"Figure 5-54   Setting SNMP server and traps","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":97.25700000000006,"coord_origin":"BOTTOMLEFT","l":136.8,"r":314.08469999999994,"t":105.582},"charspan":[0,43],"page_no":1}],"self_ref":"#/texts/12","text":"Figure 5-54   Setting SNMP server and traps"},{"children":[],"content_layer":"body","label":"text","orig":"SNMP","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":276.0,"coord_origin":"BOTTOMLEFT","l":149.33333333333334,"r":168.66666666666666,"t":284.0},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/13","text":"SNMP"},{"children":[],"content_layer":"body","label":"text","orig":"SNMP","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":270.66666666666663,"coord_origin":"BOTTOMLEFT","l":266.0,"r":289.33333333333337,"t":279.33333333333337},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/14","text":"SNMP"},{"children":[],"content_layer":"body","label":"text","orig":"MIB:","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":257.0,"coord_origin":"BOTTOMLEFT","l":266.33333333333337,"r":279.0,"t":262.33333333333337},"charspan":[0,