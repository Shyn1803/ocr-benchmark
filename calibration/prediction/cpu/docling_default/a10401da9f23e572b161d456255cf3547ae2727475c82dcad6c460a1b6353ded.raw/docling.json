s":[{"children":[],"content_layer":"body","label":"text","orig":"5","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":661.6666666666666,"coord_origin":"BOTTOMLEFT","l":61.666666666666664,"r":67.0,"t":669.6666666666666},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/0","text":"5"},{"children":[],"content_layer":"body","label":"text","orig":"10","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":556.6666666666667,"coord_origin":"BOTTOMLEFT","l":55.333333333333336,"r":68.66666666666667,"t":567.3333333333333},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/1","text":"10"},{"children":[],"content_layer":"body","label":"text","orig":"15","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":453.3333333333333,"coord_origin":"BOTTOMLEFT","l":55.333333333333336,"r":68.0,"t":464.0},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/2","text":"15"},{"children":[],"content_layer":"body","label":"text","orig":"20","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":350.0,"coord_origin":"BOTTOMLEFT","l":55.333333333333336,"r":68.66666666666667,"t":360.6666666666667},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/3","text":"20"},{"children":[],"content_layer":"body","label":"text","orig":"WO 2020/081008","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":790.0,"coord_origin":"BOTTOMLEFT","l":86.66666666666667,"r":162.0,"t":800.6666666666666},"charspan":[0,14],"page_no":1}],"self_ref":"#/texts/4","text":"WO 2020/081008"},{"children":[],"content_layer":"body","label":"text","orig":"PCT/SG2019/050511","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":790.0,"coord_origin":"BOTTOMLEFT","l":421.3333333333333,"r":512.6666666666666,"t":800.6666666666666},"charspan":[0,17],"page_no":1}],"self_ref":"#/texts/5","text":"PCT/SG2019/050511"},{"children":[],"content_layer":"body","label":"text","orig":"38","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":781.0,"coord_origin":"BOTTOMLEFT","l":290.3333333333333,"r":305.0,"t":793.0},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/6","text":"38"},{"children":[],"content_layer":"body","label":"text","orig":"may not be required if an acid such as an acrylic acid is used as a monomer in the system.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":722.4995,"coord_origin":"BOTTOMLEFT","l":85.2,"r":509.18008,"t":753.5369999999999},"charspan":[0,90],"page_no":1}],"self_ref":"#/texts/7","text":"may not be required if an acid such as an acrylic acid is used as a monomer in the system."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Dynamic light scattering (DLS) of latex particles","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":680.68775,"coord_origin":"BOTTOMLEFT","l":85.92,"r":357.4477500000001,"t":691.5565},"charspan":[0,49],"page_no":1}],"self_ref":"#/texts/8","text":"Dynamic light scattering (DLS) of latex particles"},{"children":[],"content_layer":"body","label":"text","orig":"PNIPAM latex particles samples were prepared with varying concentrations of crosslinker (i.e. N,N'-methylenebis(acrylamide) (BIS)) and surfactant (i.e. sodium dodecyl sulfate (SDS)). A summary of the composition present (wt% based on the monomer latex particles) in the samples and their corresponding aggregation percentage (Aggr %) is provided in Table 1 below. The z-average particle size (DLS Z-Ave) and polydispersity index (PDI) results of the latex particles obtained from DLS experiments are also provided in Table 1. To test for reversibility in temperature response, the measurements were first taken at (i) a temperature of about 40°C, then at (ii) a temperature of about 20°C and finally (iii) at a temperature of about 40°C. As shown in Table 1, the average particle size recorded at temperature (iii) for the samples remains relatively similar to those recorded at temperature (i). Therefore, the temperature response was proven to be reversible.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":391.2995,"coord_origin":"BOTTOMLEFT","l":84.96,"r":510.557,"t":650.097},"charspan":[0,960],"page_no":1}],"self_ref":"#/texts/9","text":"PNIPAM latex particles samples were prepared with varying concentrations of crosslinker (i.e. N,N'-methylenebis(acrylamide) (BIS)) and surfactant (i.e. sodium dodecyl sulfate (SDS)). A summary of the composition present (wt% based on the monomer latex particles) in the samples and their corresponding aggregation percentage (Aggr %) is provided in Table 1 below. The z-average particle size (DLS Z-Ave) and polydispersity index (PDI) results of the latex particles obtained from DLS experiments are also provided in Table 1. To test for reversibility in temperature response, the measurements were first taken at (i) a temperature of about 40°C, then at (ii) a temperature of about 20°C and finally (iii) at a temperature of about 40°C. As shown in Table 1, the average particle size recorded at temperature (iii) for the samples remains relatively similar to those recorded at temperature (i). Therefore, the temperature response was proven to be reversible."},{"children":[],"content_layer":"body","label":"text","orig":"Table 1. Summary of composition and DLS results of PNIPAM samples synthesized for hetero-coagulation studies","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":329.3795,"coord_origin":"BOTTOMLEFT","l":85.2,"r":461.3745,"t":360.41700000000003},"charspan":[0,108],"page_no":1}],"self_ref":"#/texts/10","text":"Table 1. Summary of composition and DLS results of PNIPAM samples synthesized for hetero-coagulation studies"}],"version":"1.10.0"}