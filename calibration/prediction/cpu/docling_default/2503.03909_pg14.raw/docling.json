#/texts/65"},{"$ref":"#/texts/66"},{"$ref":"#/texts/67"},{"$ref":"#/texts/68"},{"$ref":"#/texts/69"},{"$ref":"#/texts/70"},{"$ref":"#/texts/71"}],"content_layer":"body","footnotes":[],"label":"picture","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":129.85382080078125,"coord_origin":"BOTTOMLEFT","l":161.1501007080078,"r":449.1679992675781,"t":368.11932373046875},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/pictures/0"}],"schema_name":"DoclingDocument","tables":[],"texts":[{"children":[],"content_layer":"furniture","label":"page_header","orig":"14","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":731.9093399999999,"coord_origin":"BOTTOMLEFT","l":72.0,"r":82.0213253294256,"t":741.87198},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/0","text":"14"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"D. APPEL ¨ O AND Y. CHENG","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":732.4074724999999,"coord_origin":"BOTTOMLEFT","l":248.64,"r":363.3994855332638,"t":742.4174225},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/1","text":"D. APPEL ¨ O AND Y. CHENG"},{"children":[],"content_layer":"body","label":"text","orig":"4.2.2. Bratu problem. We use lrAA to solve the non-linear Bratu problem","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":707.54914,"coord_origin":"BOTTOMLEFT","l":90.0002,"r":429.1378587184181,"t":717.51178},"charspan":[0,71],"page_no":1}],"self_ref":"#/texts/2","text":"4.2.2. Bratu problem. We use lrAA to solve the non-linear Bratu problem"},{"children":[],"content_layer":"body","label":"formula","orig":"u xx + u yy + λe u = 0 , ( x, y ) ∈ [0 , 1] × [0 , 1] ,","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":677.7959656,"coord_origin":"BOTTOMLEFT","l":211.32028,"r":400.79940128000004,"t":696.6701775},"charspan":[0,55],"page_no":1}],"self_ref":"#/texts/3","text":""},{"children":[],"content_layer":"body","label":"text","orig":"with λ = 1 and homogeneous Dirichlet boundary conditions. To find the approximate solution we discretize this equation using standard second order finite difference approximations for the x and y derivatives. Given an approximation X ( i, j ) ≈ u ( x i , y j ) this results in a function G B ( i, j ; X ) describing the equation","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":631.2357655999999,"coord_origin":"BOTTOMLEFT","l":72.00075000000004,"r":540.1030688002043,"t":672.15198},"charspan":[0,328],"page_no":1}],"self_ref":"#/texts/4","text":"with λ = 1 and homogeneous Dirichlet boundary conditions. To find the approximate solution we discretize this equation using standard second order finite difference approximations for the x and y derivatives. Given an approximation X ( i, j ) ≈ u ( x i , y j ) this results in a function G B ( i, j ; X ) describing the equation"},{"children":[],"content_layer":"body","label":"formula","orig":"G B ( i, j ; X ) = 1 h 2 x ( X ( i +1 , j ) -2 X ( i, j ) + X ( i -1 , j )) + 1 h 2 x ( X ( i, j +1) -2 X ( i, j ) + X ( i, j -1)) + λe X ( i,j ) . (4.2)","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":575.5766175000001,"coord_origin":"BOTTOMLEFT","l":71.99972999999989,"r":423.62400150451424,"t":627.2719},"charspan":[0,153],"page_no":1}],"self_ref":"#/texts/5","text":""},{"children":[],"content_layer":"body","label":"text","orig":"Near the boundaries some of the terms in this expression will be set to zero to account for the homogeneous Dirichlet boundary conditions. In the numerical examples below we take the mesh to be x i = ih x , h x = 1 m +1 and y j = jh y , h y = 1 n +1 with m = n = 200, making the setup the same as in [52].","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":527.8165375,"coord_origin":"BOTTOMLEFT","l":71.99972999999989,"r":540.2055450847021,"t":566.1919900000001},"charspan":[0,305],"page_no":1}],"self_ref":"#/texts/6","text":"Near the boundaries some of the terms in this expression will be set to zero to account for the homogeneous Dirichlet boundary conditions. In the numerical examples below we take the mesh to be x i = ih x , h x = 1 m +1 and y j = jh y , h y = 1 n +1 with m = n = 200, making the setup the same as in [52]."},{"children":[],"content_layer":"body","label":"text","orig":"The fixed point function G ( i, j ) is obtained by applying the preconditioned Richardson iteration. We have","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":506.66931999999997,"coord_origin":"BOTTOMLEFT","l":72.00002000000006,"r":539.9804422059522,"t":528.51206},"charspan":[0,108],"page_no":1}],"self_ref":"#/texts/7","text":"The fixed point function G ( i, j ) is obtained by applying the preconditioned Richardson iteration. We have"},{"children":[],"content_layer":"body","label":"formula","orig":"X k +1 ( i, j ) = G ( i, j ; X k , α ) ≡ X k ( i, j ) + αM ( G B ( i, j ; X k )) .","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":486.51574559999995,"coord_origin":"BOTTOMLEFT","l":178.56002000000007,"r":433.3198412800001,"t":505.39034749999996},"charspan":[0,82],"page_no":1}],"self_ref":"#/texts/8","text":""},{"children":[],"content_layer":"body","label":"text","orig":"We test lrAA with no preconditioner and with the ES preconditioner (corresponding to Rel1_x_n10.1E10 ) described above. The lrAA parameters used are the following TOL = 10 -6 , ˆ m = 5 , θ = 0 . 9 , α = 0 . 125 h 2 x (un-preconditioned case) and α = 0 . 1 (preconditioned case, no scheduling is used). In all experiments we use a rank 1 matrix with Frobenius norm around 1.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":438.62904,"coord_origin":"BOTTOMLEFT","l":72.00009000000028,"r":540.7456943200001,"t":484.4717599999999},"charspan":[0,373],"page_no":1}],"self_ref":"#/texts/9","text":"We test lrAA with no preconditioner and with the ES preconditioner (corresponding to Rel1_x_n10.1E10 ) described above. The lrAA parameters used are the following TOL = 10 -6 , ˆ m = 5 , θ = 0 . 9 , α = 0 . 125 h 2 x (un-preconditioned case) and α = 0 . 1 (preconditioned case, no scheduling is used). In all experiments we use a rank 1 matrix with Frobenius norm around 1."},{"children":[],"content_layer":"body","label":"text","orig":"The results in Figure 11 display the numerical solutions obtained by lrAA methods with and without the ES preconditioner. In particular, both methods obtain visually similar numerical results in terms of solution contours and column and row index section for the final iterates. The un-preconditioned lrAA gives a montonically increasing intermediate ranks. The ES-preconditioned lrAA converges very rapidly in 8 iterations.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":378.86963999999995,"coord_origin":"BOTTOMLEFT","l":72.00015000000025,"r":540.0363615675234,"t":436.59167999999994},"charspan":[0,424],"page_no":1}],"self_ref":"#/texts/10","text":"The results in Figure 11 display the numerical solutions obtained by lrAA methods with and without the ES preconditioner. In particular, both methods obtain visually similar numerical results in terms of solution contours and column and row index section for the final iterates. The un-preconditioned lrAA gives a montonically increasing intermediate ranks. The ES-preconditioned lrAA converges very rapidly in 8 iterations."},{"children":[],"content_layer":"body","label":"caption","orig":"Fig. 11 . Bratu problem solved by lrAA. The top left figure displays the contour levels of the converged solution along with markers at the intersection points of the final index sets I and J (for both lrAA with and without ES preconditioner). The top right figure displays the singular values from lrAA solutions with and without the ES preconditioner. The bottom left figure and right figures display the rank evolution and the decay of the residual throughout the lrAA iterations for lrAA with and without the ES preconditioner.","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":71.56746250000003,"coord_origin":"BOTTOMLEFT","l":71.9991399999999,"r":540.0469943941122,"t":117.33758250000005},"charspan":[0,531],"page_no":1}],"self_ref":"#/texts/11","text":"Fig. 11 . Bratu problem solved by lrAA. The top left figure displays the contour levels of the converged solution along with markers at the intersection points of the final index sets I and J (for both lrAA with and without ES preconditioner). The top right figure displays the singular values from lrAA solutions with and without the ES preconditioner. The bottom left figure and right figures display the rank evolution and the decay of the residual throughout the lrAA iterations for lrAA with and without the ES preconditioner."},{"children":[],"content_layer":"body","label":"text","orig":"0.2","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":256.65641071999994,"coord_origin":"BOTTOMLEFT","l":196.666,"r":205.5772344,"t":262.80452135999997},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/12","text":"0.2"},{"children":[],"content_layer":"body","label":"text","orig":"0.4","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":256.65641071999994,"coord_origin":"BOTTOMLEFT","l":216.9339936016,"r":225.84522800160002,"t":262.80452135999997},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/13","text":"0.4"},{"children":[],"content_layer":"body","label":"text","orig":"0.6","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":256.65641071999994,"coord_origin":"BOTTOMLEFT","l":237.20198720320002,"r":246.11322160320003,"t":262.80452135999997},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/14","text":"0.6"},{"children":[],"content_layer":"body","label":"text","orig":"0.8","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":256.65641071999994,"coord_origin":"BOTTOMLEFT","l":257.46998080480006,"r":266.38121520480007,"t":262.80452135999997},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/15","text":"0.8"},{"children":[],"content_layer":"body","label":"text","orig":"x","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":248.18228309999995,"coord_origin":"BOTTOMLEFT","l":229.6324,"r":233.158425,"t":254.94519904999993},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts