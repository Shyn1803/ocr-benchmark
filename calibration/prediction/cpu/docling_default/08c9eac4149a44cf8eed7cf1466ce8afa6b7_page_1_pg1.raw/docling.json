e_no":1}],"self_ref":"#/texts/6","text":"1452"},{"children":[],"content_layer":"body","label":"text","orig":"Issue Number 1, 2006","parent":{"$ref":"#/groups/0"},"prov":[{"bbox":{"b":570.604,"coord_origin":"BOTTOMLEFT","l":90.024,"r":199.01,"t":580.936},"charspan":[0,20],"page_no":1}],"self_ref":"#/texts/7","text":"Issue Number 1, 2006"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"IMMEDIATE PAST PRESIDENT'S MESSAGE","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":528.9228618784531,"coord_origin":"BOTTOMLEFT","l":90.024,"r":279.38399999999996,"t":553.516},"charspan":[0,34],"page_no":1}],"self_ref":"#/texts/8","text":"IMMEDIATE PAST PRESIDENT'S MESSAGE"},{"children":[],"content_layer":"body","label":"caption","orig":"Dear OPCC members,","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":306.07399999999996,"coord_origin":"BOTTOMLEFT","l":90.024,"r":200.69,"t":316.40599999999995},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/9","text":"Dear OPCC members,"},{"children":[],"content_layer":"body","label":"text","orig":"My last five years as a member of OPCC have been very enjoyable and rewarding.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":250.87400000000002,"coord_origin":"BOTTOMLEFT","l":90.024,"r":269.82000000000005,"t":288.806},"charspan":[0,78],"page_no":1}],"self_ref":"#/texts/10","text":"My last five years as a member of OPCC have been very enjoyable and rewarding."},{"children":[],"content_layer":"body","label":"text","orig":"I have met many talented people and have made many friends, and have learned more about photography than I had hoped for.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":195.67399999999998,"coord_origin":"BOTTOMLEFT","l":90.024,"r":279.842,"t":247.40599999999995},"charspan":[0,121],"page_no":1}],"self_ref":"#/texts/11","text":"I have met many talented people and have made many friends, and have learned more about photography than I had hoped for."},{"children":[],"content_layer":"body","label":"text","orig":"There have been a lot of changes in my life in the last two years, and I have decided to move from western Washington where I have lived all my life to Carlsbad, California.  I have some family in the area and had met a friend there last year.  She is a world traveler and an avid photographer.  But the Northwest will always be my \"home\".","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":404.974,"coord_origin":"BOTTOMLEFT","l":324.05,"r":522.5559999999999,"t":525.706},"charspan":[0,339],"page_no":1}],"self_ref":"#/texts/12","text":"There have been a lot of changes in my life in the last two years, and I have decided to move from western Washington where I have lived all my life to Carlsbad, California.  I have some family in the area and had met a friend there last year.  She is a world traveler and an avid photographer.  But the Northwest will always be my \"home\"."},{"children":[],"content_layer":"body","label":"text","orig":"The travel bug is still with me having traveled to Europe, Africa, South America and Antarctica since we last met and with a few weeks in Southeast Asia scheduled for February.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":322.154,"coord_origin":"BOTTOMLEFT","l":324.05,"r":514.06,"t":387.70599999999996},"charspan":[0,176],"page_no":1}],"self_ref":"#/texts/13","text":"The travel bug is still with me having traveled to Europe, Africa, South America and Antarctica since we last met and with a few weeks in Southeast Asia scheduled for February."},{"children":[],"content_layer":"body","label":"text","orig":"I will send Jim my email address once I get settled so we can keep in contact. Thanks again for the friendships and I wish all of you a Great Christmas and all the best in the New Year.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":239.35400000000004,"coord_origin":"BOTTOMLEFT","l":324.05,"r":520.5219999999998,"t":304.88599999999997},"charspan":[0,185],"page_no":1}],"self_ref":"#/texts/14","text":"I will send Jim my email address once I get settled so we can keep in contact. Thanks again for the friendships and I wish all of you a Great Christmas and all the best in the New Year."},{"children":[],"content_layer":"body","label":"text","orig":"Bob Mandich","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":211.75400000000002,"coord_origin":"BOTTOMLEFT","l":324.05,"r":392.71,"t":222.086},"charspan":[0,11],"page_no":1}],"self_ref":"#/texts/15","text":"Bob Mandich"},{"children":[],"content_layer":"body","label":"text","orig":"________________________________________________________________________","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":181.6505454545454,"coord_origin":"BOTTOMLEFT","l":90.024,"r":528.1,"t":191.74400000000003},"charspan":[0,72],"page_no":1}],"self_ref":"#/texts/16","text":"________________________________________________________________________"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"SENSOR DUST","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":153.99286187845303,"coord_origin":"BOTTOMLEFT","l":63.0,"r":149.724,"t":164.75599999999997},"charspan":[0,11],"page_no":1}],"self_ref":"#/texts/17","text":"SENSOR DUST"},{"children":[],"content_layer":"body","label":"text","orig":"Bob Huelsdonk","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":142.33747535911607,"coord_origin":"BOTTOMLEFT","l":99.024,"r":169.58888,"t":151.27088000000003},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/18","text":"Bob Huelsdonk"},{"children":[],"content_layer":"body","label":"text","orig":"Last January, I submitted a digital projected competition print from my digital Canon D60 SLR which showed some wind generators against a plain blue sky.  Two of our discerning members, Jean Timmermeister and Valerie Henschel commented that the sky had a dim but noticeable dust spot on it.  I had not noticed it on my computer screen or even on the projected image until it was pointed out.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":61.82147535911599,"coord_origin":"BOTTOMLEFT","l":63.0,"r":321.38231999999994,"t":128.23088000000007},"charspan":[0,312],"page_no":1},{"bbox":{"b":144.61747535911604,"coord_origin":"BOTTOMLEFT","l":355.63,"r":576.34888,"t":165.07088},"charspan":[313,391],"page_no":1}],"self_ref":"#/texts/19","text":"Last January, I submitted a digital projected competition print from my digital Canon D60 SLR which showed some wind generators against a plain blue sky.  Two of our discerning members, Jean Timmermeister and Valerie Henschel commented that the sky had a dim but noticeable dust spot on it.  I had not noticed it on my computer screen or even on the projected image until it was pointed out."},{"children":[],"content_layer":"body","label":"text","orig":"Returning home, I put the print on my computer screen.  Indeed it showed as about a 1/2 inch, slightly darker blob (on an 8x10 image).  I then increased the contrast greatly, and lo and","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":87.14147535911604,"coord_origin":"BOTTOMLEFT","l":355.63,"r":567.9488799999999,"t":130.51088000000004},"charspan":[0,185],"page_no":1}],"self_ref":"#/texts/20","text":"Returning home, I put the print on my computer screen.  Indeed it showed as about a 1/2 inch, slightly darker blob (on an 8x10 image).  I then increased the contrast greatly, and lo and"},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"1","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":36.888000000000034,"coord_origin":"BOTTOMLEFT","l":303.05,"r":312.05,"t":47.22000000000003},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/21","text":"1"}],"version":"1.10.0"}