08.66666666666669,"r":226.66666666666669,"t":300.6666666666667},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/57","text":"0.10"},{"children":[],"content_layer":"body","label":"text","orig":"0.20","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":291.3333333333333,"coord_origin":"BOTTOMLEFT","l":248.66666666666669,"r":267.33333333333337,"t":300.6666666666667},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/58","text":"0.20"},{"children":[],"content_layer":"body","label":"text","orig":"0.30","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":291.3333333333333,"coord_origin":"BOTTOMLEFT","l":289.33333333333337,"r":307.33333333333337,"t":300.6666666666667},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/59","text":"0.30"},{"children":[],"content_layer":"body","label":"text","orig":"Deo","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":604.887356845585,"coord_origin":"BOTTOMLEFT","l":212.8378039025019,"r":226.8288627641648,"t":608.7793098210816},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/60","text":"Deo"},{"children":[],"content_layer":"body","label":"text","orig":"dissolved hydrogen partial pressure steadily decreased to become as low as 1 kPa. Before that time, the hydrogen consumption rate had become constant (84 ml min -1 ), and 98% of the gas ended up in methane. When the p H2 had reached the minimum at t = 10 h, the optical density increased linearly over time. This period is denoted as the linear phase. Apparently, growth now became limited by the H 2 supply. To test this, the organism was grown at a higher gassing rate (428 ml min -1 ). The same growth behavior was found (Fig. 2A). Quite remarkably, p H2 did not drop to low values during the linear growth stage, but it was maintained as high as 29 kPa. Again, the hydrogen consumption rate became constant ( 𝛎 H2 = 275 ml min -1 ), but the gas was only partly utilized. Further experiments showed that the p H2 values could be manipulated by the H2-CO2 gassing regimen (Table 3). Depending on the hydro- gen mass transfer characteristics, i.e., gassing rate/culture volume ratio and mixing intensity (number of impellers), steady p H2 values were obtained during the linear growth phase that ranged between 1 and 59 kPa. Linear growth could proceed for prolonged periods of time (at least 72 h), at which OD600 values of up to 7 to 10 were obtained (data not shown). Hydrogen consumption and methane production rates, as well as dissolved hydrogen partial pressures, however, remained constant throughout the whole period of linear growth.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":56.35908088642657,"coord_origin":"BOTTOMLEFT","l":43.16409999999999,"r":283.23610000000014,"t":218.61440000000005},"charspan":[0,908],"page_no":1},{"bbox":{"b":122.3598808864266,"coord_origin":"BOTTOMLEFT","l":301.1648,"r":541.2333000000004,"t":218.6141},"charspan":[909,1444],"page_no":1}],"self_ref":"#/texts/61","text":"dissolved hydrogen partial pressure steadily decreased to become as low as 1 kPa. Before that time, the hydrogen consumption rate had become constant (84 ml min -1 ), and 98% of the gas ended up in methane. When the p H2 had reached the minimum at t = 10 h, the optical density increased linearly over time. This period is denoted as the linear phase. Apparently, growth now became limited by the H 2 supply. To test this, the organism was grown at a higher gassing rate (428 ml min -1 ). The same growth behavior was found (Fig. 2A). Quite remarkably, p H2 did not drop to low values during the linear growth stage, but it was maintained as high as 29 kPa. Again, the hydrogen consumption rate became constant ( 𝛎 H2 = 275 ml min -1 ), but the gas was only partly utilized. Further experiments showed that the p H2 values could be manipulated by the H2-CO2 gassing regimen (Table 3). Depending on the hydro- gen mass transfer characteristics, i.e., gassing rate/culture volume ratio and mixing intensity (number of impellers), steady p H2 values were obtained during the linear growth phase that ranged between 1 and 59 kPa. Linear growth could proceed for prolonged periods of time (at least 72 h), at which OD600 values of up to 7 to 10 were obtained (data not shown). Hydrogen consumption and methane production rates, as well as dissolved hydrogen partial pressures, however, remained constant throughout the whole period of linear growth."},{"children":[],"content_layer":"body","label":"text","orig":"Growth rates, growth yields, and methane-forming activities in the fed-batch fermentor system. As noted above, three consecutive growth phases could be discerned, notably the lag, exponential, and linear phases. The exponential phase is usually determined from the straight section of the graphs in which the (natural) logarithm of biomass (or OD) is plotted against","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":56.361080886426635,"coord_origin":"BOTTOMLEFT","l":301.1648,"r":541.2469999999997,"t":119.48919999999998},"charspan":[0,366],"page_no":1}],"self_ref":"#/texts/62","text":"Growth rates, growth yields, and methane-forming activities in the fed-batch fermentor system. As noted above, three consecutive growth phases could be discerned, notably the lag, exponential, and linear phases. The exponential phase is usually determined from the straight section of the graphs in which the (natural) logarithm of biomass (or OD) is plotted against"}],"version":"1.10.0"}