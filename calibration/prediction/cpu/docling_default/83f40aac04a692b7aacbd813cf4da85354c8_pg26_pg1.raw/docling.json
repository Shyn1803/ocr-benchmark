8125,"r":385.3907165527344,"t":665.4350509643555},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"5. Software","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":541.6654267481267,"coord_origin":"BOTTOMLEFT","l":110.85400000000001,"r":178.71051968,"t":552.1592671999999},"charspan":[0,11],"page_no":1}],"self_ref":"#/texts/0","text":"5. Software"},{"children":[],"content_layer":"body","label":"text","orig":"We provide two software solutions in relation to the current paper. An R package, msgl , with a relatively simple interface to our multinomial and logistic sparse group lasso regression routines. In addition, a C++ template library, sgl , is provided. The sgl template library gives access to the generic sparse group lasso routines. The R package relies on this library. The sgl template library relies on several external libraries. We use the Armadillo C++ library [14] as our primary linear algebra engine. Armadillo is a C++ template library using expression template techniques to optimize the performance of matrix expressions. Furthermore we utilize several Boost libraries [15]. Boost is a collection of free peer-reviewed C++ libraries, many of which are template libraries. For an introduction to these libraries see for example [16]. Use of multiple processors for cross validation and subsampling is supported through OpenMP [17].","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":344.63424479999975,"coord_origin":"BOTTOMLEFT","l":110.85400000000001,"r":499.40278208000024,"t":529.9514},"charspan":[0,943],"page_no":1}],"self_ref":"#/texts/1","text":"We provide two software solutions in relation to the current paper. An R package, msgl , with a relatively simple interface to our multinomial and logistic sparse group lasso regression routines. In addition, a C++ template library, sgl , is provided. The sgl template library gives access to the generic sparse group lasso routines. The R package relies on this library. The sgl template library relies on several external libraries. We use the Armadillo C++ library [14] as our primary linear algebra engine. Armadillo is a C++ template library using expression template techniques to optimize the performance of matrix expressions. Furthermore we utilize several Boost libraries [15]. Boost is a collection of free peer-reviewed C++ libraries, many of which are template libraries. For an introduction to these libraries see for example [16]. Use of multiple processors for cross validation and subsampling is supported through OpenMP [17]."},{"children":[],"content_layer":"body","label":"text","orig":"The msgl R package is available from CRAN . The sgl library is available upon request.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":315.7422447999997,"coord_origin":"BOTTOMLEFT","l":110.85399999999998,"r":499.4009904000001,"t":342.15539999999976},"charspan":[0,86],"page_no":1}],"self_ref":"#/texts/2","text":"The msgl R package is available from CRAN . The sgl library is available upon request."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"5.1. Run-time performance","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":290.49845257867406,"coord_origin":"BOTTOMLEFT","l":110.85399999999998,"r":250.29227967999992,"t":300.9464015999997},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/3","text":"5.1. Run-time performance"},{"children":[],"content_layer":"body","label":"text","orig":"Table 3 lists run-times of the current multinomial sparse group lasso implementation for three real data examples. For comparison, the glmnet uses 5.2s, 8.3s and 137.0s, respectively, to fit the lasso path for the three data sets in Table 3. The glmnet is a fast implementation of the coordinate descent algorithm for fitting generalized linear models with the lasso penalty or the elastic net penalty [10]. The glmnet cannot be used to fit models with group lasso or sparse group lasso penalty.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":186.10924479999971,"coord_origin":"BOTTOMLEFT","l":110.85399999999998,"r":499.40337280000017,"t":284.75139999999976},"charspan":[0,495],"page_no":1}],"self_ref":"#/texts/4","text":"Table 3 lists run-times of the current multinomial sparse group lasso implementation for three real data examples. For comparison, the glmnet uses 5.2s, 8.3s and 137.0s, respectively, to fit the lasso path for the three data sets in Table 3. The glmnet is a fast implementation of the coordinate descent algorithm for fitting generalized linear models with the lasso penalty or the elastic net penalty [10]. The glmnet cannot be used to fit models with group lasso or sparse group lasso penalty."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"6. Conclusion","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":154.87742674812648,"coord_origin":"BOTTOMLEFT","l":110.85400000000007,"r":192.3788998400001,"t":165.3712671999997},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/5","text":"6. Conclusion"},{"children":[],"content_layer":"body","label":"text","orig":"We developed an algorithm for solving the sparse group lasso optimization problem with a general convex loss function. Furthermore, convergence","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":116.75024479999968,"coord_origin":"BOTTOMLEFT","l":110.85400000000007,"r":499.40278208000046,"t":143.16339999999968},"charspan":[0,143],"page_no":1}],"self_ref":"#/texts/6","text":"We developed an algorithm for solving the sparse group lasso optimization problem with a general convex loss function. Furthermore, convergence"},{"children":[],"content_layer":"body","label":"caption","orig":"Table 2: Timing the Hessian bound optimization scheme.","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":575.2888898772334,"coord_origin":"BOTTOMLEFT","l":179.95600000000002,"r":430.29422028,"t":583.9954558},"charspan":[0,54],"page_no":1}],"self_ref":"#/texts/7","text":"