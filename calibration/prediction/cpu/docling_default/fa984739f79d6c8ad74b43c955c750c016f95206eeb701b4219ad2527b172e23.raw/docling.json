667,"coord_origin":"BOTTOMLEFT","l":438.6666666666667,"r":473.3333333333333,"t":627.6666666666667},"charspan":[0,11],"page_no":1}],"self_ref":"#/texts/8","text":"k1-5, k2=40"},{"children":[],"content_layer":"body","label":"text","orig":"k1=10, k2=1","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":540.0,"coord_origin":"BOTTOMLEFT","l":169.0,"r":201.66666666666666,"t":546.6666666666666},"charspan":[0,11],"page_no":1}],"self_ref":"#/texts/9","text":"k1=10, k2=1"},{"children":[],"content_layer":"body","label":"text","orig":"k1=10, k2=40","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":540.0,"coord_origin":"BOTTOMLEFT","l":437.6666666666667,"r":474.3333333333333,"t":546.6666666666666},"charspan":[0,12],"page_no":1}],"self_ref":"#/texts/10","text":"k1=10, k2=40"},{"children":[],"content_layer":"body","label":"text","orig":"k1=10, k2-10","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":535.6666666666666,"coord_origin":"BOTTOMLEFT","l":302.0,"r":339.3333333333333,"t":543.6666666666666},"charspan":[0,12],"page_no":1}],"self_ref":"#/texts/11","text":"k1=10, k2-10"},{"children":[],"content_layer":"body","label":"text","orig":"True DTE","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":470.0,"coord_origin":"BOTTOMLEFT","l":313.0,"r":330.3333333333333,"t":474.66666666666663},"charspan":[0,8],"page_no":1}],"self_ref":"#/texts/12","text":"True DTE"},{"children":[],"content_layer":"body","label":"text","orig":"Makarov lower","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":464.6666666666667,"coord_origin":"BOTTOMLEFT","l":313.0,"r":338.3333333333333,"t":469.3333333333333},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/13","text":"Makarov lower"},{"children":[],"content_layer":"body","label":"text","orig":"Makarov upper","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":458.6666666666667,"coord_origin":"BOTTOMLEFT","l":313.0,"r":339.6666666666667,"t":464.0},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/14","text":"Makarov upper"},{"children":[],"content_layer":"body","label":"text","orig":"Now lower bound","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":454.0,"coord_origin":"BOTTOMLEFT","l":313.0,"r":343.6666666666667,"t":458.0},"charspan":[0,15],"page_no":1}],"self_ref":"#/texts/15","text":"Now lower bound"},{"children":[],"content_layer":"body","label":"text","orig":"F 0 and F 1 over the support causes more triangles having positive probability lower bounds, which leads the improvement of my new lower bound. On the other hand, the Makarov lower bound gets no such informational gain because it uses only one triangle while my new lower bound takes advantage of multiple triangles.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":325.6758898772335,"coord_origin":"BOTTOMLEFT","l":72.0,"r":540.00409386,"t":394.1704558},"charspan":[0,316],"page_no":1}],"self_ref":"#/texts/16","text":"F 0 and F 1 over the support causes more triangles having positive probability lower bounds, which leads the improvement of my new lower bound. On the other hand, the Makarov lower bound gets no such informational gain because it uses only one triangle while my new lower bound takes advantage of multiple triangles."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"5 Application to the Distribution of Effects of Smoking on Birth Weight","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":250.0259197682998,"coord_origin":"BOTTOMLEFT","l":72.0,"r":540.0003017799997,"t":292.51249320000005},"charspan":[0,71],"page_no":1}],"self_ref":"#/texts/17","text":"5 Application to the Distribution of Effects of Smoking on Birth Weight"},{"children":[],"content_layer":"body","label":"text","orig":"In this section, I apply the results presented in Section 3 to an empirical analysis of the distribution of smoking effects on infant birth weight. Smoking not only has a direct impact on infant birth weight, but is also associated with unobservable factors that affect infant birth weight. I identify marginal distributions of potential infant birth weight with and without smoking by making use of a state cigarette tax hike in Massachusetts (MA) in January 1993 as a source of exogenous variation. I focus on pregnant women who change their smoking behavior from smoking to nonsmoking in response to the tax increase. To identify the distribution of smoking effects, I impose a MTR restriction that smoking has nonpositive effects on infant birth weight with probability one. I propose an estimation procedure and report estimates of the DTE","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":81.57388987723346,"coord_origin":"BOTTOMLEFT","l":72.0,"r":540.00409386,"t":229.7864558},"charspan":[0,844],"page_no":1}],"self_ref":"#/texts/18","text":"In this section, I apply the results presented in Section 3 to an empirical analysis of the distribution of smoking effects on infant birth weight. Smoking not only has a direct impact on infant birth weight, but is also associated with unobservable factors that affect infant birth weight. I identify marginal distributions of potential infant birth weight with and without smoking by making use of a state cigarette tax hike in Massachusetts (MA) in January 1993 as a source of exogenous variation. I focus on pregnant women who change their smoking behavior from smoking to nonsmoking in response to the tax increase. To identify the distribution of smoking effects, I impose a MTR restriction that smoking has nonpositive effects on infant birth weight with probability one. I propose an estimation procedure and report estimates of the DTE"},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"30","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":40.20988987723342,"coord_origin":"BOTTOMLEFT","l":301.019,"r":310.98159999999996,"t":48.916455799999994},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/19","text":"30"}],"version":"1.10.0"}