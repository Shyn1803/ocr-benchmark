rd_origin":"TOPLEFT","l":330.7693672180176,"r":382.55818033218384,"t":85.82178343459964},"col_span":1,"column_header":true,"end_col_offset_idx":2,"end_row_offset_idx":1,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":1,"start_row_offset_idx":0,"text":"Description"}],[{"bbox":{"b":113.12848284840584,"coord_origin":"TOPLEFT","l":140.95050740242004,"r":223.5441374182701,"t":101.66863736510277},"col_span":1,"column_header":false,"end_col_offset_idx":1,"end_row_offset_idx":2,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":0,"start_row_offset_idx":1,"text":"Accessibility Mode"},{"bbox":{"b":405.4539766311645,"coord_origin":"TOPLEFT","l":317.3499717116356,"r":518.9780316352844,"t":103.17614585161209},"col_span":1,"column_header":false,"end_col_offset_idx":2,"end_row_offset_idx":2,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":1,"start_row_offset_idx":1,"text":"Turning on the Accessibility mode enables the accessibility features if you use only the keyboard to interact with BI Publisher. When Accessibility Mode is enabled, • The tables on the user interface pages display options to enable multi-row selection and subsequent action. • The assistive technology provides access to menus. • Skip to content  is enabled. When tabbing into the main page of the application, the first item you tab to is a special field that states  Skip to content . When you press the  Enter  key with focus on an item, the focus skips over the header links to the main body of the page. For example, if you are on the Home page and you tab to  Skip to content , and then press  Enter , the cursor advances to the Create  region with the focus on Report. The focus skips over  Search ,  Help ,  Sign Out , and other links in the global header. • The create report process flow limits the options to make the selection of a data model as the first step in the process. • The  Administration  link is not displayed."}],[{"bbox":{"b":412.3269151449203,"coord_origin":"TOPLEFT","l":139.23339377343655,"r":213.86050981283188,"t":401.900286078453},"col_span":1,"column_header":false,"end_col_offset_idx":1,"end_row_offset_idx":3,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":0,"start_row_offset_idx":2,"text":"Email Addresses"},{"bbox":{"b":422.3471573591232,"coord_origin":"TOPLEFT","l":327.8172656297684,"r":514.5876458883286,"t":401.28332078456873},"col_span":1,"column_header":false,"end_col_offset_idx":2,"end_row_offset_idx":3,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":1,"start_row_offset_idx":2,"text":"This field is reserved for future use and is not functional in this release."}]],"num_cols":2,"num_rows":3,"orientation":"rot_0","table_cells":[{"bbox":{"b":96.65056945383549,"coord_origin":"TOPLEFT","l":138.69644148647785,"r":169.93082366883755,"t":86.03737115859985},"col_span":1,"column_header":true,"end_col_offset_idx":1,"end_row_offset_idx":1,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":0,"start_row_offset_idx":0,"text":"Option"},{"bbox":{"b":96.95169873535633,"coord_origin":"TOPLEFT","l":330.7693672180176,"r":382.55818033218384,"t":85.82178343459964},"col_span":1,"column_header":true,"end_col_offset_idx":2,"end_row_offset_idx":1,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":1,"start_row_offset_idx":0,"text":"Description"},{"bbox":{"b":113.12848284840584,"coord_origin":"TOPLEFT","l":140.95050740242004,"r":223.5441374182701,"t":101.66863736510277},"col_span":1,"column_header":false,"end_col_offset_idx":1,"end_row_offset_idx":2,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":0,"start_row_offset_idx":1,"text":"Accessibility Mode"},{"bbox":{"b":405.4539766311645,"coord_origin":"TOPLEFT","l":317.3499717116356,"r":518.978031635