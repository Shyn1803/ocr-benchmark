gin":"BOTTOMLEFT","l":122.4527,"r":127.3913144,"t":413.01214880000003},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/1","text":"0"},{"children":[],"content_layer":"body","label":"text","orig":"0.1","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":444.246476987674,"coord_origin":"BOTTOMLEFT","l":115.0092488,"r":127.3913144,"t":452.66505040000004},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/2","text":"0.1"},{"children":[],"content_layer":"body","label":"text","orig":"0.2","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":483.899378587674,"coord_origin":"BOTTOMLEFT","l":115.0092488,"r":127.3913144,"t":492.31795200000005},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/3","text":"0.2"},{"children":[],"content_layer":"body","label":"text","orig":"0.3","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":523.472298987674,"coord_origin":"BOTTOMLEFT","l":115.0092488,"r":127.3913144,"t":531.8908724},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/4","text":"0.3"},{"children":[],"content_layer":"body","label":"text","orig":"0.4","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":563.1252005876739,"coord_origin":"BOTTOMLEFT","l":115.0092488,"r":127.3913144,"t":571.543774},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/5","text":"0.4"},{"children":[],"content_layer":"body","label":"text","orig":"0.5","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":602.7781021876739,"coord_origin":"BOTTOMLEFT","l":115.0092488,"r":127.3913144,"t":611.1966755999999},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/6","text":"0.5"},{"children":[],"content_layer":"body","label":"text","orig":"0.6","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":642.4310037876738,"coord_origin":"BOTTOMLEFT","l":115.0092488,"r":127.3913144,"t":650.8495771999999},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/7","text":"0.6"},{"children":[],"content_layer":"body","label":"text","orig":"0","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":391.757075387674,"coord_origin":"BOTTOMLEFT","l":131.7146,"r":136.6532144,"t":400.17564880000003},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/8","text":"0"},{"children":[],"content_layer":"body","label":"text","orig":"5","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":391.757075387674,"coord_origin":"BOTTOMLEFT","l":194.12234239999998,"r":199.06095679999999,"t":400.17564880000003},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/9","text":"5"},{"children":[],"content_layer":"body","label":"text","orig":"10","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":391.757075387674,"coord_origin":"BOTTOMLEFT","l":253.9453064,"r":263.8225352,"t":400.17564880000003},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/10","text":"10"},{"children":[],"content_layer":"body","label":"text","orig":"15","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":391.757075387674,"coord_origin":"BOTTOMLEFT","l":316.3530488,"r":326.2302776,"t":400.17564880000003},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/11","text":"15"},{"children":[],"content_layer":"body","label":"text","orig":"20","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":391.757075387674,"coord_origin":"BOTTOMLEFT","l":378.6808496,"r":388.5580784,"t":400.17564880000003},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/12","text":"20"},{"children":[],"content_layer":"body","label":"text","orig":"25","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":391.757075387674,"coord_origin":"BOTTOMLEFT","l":441.088592,"r":450.9658208,"t":400.17564880000003},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/13","text":"25"},{"children":[],"content_layer":"body","label":"text","orig":"30","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":391.757075387674,"coord_origin":"BOTTOMLEFT","l":503.41639280000004,"r":513.2936216,"t":400.17564880000003},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/14","text":"30"},{"children":[],"content_layer":"body","label":"text","orig":"Pressure, MPa","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":376.40461906059403,"coord_origin":"BOTTOMLEFT","l":290.5341,"r":351.9647784000001,"t":385.1363488},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/15","text":"Pressure, MPa"},{"children":[],"content_layer":"body","label":"text","orig":"M / M0, -","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":511.5439,"coord_origin":"BOTTOMLEFT","l":101.3649016,"r":110.09230811722772,"t":545.3403596},"charspan":[0,9],"page_no":1}],"self_ref":"#/texts/16","text":"M / M0, -"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"2.2.4 A Maximum of Storage Capacity for CO2 with SO2","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":307.5794035087719,"coord_origin":"BOTTOMLEFT","l":89.88,"r":381.24,"t":317.91610000000003},"charspan":[0,52],"page_no":1}],"self_ref":"#/texts/17","text":"2.2.4 A Maximum of Storage Capacity for CO2 with SO2"},{"children":[],"content_layer":"body","label":"text","orig":"For  impurities  which  have  higher  critical  temperature  than  that  of  CO2,  no  storage capacity minimum would occur in the corresponding CO2 mixture. Rather, a maximum can appear based on an analysis similar to that for the non-condensable impurities. This has  been  verified  with  calculated  results  for  the  CO2  mixture  with  2.9  vol  %  SO2 (the Cansolv ® absorption system case presented in the previous IEA GHG report PH4/32). As shown in Figure 2.6, a maximum is seen at about 11 MPa, where the storage capacity is increased by over 5%. It should be noted again that the storage capacity is based on pure CO2 (see discussion for Equation 2.5). It is, therefore, interesting to see that in this peak region, the CO2-based capacity is above that of pure CO2. In other words, SO2 does not take any but creates space for CO2. This can be rationalized from the consideration that SO2 decreases average distance between the molecules of the mixture - an opposite effect of  that  of  the  non-condensable  gases.  This  can  be  taken  as  one  positive  effect  of  the presence of SO2 on CO2 storage. However, SO2 causes more concern with regard to its chemical effects on formation rocks. This will be discussed later.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":102.57448659384306,"coord_origin":"BOTTOMLEFT","l":89.87999999999982,"r":525.24,"t":292.3561},"charspan":[0,1237],"page_no":1}],"self_ref":"#/texts/18","text":"For  impurities  which  have  higher  critical  temperature  than  that  of  CO2,  no  storage capacity minimum would occur in the corresponding CO2 mixture. Rather, a maximum can appear based on an analysis similar to that for the non-condensable impurities. This has  been  verified  with  calculated  results  for  the  CO2  mixture  with  2.9  vol  %  SO2 (the Cansolv ® absorption system case presented in the previous IEA GHG report PH4/32). As shown in Figure 2.6, a maximum is seen at about 11 MPa, where the storage capacity is increased by over 5%. It should be noted again that the storage capacity is based on pure CO2 (see discussion for Equation 2.5). It is, therefore, interesting to see that in this peak region, the CO2-based capacity is above that of pure CO2. In other words, SO2 does not take any but creates space for CO2. This can be rationalized from the consideration that SO2 decreases average distance between the molecules of the mixture - an opposite effect of  that  of  the  non-condensable  gases.  This  can  be  taken  as  one  positive  effect  of  the presence of SO2 on CO2 storage. However, SO2 causes more concern with regard to its chemical effects on formation rocks. This will be discussed later."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"19","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":35.97448659384304,"coord_origin":"BOTTOMLEFT","l":291.0,"r":306.0,"t":46.355999999999995},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/19","text":"19"}],"version":"1.10.0"}