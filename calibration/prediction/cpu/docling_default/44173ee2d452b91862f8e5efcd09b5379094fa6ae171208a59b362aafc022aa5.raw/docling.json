348.658,"coord_origin":"BOTTOMLEFT","l":335.63,"r":347.63,"t":360.658},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/15","text":"则"},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"第一条 为了保障网络安全，维护网络空间主权和国家安全、社会公共利益，保护 公民、法人和其他组织的合法权益，促进经济社会信息化健康发展，制定本法。","parent":{"$ref":"#/groups/1"},"prov":[{"bbox":{"b":300.658,"coord_origin":"BOTTOMLEFT","l":72.025,"r":539.828,"t":336.658},"charspan":[0,72],"page_no":1}],"self_ref":"#/texts/16","text":"第一条 为了保障网络安全，维护网络空间主权和国家安全、社会公共利益，保护 公民、法人和其他组织的合法权益，促进经济社会信息化健康发展，制定本法。"},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"第二条 在中华人民共和国境内建设、运营、维护和使用网络，以及网络安全的监 督管理，适用本法。","parent":{"$ref":"#/groups/1"},"prov":[{"bbox":{"b":252.63800000000003,"coord_origin":"BOTTOMLEFT","l":72.025,"r":539.828,"t":288.658},"charspan":[0,46],"page_no":1}],"self_ref":"#/texts/17","text":"第二条 在中华人民共和国境内建设、运营、维护和使用网络，以及网络安全的监 督管理，适用本法。"},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"第三条 国家坚持网络安全与信息化发展并重，遵循积极利用、科学发展、依法管 理、确保安全的方针，推进网络基础设施建设和互联互通，鼓励网络技术创新和应用，支 持培养网络安全人才，建立健全网络安全保障体系，提高网络安全保护能力。","parent":{"$ref":"#/groups/1"},"prov":[{"bbox":{"b":180.60799999999995,"coord_origin":"BOTTOMLEFT","l":72.025,"r":540.025,"t":240.63800000000003},"charspan":[0,111],"page_no":1}],"self_ref":"#/texts/18","text":"第三条 国家坚持网络安全与信息化发展并重，遵循积极利用、科学发展、依法管 理、确保安全的方针，推进网络基础设施建设和互联互通，鼓励网络技术创新和应用，支 持培养网络安全人才，建立健全网络安全保障体系，提高网络安全保护能力。"},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"第四条 国家制定并不断完善网络安全战略，明确保障网络安全的基本要求和主要 目标，提出重点领域的网络安全政策、工作任务和措施。","parent":{"$ref":"#/groups/1"},"prov":[{"bbox":{"b":132.60799999999995,"coord_origin":"BOTTOMLEFT","l":72.025,"r":539.828,"t":168.60799999999995},"charspan":[0,62],"page_no":1}],"self_ref":"#/texts/19","text":"第四条 国家制定并不断完善网络安全战略，明确保障网络安全的基本要求和主要 目标，提出重点领域的网络安全政策、工作任务和措施。"},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"Source: http://www.npc.gov.cn/npc/xinwen/2016-11/07/content_2001605.htm","parent":{"$ref":"#/groups/2"},"prov":[{"bbox":{"b":80.33899999999994,"coord_origin":"BOTTOMLEFT","l":72.025,"r":530.2444999999999,"t":92.82349999999997},"charspan":[0,71],"page_no":1}],"self_ref":"#/texts/20","text":"Source: http://www.npc.gov.cn/npc/xinwen/2016-11/07/content_2001605.htm"},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"Accessed: 28-March_2018","parent":{"$ref":"#/groups/2"},"prov":[{"bbox":{"b":63.339000000000055,"coord_origin":"BOTTOMLEFT","l":72.025,"r":234.6,"t":75.82349999999997},"charspan":[0,23],"page_no":1}],"self_ref":"#/texts/21","text":"Accessed: 28-March_2018"}],"version":"1.10.0"}