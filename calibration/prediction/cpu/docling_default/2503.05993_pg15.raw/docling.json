6667},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/68","text":"125"},{"children":[],"content_layer":"body","label":"text","orig":"k=0","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":378.3333333333333,"coord_origin":"BOTTOMLEFT","l":466.0,"r":476.6666666666667,"t":383.6666666666667},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/69","text":"k=0"},{"children":[],"content_layer":"body","label":"text","orig":"k=1","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":378.3333333333333,"coord_origin":"BOTTOMLEFT","l":486.0,"r":496.6666666666667,"t":383.6666666666667},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/70","text":"k=1"},{"children":[],"content_layer":"body","label":"text","orig":"k=2","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":378.3333333333333,"coord_origin":"BOTTOMLEFT","l":506.0,"r":516.6666666666667,"t":383.6666666666667},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/71","text":"k=2"},{"children":[],"content_layer":"body","label":"text","orig":"k=3","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":378.3333333333333,"coord_origin":"BOTTOMLEFT","l":526.0,"r":536.6666666666667,"t":383.6666666666667},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/72","text":"k=3"},{"children":[],"content_layer":"body","label":"text","orig":"k=4","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":378.3333333333333,"coord_origin":"BOTTOMLEFT","l":546.0,"r":556.0,"t":383.6666666666667},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/73","text":"k=4"},{"children":[],"content_layer":"body","label":"text","orig":"Highest monomial degree","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":369.0,"coord_origin":"BOTTOMLEFT","l":224.33333333333334,"r":302.66666666666663,"t":380.0},"charspan":[0,23],"page_no":1}],"self_ref":"#/texts/74","text":"Highest monomial degree"},{"children":[],"content_layer":"body","label":"text","orig":"Principal Components","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":368.3333333333333,"coord_origin":"BOTTOMLEFT","l":375.0,"r":441.6666666666667,"t":377.6666666666667},"charspan":[0,20],"page_no":1}],"self_ref":"#/texts/75","text":"Principal Components"},{"children":[],"content_layer":"body","label":"text","orig":"Refinement Number","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":368.6666666666667,"coord_origin":"BOTTOMLEFT","l":487.6666666666667,"r":549.0,"t":376.6666666666667},"charspan":[0,17],"page_no":1}],"self_ref":"#/texts/76","text":"Refinement Number"},{"children":[],"content_layer":"body","label":"text","orig":"Time","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":563.066654393797,"coord_origin":"BOTTOMLEFT","l":247.3076875873578,"r":263.6923124126422,"t":573.6000122728697},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/77","text":"Time"},{"children":[],"content_layer":"body","label":"text","orig":"in the absence of additional information about the system. Indeed, under the translation φ = ω + 3 π 2 , it can be easily verified that the equations we discovered after applying the transformation (35) are consistent with (30) and (28). To discover the dynamic equations in the polar coordinate system, we applied a Savitzky-Golay filter [48] with a window size of 12 to compute the first and second derivatives of the φ . The candidate library consisted of monomials of φ , ˙ φ , cos φ and sin φ : Θ ∗ = { φ , ˙ φ , cos φ , sin φ , φ 2 , φ ˙ φ , . . . } . Using (35), we included x and y in the library instead of calculating cos φ and sin φ directly from φ . Similar to the algebraic finder step, we restricted the monomial degree to 3 for Case 1 and varied it between 2 and 5 for Case 2 for a comparative study. After using sparse regression, where sequential threshold with inner iterations consisting of LASSO regularization was applied, we used a curve fit package to determine the correct parameters. In both case 1 and case 2, simulated solutions based on the discovered equations were able to predict the test pixel data accurately (see supplementary Section 3 for details on discovered equations and parameter estimation).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":169.93877439292032,"coord_origin":"BOTTOMLEFT","l":56.693,"r":556.691994856,"t":288.3263673},"charspan":[0,1233],"page_no":1}],"self_ref":"#/texts/78","text":"in the absence of additional information about the system. Indeed, under the translation φ = ω + 3 π 2 , it can be easily verified that the equations we discovered after applying the transformation (35) are consistent with (30) and (28). To discover the dynamic equations in the polar coordinate system, we applied a Savitzky-Golay filter [48] with a window size of 12 to compute the first and second derivatives of the φ . The candidate library consisted of monomials of φ , ˙ φ , cos φ and sin φ : Θ ∗ = { φ , ˙ φ , cos φ , sin φ , φ 2 , φ ˙ φ , . . . } . Using (35), we included x and y in the library instead of calculating cos φ and sin φ directly from φ . Similar to the algebraic finder step, we restricted the monomial degree to 3 for Case 1 and varied it between 2 and 5 for Case 2 for a comparative study. After using sparse regression, where sequential threshold with inner iterations consisting of LASSO regularization was applied, we used a curve fit package to determine the correct parameters. In both case 1 and case 2, simulated solutions based on the discovered equations were able to predict the test pixel data accurately (see supplementary Section 3 for details on discovered equations and parameter estimation)."},{"children":[],"content_layer":"body","label":"text","orig":"For Case 3, SODAs robustly identified the constraints (33)-(34) from pixel data obtained from a single video segment, using various upper bounds on the degree of the monomial library. Note that the polar nature of the states ( x 2 , y 2 ) is not immediately evident from the pixel data of the secondary pendulum in the double-pendulum (Figure 4b right ). This is because the secondary pendulum does not have a fixed pivot and sweeps trajectory in the 2D plane that doesn't correspond to an identifiable pattern. Nevertheless, SODAs discovered an expanded version of (34). This algebraic discovery enables us to determine the transformation to the polar coordinate system: φ 1 = arctan y 1 x 1 and φ 2 = arctan y 1 -y 2 x 1 -x 2 , which can be further used for dynamic discovery. The dynamic discovery of equations governing the motion of the double pendulum similar to the form (31) -(32) based on polar coordinates, has been successfully demonstrated using SINDy-based methods [27]. We do not repeat this work here using our pixel data because it requires addressing noisy derivatives and may require advanced smoothing filters","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":61.71377439292041,"coord_origin":"BOTTOMLEFT","l":56.364,"r":556.5523272999991,"t":165.90665260000003},"charspan":[0,1128],"page_no":1}],"self_ref":"#/texts/79","text":"For Case 3, SODAs robustly identified the constraints (33)-(34) from pixel data obtained from a single video segment, using various upper bounds on the degree of the monomial library. Note that the polar nature of the states ( x 2 , y 2 ) is not immediately evident from the pixel data of the secondary pendulum in the double-pendulum (Figure 4b right ). This is because the secondary pendulum does not have a fixed pivot and sweeps trajectory in the 2D plane that doesn't correspond to an identifiable pattern. Nevertheless, SODAs discovered an expanded version of (34). This algebraic discovery enables us to determine the transformation to the polar coordinate system: φ 1 = arctan y 1 x 1 and φ 2 = arctan y 1 -y 2 x 1 -x 2 , which can be further used for dynamic discovery. The dynamic discovery of equations governing the motion of the double pendulum similar to the form (31) -(32) based on polar coordinates, has been successfully demonstrated using SINDy-based methods [27]. We do not repeat this work here using our pixel data because it requires addressing noisy derivatives and may require advanced smoothing filters"},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"15/29","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":31.94629120000002,"coord_origin":"BOTTOMLEFT","l":532.874,"r":555.3079328,"t":40.365740800000026},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/80","text":"15/29"}],"version":"1.10.0"}