250.94549999999998,"t":686.0172},"charspan":[0,31],"page_no":1}],"self_ref":"#/texts/4","text":"Laws of the federal Republic of"},{"children":[],"content_layer":"body","label":"text","orig":"Nigeria","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":663.6707235724743,"coord_origin":"BOTTOMLEFT","l":101.95793440702784,"r":135.72120000000012,"t":673.5172},"charspan":[0,7],"page_no":1}],"self_ref":"#/texts/5","text":"Nigeria"},{"children":[],"content_layer":"body","label":"text","orig":"35 Kingsway Road","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":650.1483235724743,"coord_origin":"BOTTOMLEFT","l":101.65793440702782,"r":188.49779999999998,"t":660.8172},"charspan":[0,16],"page_no":1}],"self_ref":"#/texts/6","text":"35 Kingsway Road"},{"children":[],"content_layer":"body","label":"text","orig":"Ikoyl","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":638.6483235724743,"coord_origin":"BOTTOMLEFT","l":101.45793440702784,"r":125.48669999999993,"t":648.3172},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/7","text":"Ikoyl"},{"children":[],"content_layer":"body","label":"text","orig":"Lagos","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":625.8817235724744,"coord_origin":"BOTTOMLEFT","l":101.15793440702782,"r":128.46080000000006,"t":635.6172},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/8","text":"Lagos"},{"children":[],"content_layer":"body","label":"text","orig":"Nigeria","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":613.5707235724743,"coord_origin":"BOTTOMLEFT","l":100.45793440702784,"r":133.02160000000003,"t":623.4172},"charspan":[0,7],"page_no":1}],"self_ref":"#/texts/9","text":"Nigeria"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"To the Defendant","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":539.7375235724743,"coord_origin":"BOTTOMLEFT","l":86.55793440702786,"r":167.7299,"t":550.2172},"charspan":[0,16],"page_no":1}],"self_ref":"#/texts/10","text":"To the Defendant"},{"children":[],"content_layer":"body","label":"text","orig":"You have not replied to the claim form","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":519.1817235724743,"coord_origin":"BOTTOMLEFT","l":86.45793440702784,"r":254.95559999999995,"t":531.7172},"charspan":[0,38],"page_no":1}],"self_ref":"#/texts/11","text":"You have not replied to the claim form"},{"children":[],"content_layer":"body","label":"text","orig":"It is therefore ordered that you must pay the claimant the balance in th ominated supreme court account (of $85,000,000 which at today's rate of exchange being 0.79 to one GBP converts to GBP equivalent of66,619,0$7.05 together with any interest which has accrued on that amount) and £10,185 for costs forthwith. ANDE","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":461.2761235724743,"coord_origin":"BOTTOMLEFT","l":85.35793440702781,"r":485.0056000000001,"t":520.3001771410552},"charspan":[0,317],"page_no":1}],"self_ref":"#/texts/12","text":"It is therefore ordered that you must pay the claimant the balance in th ominated supreme court account (of $85,000,000 which at today's rate of exchange being 0.79 to one GBP converts to GBP equivalent of66,619,0$7.05 together with any interest which has accrued on that amount) and £10,185 for costs forthwith. ANDE"},{"children":[],"content_layer":"body","label":"text","orig":"OF","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":594.0,"coord_origin":"BOTTOMLEFT","l":421.3333333333333,"r":435.3333333333333,"t":604.0},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/13","text":"OF"},{"children":[],"content_layer":"body","label":"text","orig":"1 5","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":551.3333333333333,"coord_origin":"BOTTOMLEFT","l":388.6666666666667,"r":402.0,"t":562.0},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/14","text":"1 5"},{"children":[],"content_layer":"body","label":"text","orig":"GQURT","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":596.7370485393334,"coord_origin":"BOTTOMLEFT","l":384.4740970786668,"r":421.1925695879999,"t":599.596284794},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/15","text":"GQURT"},{"children":[],"content_layer":"body","label":"text","orig":"If you ignore this order your goods may be removed and sold, or other enforcement proceedings may be taken against you. If this happens further costs will be added. If your circumstances change and you cannot pay, ask at the court office what you can do.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":408.4205235724744,"coord_origin":"BOTTOMLEFT","l":84.2579344070279,"r":487.2188,"t":446.0172},"charspan":[0,254],"page_no":1}],"self_ref":"#/texts/16","text":"If you ignore this order your goods may be removed and sold, or other enforcement proceedings may be taken against you. If this happens further costs will be added. If your circumstances change and you cannot pay, ask at the court office what you can do."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Notes for the defendant","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":389.88192357247436,"coord_origin":"BOTTOMLEFT","l":137.35793440702787,"r":245.77690000000007,"t":401.1172000000001},"charspan":[0,23],"page_no":1}],"self_ref":"#/texts/17","text":"Notes for the defendant"},{"children":[],"content_layer":"body","label":"text","orig":"If you did reply to the claim form and believe judgment has been entered wrongly in default, you may apply to the court office giving your reasons why the judgment should be set aside. An application form is available for you to use and you will need to pay a fee. A hearing may be arranged and you will be told when and where it will take place. If you live in, or your solicitor's business is in, another court's area, the claim may be transferred to that court.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":236.3095235724744,"coord_origin":"BOTTOMLEFT","l":97.45793440702789,"r":285.06230000000005,"t":386.4172},"charspan":[0,464],"page_no":1}],"self_ref":"#/texts/18","text":"If you did reply to the claim form and believe judgment has been entered wrongly in default, you may apply to the court office giving your reasons why the judgment should be set aside. An application form is available for you to use and you will need to pay a fee. A hearing may be arranged and you will be told when and where it will take place. If you live in, or your solicitor's business is in, another court's area, the claim may be transferred to that court."},{"children":[],"content_layer":"body","label":"text","orig":"you can ask the court to cancel the entry on the Register. You will need to give proof of payment. You can (for a fee) also obtain a Certificate of Cancellation from the court. If you pay the debt in full after one month you can ask the court to mark the entry on the Register as satisfied and (for a fee) obtain a Certificate of Satisfaction to prove that the debt has been paid.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":274.17612357247435,"coord_origin":"BOTTOMLEFT","l":307.6579344070279,"r":491.52570000000003,"t":397.51720000000006},"charspan":[0,380],"page_no":1}],"self_ref":"#/texts/19","text":"you can ask the court to cancel the entry on the Register. You will need to give proof of payment. You can (for a fee) also obtain a Certificate of Cancellation from the court. If you pay the debt in full after one month you can ask the court to mark the entry on the Register as satisfied and (for a fee) obtain a Certificate of Satisfaction to prove that the debt has been paid."},{"children":[],"content_layer":"body","label":"text","orig":"If the judgment is for £5,000 or more, or is in respect of a debt which attracts contractual or statutory interest for late payment, the claimant may be entitled to further interest.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":207.53172357247445,"coord_origin":"BOTTOMLEFT","l":306.4579344070279,"r":491.80230000000006,"t":268.4172000000001},"charspan":[0,182],"page_no":1}],"self_ref":"#/texts/20","text":"If the judgment is for £5,000 or more, or is in respect of a debt which attracts contractual or statutory interest for late payment, the claimant may be entitled to further interest."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"In the ADMIRALITY AND COMMERCIAL COITRT","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":746.3483235724743,"coord_origin":"BOTTOMLEFT","l":314.55793440702786,"r":493.8794,"t":780.7172000000002},"charspan":[0,39],"page_no":1}],"self_ref":"#/texts/21","text":"In the ADMIRALITY AND COMMERCIAL COITRT"},{"children":[],"content_layer":"body","label":"text","orig":"Claim No.","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":711.3761235724744,"coord_origin":"BOTTOMLEFT","l":313.6579344070278,"r":359.894,"t":721.5172000000001},"charspan":[0,9],"page_no":1}],"self_ref":"#/texts/22","text":"Claim No."},{"children":[],"content_layer":"body","label":"text","orig":"CL-2016-000631","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":709.7817235724742,"coord_origin":"BOTTOMLEFT","l":382.4579344070278,"r":455.5444,"t":720.4172000000001},"charspan":[0,14],"page_no":1}],"self_ref":"#/texts/23","text":"CL-2016-000631"},{"children":[],"content_layer":"body","label":"text","orig":"Claimant (including ref.)","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":663.9319235724746,"coord_origin":"BOTTOMLEFT","l":312.1579344070278,"r":356.82010000000014,"t":698.4172000000001},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/24","text":"Claimant (including ref.)"},{"children":[],"content_layer":"body","label":"text","orig":"The federal Republic of Nigeria","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":662.9707235724744,"coord_origin":"BOTTOMLEFT","l":381.5579344070278,"r":487.5954,"t":685.3172000000001},"charspan":[0,31],"page_no":1}],"self_ref":"#/texts/25","text":"The federal Republic of Nigeria"},{"children":[],"content_layer":"body","label":"text","orig":"Defendant (including ref.)","parent":{"$ref":"#/pic