l_offset_idx":5,"end_row_offset_idx":6,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":4,"start_row_offset_idx":5,"text":"z ( z +3) 4"}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":554.9017944335938,"coord_origin":"BOTTOMLEFT","l":132.9702911376953,"r":496.59295654296875,"t":677.9436340332031},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"body","label":"caption","orig":"Table 1: Newton maps N z 4 p ( z ) with an exceptional point","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":525.8827262893371,"coord_origin":"BOTTOMLEFT","l":174.513,"r":455.49072928000004,"t":543.0234015999999},"charspan":[0,60],"page_no":1}],"self_ref":"#/texts/0","text":"Table 1: Newton maps N z 4 p ( z ) with an exceptional point"},{"children":[],"content_layer":"body","enumerated":true,"label":"list_item","marker":"1.","orig":"1. Let p be generic. If p is linear, then it follows from the Scaling property that N R ( z ) is conjugate to N z z -1 .","parent":{"$ref":"#/groups/0"},"prov":[{"bbox":{"b":475.6207262893372,"coord_origin":"BOTTOMLEFT","l":104.30699999999993,"r":540.00054016,"t":504.2914016},"charspan":[0,120],"page_no":1}],"self_ref":"#/texts/1","text":"Let p be generic. If p is linear, then it follows from the Scaling property that N R ( z ) is conjugate to N z z -1 ."},{"children":[],"content_layer":"body","label":"text","orig":"Let p be non-linear. As p is generic and N z d p ( z ) is a polynomial, we have zp ′ ( z ) -dp ( z ) = α for some non-zero α . Letting y = p ( z ), we have the first-order linear differential equation y ′ -d z y = α z . The solution is","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":421.9263080832853,"coord_origin":"BOTTOMLEFT","l":119.265,"r":539.99975456,"t":471.3885783},"charspan":[0,235],"page_no":1}],"self_ref":"#/texts/2","text":"Let p be non-linear. As p is generic and N z d p ( z ) is a polynomial, we have zp ′ ( z ) -dp ( z ) = α for some non-zero α . Letting y = p ( z ), we have the first-order linear differential equation y ′ -d z y = α z . The solution is"},{"children":[],"content_layer":"body","label":"formula","orig":"y · 1 z d = ∫ α z · 1 z d dz + β = -α dz d + β,","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":388.07545257867434,"coord_origin":"BOTTOMLEFT","l":228.414,"r":420.88318496000005,"t":415.309208},"charspan":[0,47],"page_no":1}],"self_ref":"#/texts/3","text":""},{"children":[],"content_layer":"body","label":"text","orig":"for an arbitrary constant β . Therefore, p ( z ) = βz d -α d and R ( z ) = z d βz d -α d . Consider c such that c d = α dβ and use the Scaling property to see that N R is conjugate to N βR ( cz ) . We are done since βR ( cz ) = z d z d -1 and the resulting Newton map is z d +1 +( d -1) z d .","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":307.2103080832853,"coord_origin":"BOTTOMLEFT","l":119.26499999999999,"r":540.00308256,"t":379.5787008},"charspan":[0,292],"page_no":1}],"self_ref":"#/texts/4","text":"for an arbitrary constant β . Therefore, p ( z ) = βz d -α d and R ( z ) = z d βz d -α d . Consider c such that c d = α dβ and use the Scaling property to see that N R is conjugate to N βR ( cz ) . We are done since βR ( cz ) = z d z d -1 and the resulting Newton map is z d +1 +( d -1) z d ."},{"children":[],"content_layer":"body","enumerated":true,"label":"list_item","marker":"2.","orig":"2. Let n denote the number of distinct roots of p . Using the Scaling property, we assume without loss of generality that 1 is a multiple root of p whenever p is not generic. Along with this, what is going to be repeatedly used in all the following cases is that g ( z ) is a non-zero constant (see Equation (3.1)).","parent":{"$ref":"#/groups/1"},"prov":[{"bbox":{"b":244.06445257867426,"coord_origin":"BOTTOMLEFT","l":104.30699999999999,"r":539.9961747199999,"t":297.8504016},"charspan":[0,315],"page_no":1}],"self_ref":"#/texts/5","text":"Let n denote the number of distinct roots of p . Using the Scaling property, we assume without loss of generality that 1 is a multiple root of p whenever p is not generic. Along with this, what is going to be repeatedly used in all the following cases is that g ( z ) is a non-zero constant (see Equation (3.1))."},{"children":[],"content_layer":"body","label":"text","orig":"̸","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":177.72788278613336,"coord_origin":"BOTTOMLEFT","l":442.31100000000004,"r":442.31100000000004,"t":188.00540160000003},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/6","text":"̸"},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"(a) Let deg( p ) = 3. Then there are three cases depending on the values of n . If n = 3, then p is generic, and from the first part of this theorem, it follows that p ( z ) = z 3 -1, and hence N R ( z ) = 1 3 z ( z 3 +2). If n = 2, then p has a root with multiplicity 2 and therefore p ( z ) = ( z -1) 2 ( z -a ), where a = 0 , 1. In this case, g ( z ) = -( a +2) z +3 a and therefore a = -2. Thus, N R ( z ) = z 6 ( z 2 + z +4). If n = 1, then p ( z ) = ( z -1) 3 , and we get N R ( z ) = 1 3 z ( z +2).","parent":{"$ref":"#/groups/2"},"prov":[{"bbox":{"b":145.30430808328526,"coord_origin":"BOTTOMLEFT","l":124.20699999999991,"r":540.0041318399999,"t":231.3424015999999},"charspan":[0,505],"page_no":1}],"self_ref":"#/texts/7","text":"(a) Let deg( p ) = 3. Then there are three cases depending on the values of n . If n = 3, then p is generic, and from the first part of this theorem, it follows that p ( z ) = z 3 -1, and hence N R ( z ) = 1 3 z ( z 3 +2). If n = 2, then p has a root with multiplicity 2 and therefore p ( z ) = ( z -1) 2 ( z -a ), where a = 0 , 1. In this case, g ( z ) = -( a +2) z +3 a and therefore a = -2. Thus, N R ( z ) = z 6 ( z 2 + z +4). If n = 1, then p ( z ) = ( z -1) 3 , and we get N R ( z ) = 1 3 z ( z +2)."},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"(b) Let deg( p ) = 4. All possible cases of p and the resulting Newton maps are given in Table 1.","parent":{"$ref":"#/groups/2"},"prov":[{"bbox":{"b":116.03145257867436,"coord_origin":"BOTTOMLEFT","l":123.55700000000002,"r":540.0039500800001,"t":140.9244016},"charspan":[0,97],"page_no":1}],"self_ref":"#/texts/8","text":"(b) Let deg( p ) = 4. All possible cases of p and the resulting Newton maps are given in Table 1."},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"(c) For deg( p ) = 5, all the possible forms of p and resulting Newton maps are given in Table 2.","parent":{"$ref":"#/groups/2"},"prov":[{"bbox":{"b":83.39645257867437,"coord_origin":"BOTTOMLEFT","l":124.85800000000003,"r":540.0029756800002,"t":108.2904016},"charspan":[0,97],"page_no":1}],"self_ref":"#/texts/9","text":"(c) For deg( p ) = 5, all the possible forms of p and resulting Newton maps are given in Table 2."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"10","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":29.39645257867437,"coord_origin":"BOTTOMLEFT","l":309.14700000000005,"r":320.8535318400001,"t":39.84440159999997},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/10","text":"10"}],"version":"1.10.0"}