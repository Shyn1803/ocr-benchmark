2],"page_no":1}],"self_ref":"#/texts/32","text":"ST"},{"children":[],"content_layer":"body","label":"text","orig":"SW","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":585.9941914967533,"coord_origin":"BOTTOMLEFT","l":490.8066,"r":498.22082475,"t":590.27966325},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/33","text":"SW"},{"children":[],"content_layer":"body","label":"text","orig":"data1","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":580.3691914967533,"coord_origin":"BOTTOMLEFT","l":490.8066,"r":502.3214295,"t":584.65466325},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/34","text":"data1"},{"children":[],"content_layer":"body","label":"text","orig":"(b) DVHs","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":481.0830153663717,"coord_origin":"BOTTOMLEFT","l":409.606,"r":440.93646309999997,"t":487.9245351},"charspan":[0,8],"page_no":1}],"self_ref":"#/texts/35","text":"(b) DVHs"},{"children":[],"content_layer":"body","label":"caption","orig":"Figure 3 Clinical results","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":462.5092912,"coord_origin":"BOTTOMLEFT","l":72.0,"r":186.8057856,"t":470.92874079999996},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/36","text":"Figure 3 Clinical results"},{"children":[],"content_layer":"body","label":"text","orig":"Figure 3b shows that doses among the various body structures are inhomogeneous. Specifically, the left side of the tumor surface receives higher doses compared to its right side, and there is a noticeable difference in the amount of radiation received by the boundary voxels on the left and right side of the nose. Further, the skin tissues exhibit long tails in their DVHs and most voxels on the left side of the tumor are exposed to a high dose.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":334.30351267964596,"coord_origin":"BOTTOMLEFT","l":72.0,"r":539.9982592000002,"t":427.1218352},"charspan":[0,447],"page_no":1}],"self_ref":"#/texts/37","text":"Figure 3b shows that doses among the various body structures are inhomogeneous. Specifically, the left side of the tumor surface receives higher doses compared to its right side, and there is a noticeable difference in the amount of radiation received by the boundary voxels on the left and right side of the nose. Further, the skin tissues exhibit long tails in their DVHs and most voxels on the left side of the tumor are exposed to a high dose."},{"children":[],"content_layer":"body","label":"text","orig":"In the following section, we will compare the characteristics of this clinical plan with those obtained with the approaches we propose. To make the comparison easier, we normalize the treatment plans by uniformly scaling their dwell times so that their RB V 100 are approximately the same. In this process, RB V 100 describes the volume of target tissue RB that receives 100% of the prescribed radiation dose. The maximum normalization error is 0 . 001 %. This normalization error is calculated as ∣ ∣ ∣ RB 1 V 100 -RB 2 V 100 ∣ ∣ ∣ / max ( RB 1 V 100 , RB 2 V 100 ) ∗ 100 , where RB 1 V 100 and RB 2 V 100 are the dosimetric values, after normalization, for the two treatment plans compared.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":189.82851267964588,"coord_origin":"BOTTOMLEFT","l":71.99999999999989,"r":540.0062128000001,"t":323.9258352},"charspan":[0,692],"page_no":1}],"self_ref":"#/texts/38","text":"In the following section, we will compare the characteristics of this clinical plan with those obtained with the approaches we propose. To make the comparison easier, we normalize the treatment plans by uniformly scaling their dwell times so that their RB V 100 are approximately the same. In this process, RB V 100 describes the volume of target tissue RB that receives 100% of the prescribed radiation dose. The maximum normalization error is 0 . 001 %. This normalization error is calculated as ∣ ∣ ∣ RB 1 V 100 -RB 2 V 100 ∣ ∣ ∣ / max ( RB 1 V 100 , RB 2 V 100 ) ∗ 100 , where RB 1 V 100 and RB 2 V 100 are the dosimetric values, after normalization, for the two treatment plans compared."},{"children":[],"content_layer":"body","label":"text","orig":"In our models, we consider the five exiting planes shown in Figure 1b. To avoid negative bounds on some of the variables, which can affect the quality of relaxations of bilinear terms, we translate all of the body structures by the same vector, so that they all belong to the positive orthant. Then, all needle reference points can be chosen among the faces of the box [1 , 173] × [1 , 60] × [95 , 200] .","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":107.27251267964596,"coord_origin":"BOTTOMLEFT","l":71.99999999999989,"r":539.9982592,"t":179.4518351999999},"charspan":[0,404],"page_no":1}],"self_ref":"#/texts/39","text":"In our models, we consider the five exiting planes shown in Figure 1b. To avoid negative bounds on some of the variables, which can affect the quality of relaxations of bilinear terms, we translate all of the body structures by the same vector, so that they all belong to the positive orthant. Then, all needle reference points can be chosen among the faces of the box [1 , 173] × [1 , 60] × [95 , 200] ."},{"children":[],"content_layer":"body","label":"text","orig":"For all optimization models that require dose computation, we use piecewise-linear penalty function f c i ( s ) = max {-5000 s, 0 , 5000( s -3) } with δ i =6 for each voxel i in a tumor region. We use","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":63.99630808328516,"coord_origin":"BOTTOMLEFT","l":71.99999999999982,"r":540.0055439999998,"t":96.89483519999987},"charspan":[0,200],"page_no":1}],"self_ref":"#/texts/40","text":"For all optimization models that require dose computation, we use piecewise-linear penalty function f c i ( s ) = max {-5000 s, 0 , 5000( s -3) } with δ i =6 for each voxel i in a tumor region. We use"}],"version":"1.10.0"}