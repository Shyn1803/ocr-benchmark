T","l":126.66666666666667,"r":134.66666666666669,"t":614.2233479817708},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/29","text":"2"},{"children":[],"content_layer":"body","label":"text","orig":"6","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":605.8900146484375,"coord_origin":"BOTTOMLEFT","l":185.66666666666669,"r":192.33333333333334,"t":613.8900146484375},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/30","text":"6"},{"children":[],"content_layer":"body","label":"text","orig":"8","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":605.8900146484375,"coord_origin":"BOTTOMLEFT","l":214.33333333333334,"r":221.0,"t":613.8900146484375},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/31","text":"8"},{"children":[],"content_layer":"body","label":"text","orig":"10","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":604.8900146484375,"coord_origin":"BOTTOMLEFT","l":242.0,"r":253.33333333333334,"t":614.2233479817708},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/32","text":"10"},{"children":[],"content_layer":"body","label":"text","orig":"12","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":605.5566813151041,"coord_origin":"BOTTOMLEFT","l":270.66666666666663,"r":282.0,"t":614.2233479817708},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/33","text":"12"},{"children":[],"content_layer":"body","label":"text","orig":"6","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":606.5566813151041,"coord_origin":"BOTTOMLEFT","l":411.0,"r":417.6666666666667,"t":613.8900146484375},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/34","text":"6"},{"children":[],"content_layer":"body","label":"text","orig":"8","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":605.8900146484375,"coord_origin":"BOTTOMLEFT","l":440.3333333333333,"r":447.0,"t":613.8900146484375},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/35","text":"8"},{"children":[],"content_layer":"body","label":"text","orig":"10","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":605.5566813151041,"coord_origin":"BOTTOMLEFT","l":467.3333333333333,"r":478.6666666666667,"t":614.2233479817708},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/36","text":"10"},{"children":[],"content_layer":"body","label":"text","orig":"12","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":604.8900146484375,"coord_origin":"BOTTOMLEFT","l":496.6666666666667,"r":508.0,"t":614.2233479817708},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/37","text":"12"},{"children":[],"content_layer":"body","label":"text","orig":"r(mm)","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":594.8900146484375,"coord_origin":"BOTTOMLEFT","l":175.33333333333331,"r":202.0,"t":604.8900146484375},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/38","text":"r(mm)"},{"children":[],"content_layer":"body","label":"text","orig":"r(mm)","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":595.5566813151041,"coord_origin":"BOTTOMLEFT","l":400.6666666666667,"r":427.3333333333333,"t":604.8900146484375},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/39","text":"r(mm)"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"5.3 SIF","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":457.64885184843735,"coord_origin":"BOTTOMLEFT","l":71.99999999999994,"r":132.42906363999995,"t":470.3308926484374},"charspan":[0,7],"page_no":1}],"self_ref":"#/texts/40","text":"5.3 SIF"},{"children":[],"content_layer":"body","label":"text","orig":"For the current problem, we do not have an asymptotic or analytical solution. Therefore, an explicit description of crack-tip SIF is not available. However, one can utilize the crack-tip SIF defined for the linear elastic fracture mechanics model and use the finite element solution for the nonlinear model to glean some vital physical insight into SIF.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":397.07464924843737,"coord_origin":"BOTTOMLEFT","l":71.99999999999994,"r":523.2789215199994,"t":447.3553845484373},"charspan":[0,353],"page_no":1}],"self_ref":"#/texts/41","text":"For the current problem, we do not have an asymptotic or analytical solution. Therefore, an explicit description of crack-tip SIF is not available. However, one can utilize the crack-tip SIF defined for the linear elastic fracture mechanics model and use the finite element solution for the nonlinear model to glean some vital physical insight into SIF."},{"children":[],"content_layer":"body","label":"text","orig":"The SIF K I in the context of linear elasticity defined as","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":368.88232273172264,"coord_origin":"BOTTOMLEFT","l":89.55899999999994,"r":355.5068983899998,"t":379.60938454843733},"charspan":[0,58],"page_no":1}],"self_ref":"#/texts/42","text":"The SIF K I in the context of linear elasticity defined as"},{"children":[],"content_layer":"body","label":"formula","orig":"K I = lim r → 0 + √ 2 πrT 22 . (33)","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":338.1563227317227,"coord_origin":"BOTTOMLEFT","l":248.62799999999993,"r":523.2772888000001,"t":364.5919299484374},"charspan":[0,35],"page_no":1}],"self_ref":"#/texts/43","text":""},{"children":[],"content_layer":"body","label":"text","orig":"It is challenging to analytically compute K I for complicated models such as the ones in 3-D that we are investigating in this paper. We compute K I numerically for illustrative purposes to understand its value as a function of the nonlinear modeling parameter β . The function √ 2 πrT 22 vs. r is shown in Fig. 7. For β = 0 , -10 , -20 , -30 , the K I values are, respectively, 0.0110, 0.0185, 0.0251, 0.0178; For β = 0 , 10 , 20 , 30 , the K I values are, respectively, 0.0110, 0.0060, 0.0037, 0.0026 (Unit: 10 4 mm 1 / 2 Pa). All the K I values are very close, implying an identical theoretical K I value for all β is highly likely. Such numerical approximation for K I shows that the nonlinear model with density-dependent moduli is designed appropriately under the common crack criteria used for the linear-elasticity fracture model. Also, in the two panels of Fig. 7, the curve shapes for β < 0 and β > 0 are slightly distinct. The β < 0 curves show a greater curvature, while those for β > 0 show flatter behaviors. Such difference is caused by the sign of β , disclosing how negative and positive β values impact the SIF differently.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":167.96164924843742,"coord_origin":"BOTTOMLEFT","l":71.99999999999986,"r":523.2821942499995,"t":326.6353845484375},"charspan":[0,1141],"page_no":1}],"self_ref":"#/texts/44","text":"It is challenging to analytically compute K I for complicated models such as the ones in 3-D that we are investigating in this paper. We compute K I numerically for illustrative purposes to understand its value as a function of the nonlinear modeling parameter β . The function √ 2 πrT 22 vs. r is shown in Fig. 7. For β = 0 , -10 , -20 , -30 , the K I values are, respectively, 0.0110, 0.0185, 0.0251, 0.0178; For β = 0 , 10 , 20 , 30 , the K I values are, respectively, 0.0110, 0.0060, 0.0037, 0.0026 (Unit: 10 4 mm 1 / 2 Pa). All the K I values are very close, implying an identical theoretical K I value for all β is highly likely. Such numerical approximation for K I shows that the nonlinear model with density-dependent moduli is designed appropriately under the common crack criteria used for the linear-elasticity fracture model. Also, in the two panels of Fig. 7, the curve shapes for β < 0 and β > 0 are slightly distinct. The β < 0 curves show a greater curvature, while those for β > 0 show flatter behaviors. Such difference is caused by the sign of β , disclosing how negative and positive β values impact the SIF differently."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"14","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":39.792705848437436,"coord_origin":"BOTTOMLEFT","l":291.78599999999983,"r":303.49014079999984,"t":50.34914744843741},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/45","text":"14"}],"version":"1.10.0"}