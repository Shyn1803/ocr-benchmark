#/texts/0","text":"52"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"Regulations and General Information","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":557.0472303534171,"coord_origin":"BOTTOMLEFT","l":51.0236,"r":159.1512,"t":563.2269009765625},"charspan":[0,35],"page_no":1}],"self_ref":"#/texts/1","text":"Regulations and General Information"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"(e) College Entertainments","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":517.6290646396379,"coord_origin":"BOTTOMLEFT","l":51.024,"r":168.50999500000006,"t":527.3150009765625},"charspan":[0,26],"page_no":1}],"self_ref":"#/texts/2","text":"(e) College Entertainments"},{"children":[],"content_layer":"body","label":"text","orig":"No charge may be made for admission to any party or entertainment in College or a hostel, nor may drinks be sold without permission.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":493.2403671885248,"coord_origin":"BOTTOMLEFT","l":51.024,"r":369.097014,"t":513.3620009765625},"charspan":[0,132],"page_no":1}],"self_ref":"#/texts/3","text":"No charge may be made for admission to any party or entertainment in College or a hostel, nor may drinks be sold without permission."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"(f) Meals for special diets","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":468.09006463963794,"coord_origin":"BOTTOMLEFT","l":51.023999999999994,"r":161.61299500000004,"t":477.77600097656256},"charspan":[0,27],"page_no":1}],"self_ref":"#/texts/4","text":"(f) Meals for special diets"},{"children":[],"content_layer":"body","label":"text","orig":"The Catering Department takes all dietary requirements seriously. If you have unique dietary requirements we suggest that you get in touch with the Head of Catering at catering@trin.cam.ac.uk.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":431.6723671885248,"coord_origin":"BOTTOMLEFT","l":51.024,"r":365.452014,"t":463.8230009765626},"charspan":[0,192],"page_no":1}],"self_ref":"#/texts/5","text":"The Catering Department takes all dietary requirements seriously. If you have unique dietary requirements we suggest that you get in touch with the Head of Catering at catering@trin.cam.ac.uk."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"46. kitchen fixed charge (kfc)","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":393.83065973027175,"coord_origin":"BOTTOMLEFT","l":51.024,"r":248.7940059999999,"t":406.19000097656254},"charspan":[0,30],"page_no":1}],"self_ref":"#/texts/6","text":"46. kitchen fixed charge (kfc)"},{"children":[],"content_layer":"body","label":"text","orig":"Unless there is a pressing medical or cultural (e.g. religious) reason why you can never take meals in Hall, a matter which you should discuss with your T utor, you must, if you are an undergraduate, pay a contribution towards the overhead costs of catering. The charge in 2023-24 is  £ 228.80 per term and will be added to the College's termly bill. Postgraduate students do not have to pay this charge but are charged more than undergraduates for individual dinners and lunches taken. Such students may find it advantageous to elect to pay the KFC and take meals during that term at the undergraduate price.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":287.38236718852477,"coord_origin":"BOTTOMLEFT","l":51.023999999999944,"r":365.725,"t":379.6780009765626},"charspan":[0,609],"page_no":1}],"self_ref":"#/texts/7","text":"Unless there is a pressing medical or cultural (e.g. religious) reason why you can never take meals in Hall, a matter which you should discuss with your T utor, you must, if you are an undergraduate, pay a contribution towards the overhead costs of catering. The charge in 2023-24 is  £ 228.80 per term and will be added to the College's termly bill. Postgraduate students do not have to pay this charge but are charged more than undergraduates for individual dinners and lunches taken. Such students may find it advantageous to elect to pay the KFC and take meals during that term at the undergraduate price."},{"children":[],"content_layer":"body","label":"text","orig":"Kitchen Fixed Charge opt-out: students who are granted an exceptional dispensation may take the occasional special meal in Hall, but will be charged at a higher (graduate) level.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":239.26636718852478,"coord_origin":"BOTTOMLEFT","l":51.024,"r":362.80500000000006,"t":271.4170009765626},"charspan":[0,178],"page_no":1}],"self_ref":"#/texts/8","text":"Kitchen Fixed Charge opt-out: students who are granted an exceptional dispensation may take the occasional special meal in Hall, but will be charged at a higher (graduate) level."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"47. price of meals","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":201.42465973027174,"coord_origin":"BOTTOMLEFT","l":51.024,"r":166.286,"t":213.78400097656254},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/9","text":"47. price of meals"},{"children":[],"content_layer":"body","label":"text","orig":"Food items are charged individually; however, the approximate costs for meals in Hall are currently as follows:","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":167.1503671885248,"coord_origin":"BOTTOMLEFT","l":51.024,"r":367.1630000000002,"t":187.2720009765626},"charspan":[0,111],"page_no":1}],"self_ref":"#/texts/10","text":"Food items are charged individually; however, the approximate costs for meals in Hall are currently as follows:"},{"children":[],"content_layer":"body","label":"text","orig":"Payments can be made with your University card and credit or debit cards.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":38.07514490961694,"coord_origin":"BOTTOMLEFT","l":51.0236,"r":214.3602,"t":56.00460097656253},"charspan":[0,73],"page_no":1}],"self_ref":"#/texts/11","text":"Payments can be made with your University card and credit or debit cards."},{"children":[],"content_layer":"body","label":"text","orig":"H = Host and G = Guest","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":48.23033025253312,"coord_origin":"BOTTOMLEFT","l":295.1379,"r":368.50489999999996,"t":54.52460097656251},"charspan":[0,22],"page_no":1}],"self_ref":"#/texts/12","text":"H = Host and G = Guest"},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"return to contents","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":19.943700086354852,"coord_origin":"BOTTOMLEFT","l":163.5995,"r":255.9285000000001,"t":28.77180097656253},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/13","text":"return to contents"}],"version":"1.10.0"}