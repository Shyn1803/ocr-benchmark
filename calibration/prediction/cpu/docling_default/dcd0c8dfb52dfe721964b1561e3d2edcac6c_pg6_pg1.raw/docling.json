age_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"furniture","label":"page_header","orig":"Marine Microbial Biodiversity, Bioinformatics and Biotechnology","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":792.2003,"coord_origin":"BOTTOMLEFT","l":72.0,"r":384.19559999999973,"t":804.2003},"charspan":[0,63],"page_no":1}],"self_ref":"#/texts/0","text":"Marine Microbial Biodiversity, Bioinformatics and Biotechnology"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"Deliverable Nr 3.7: Tara Oceans data included in the oceanographic data infrastructure,","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":777.5603,"coord_origin":"BOTTOMLEFT","l":71.99999999999994,"r":497.2427999999998,"t":789.5603},"charspan":[0,87],"page_no":1}],"self_ref":"#/texts/1","text":"Deliverable Nr 3.7: Tara Oceans data included in the oceanographic data infrastructure,"},{"children":[],"content_layer":"body","label":"text","orig":"16.01.2015","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":762.9203,"coord_origin":"BOTTOMLEFT","l":71.99999999999977,"r":126.67679999999977,"t":774.9203},"charspan":[0,10],"page_no":1}],"self_ref":"#/texts/2","text":"16.01.2015"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"(3) Properties of seawater and particulate & dissolved matter from discrete water samples","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":728.824964,"coord_origin":"BOTTOMLEFT","l":72.0,"r":509.66067599999997,"t":759.9053},"charspan":[0,89],"page_no":1}],"self_ref":"#/texts/3","text":"(3) Properties of seawater and particulate & dissolved matter from discrete water samples"},{"children":[],"content_layer":"body","label":"text","orig":"In addition to sensors mounted on the Rosette Vertical Sampling System, seawater was collected using Niskin bottles (6 x 8 -L Niskins and 4 x 12 -L Niskins) in order to further characterise environmental conditions in the ecosystem under study. Measurements include pigment concentrations from HPLC analysis (10 depths per vertical profile; 25 pigments per depth), the carbonate system (Surface and 400m; pHT, CO2, pCO2, fCO2, HCO3, CO3, Total alkalinity, Total carbon, OmegaAragonite, OmegaCalcite, and quality Flag), nutrients (10 depths per vertical profile; NO2, PO4, N02/NO3, SI, quality Flags), DOC, CDOM, and dissolved oxygen isotopes. More than 200 vertical profiles of these properties were made across the world ocean. DOC, CDOM and dissolved oxygen isotopes are available only for the Arctic Ocean and Arctic Seas (2013 campaigns). Tara Oceans Data corresponding to these parameters are published in open access at PANGAEA. At PANGAEA, vertical profiles are packaged into 201 citable data publications, i.e. one per sampling station. At SeaDataNet, each vertical profile is accessed separately and referenced by a distinct Common Data Index (CDI) record.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":517.6403,"coord_origin":"BOTTOMLEFT","l":71.99999999999994,"r":523.3944,"t":720.0803},"charspan":[0,1165],"page_no":1}],"self_ref":"#/texts/4","text":"In addition to sensors mounted on the Rosette Vertical Sampling System, seawater was collected using Niskin bottles (6 x 8 -L Niskins and 4 x 12 -L Niskins) in order to further characterise environmental conditions in the ecosystem under study. Measurements include pigment concentrations from HPLC analysis (10 depths per vertical profile; 25 pigments per depth), the carbonate system (Surface and 400m; pHT, CO2, pCO2, fCO2, HCO3, CO3, Total alkalinity, Total carbon, OmegaAragonite, OmegaCalcite, and quality Flag), nutrients (10 depths per vertical profile; NO2, PO4, N02/NO3, SI, quality Flags), DOC, CDOM, and dissolved oxygen isotopes. More than 200 vertical profiles of these properties were made across the world ocean. DOC, CDOM and dissolved oxygen isotopes are available only for the Arctic Ocean and Arctic Seas (2013 campaigns). Tara Oceans Data corresponding to these parameters are published in open access at PANGAEA. At PANGAEA, vertical profiles are packaged into 201 citable data publications, i.e. one per sampling station. At SeaDataNet, each vertical profile is accessed separately and referenced by a distinct Common Data Index (CDI) record."},{"children":[],"content_layer":"body","label":"text","orig":"Link to the corresponding data sets published at PANGAEA","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":497.00030000000004,"coord_origin":"BOTTOMLEFT","l":72.00000000000011,"r":357.12960000000004,"t":509.00030000000004},"charspan":[0,56],"page_no":1}],"self_ref":"#/texts/5","text":"Link to the corresponding data sets published at PANGAEA"},{"children":[],"content_layer":"body","label":"text","orig":"Link to a map of the corresponding data sets published at PANGAEA","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":476.3603,"coord_origin":"BOTTOMLEFT","l":72.0,"r":402.6695999999999,"t":488.3603},"charspan":[0,65],"page_no":1}],"self_ref":"#/texts/6","text":"Link to a map of the corresponding data sets published at PANGAEA"},{"children":[],"content_layer":"body","label":"text","orig":"Link to download all corresponding data compiled in a single file (NetCDF format) archived at PANGAEA (http://doi.pangaea.de/10.1594/PANGAEA.836319)","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":441.0803,"coord_origin":"BOTTOMLEFT","l":72.0,"r":523.404,"t":467.7203},"charspan":[0,148],"page_no":1}],"self_ref":"#/texts/7","text":"Link to download all corresponding data compiled in a single file (NetCDF format) archived at PANGAEA (http://doi.pangaea.de/10.1594/PANGAEA.836319)"},{"children":[],"content_layer":"body","label":"caption","orig":"Table 3. List of parameters disseminated to the SeaDataNet network, regarding properties of seawater and dissolved matter from discrete water samples.","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":405.74030000000005,"coord_origin":"BOTTOMLEFT","l":72.0,"r":523.3464000000004,"t":432.38030000000003},"charspan":[0,150],"page_no":1}],"self_ref":"#/texts/8","text":"Table 3. List of parameters disseminated to the SeaDataNet network, regarding properties of seawater and dissolved matter from discrete water samples."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"6","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":42.59630000000004,"coord_origin":"BOTTOMLEFT","l":294.2999999999997,"r":303.60359999999974,"t":56.66030000000001},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/9","text":"6"}],"version":"1.10.0"}