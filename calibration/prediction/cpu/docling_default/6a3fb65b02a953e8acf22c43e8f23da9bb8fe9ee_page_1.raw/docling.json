MLEFT","l":396.81600952,"r":551.5520095199996,"t":755.69999985},"charspan":[0,43],"page_no":1}],"self_ref":"#/texts/0","text":"Certificate in Gender and Sexuality Studies"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"1","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":748.29999985,"coord_origin":"BOTTOMLEFT","l":571.55200195,"r":576.00000195,"t":755.69999985},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/1","text":"1"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Certificate in Gender and Sexuality Studies","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":673.82500162,"coord_origin":"BOTTOMLEFT","l":36.0,"r":297.6240000000001,"t":718.17499971},"charspan":[0,43],"page_no":1}],"self_ref":"#/texts/2","text":"Certificate in Gender and Sexuality Studies"},{"children":[],"content_layer":"body","label":"text","orig":"The Gender and Sexuality Studies certificate program allows students to examine how gender and sexuality as social constructs shape individual lives, groups, institutions, and social structures. Students will have the opportunity to examine individual development, couples, families, small groups, and organizations as well as the media, arts, and economic and political systems. The courses explore how gender and sexuality intersect with race, culture, ethnicity, and social class in the interest of social justice.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":573.75000586,"coord_origin":"BOTTOMLEFT","l":36.0,"r":292.11199988000004,"t":658.1499982299999},"charspan":[0,517],"page_no":1}],"self_ref":"#/texts/3","text":"The Gender and Sexuality Studies certificate program allows students to examine how gender and sexuality as social constructs shape individual lives, groups, institutions, and social structures. Students will have the opportunity to examine individual development, couples, families, small groups, and organizations as well as the media, arts, and economic and political systems. The courses explore how gender and sexuality intersect with race, culture, ethnicity, and social class in the interest of social justice."},{"children":[],"content_layer":"body","label":"text","orig":"Certificates may be earned by regularly matriculated or extended learning students and denote successful completion of a prescribed program of study designed to:","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":532.75000586,"coord_origin":"BOTTOMLEFT","l":36.0,"r":296.10400000000004,"t":562.15000586},"charspan":[0,161],"page_no":1}],"self_ref":"#/texts/4","text":"Certificates may be earned by regularly matriculated or extended learning students and denote successful completion of a prescribed program of study designed to:"},{"children":[],"content_layer":"body","enumerated":true,"label":"list_item","marker":"1.","orig":"1. impart specified professional/vocational/career competencies; or","parent":{"$ref":"#/groups/0"},"prov":[{"bbox":{"b":513.75000586,"coord_origin":"BOTTOMLEFT","l":39.32800007,"r":277.64000000000004,"t":521.15000586},"charspan":[0,67],"page_no":1}],"self_ref":"#/texts/5","text":"impart specified professional/vocational/career competencies; or"},{"children":[],"content_layer":"body","enumerated":true,"label":"list_item","marker":"2.","orig":"2. produce mastery of the content of a sub-field of an academic major (discipline); or","parent":{"$ref":"#/groups/0"},"prov":[{"bbox":{"b":489.75000586,"coord_origin":"BOTTOMLEFT","l":39.32800007,"r":287.00000000000006,"t":508.15000585999996},"charspan":[0,86],"page_no":1}],"self_ref":"#/texts/6","text":"produce mastery of the content of a sub-field of an academic major (discipline); or"},{"children":[],"content_layer":"body","enumerated":true,"label":"list_item","marker":"3.","orig":"3. provide exposure to the range of materials in a traditional or emerging interdisciplinary field.","parent":{"$ref":"#/groups/0"},"prov":[{"bbox":{"b":465.75000586,"coord_origin":"BOTTOMLEFT","l":39.32800007,"r":296.77600000000007,"t":484.15000585999996},"charspan":[0,99],"page_no":1}],"self_ref":"#/texts/7","text":"provide exposure to the range of materials in a traditional or emerging interdisciplinary field."},{"children":[],"content_layer":"body","label":"text","orig":"Certain certificate programs contain 6000-level courses as requirements and/or electives. These 6000-level courses may not be taken by undergraduate students. Candidates must receive two-thirds of their certificate-applicable credit from the university. The transferring of credit or the substitution of courses may occur only after application to the appropriate campus authority.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":391.75000586,"coord_origin":"BOTTOMLEFT","l":36.0,"r":291.20000000000005,"t":454.15000585999996},"charspan":[0,381],"page_no":1}],"self_ref":"#/texts/8","text":"Certain certificate programs contain 6000-level courses as requirements and/or electives. These 6000-level courses may not be taken by undergraduate students. Candidates must receive two-thirds of their certificate-applicable credit from the university. The transferring of credit or the substitution of courses may occur only after application to the appropriate campus authority."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Certificate requirements (18 units)","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":368.4379978,"coord_origin":"BOTTOMLEFT","l":36.0,"r":246.9380000000001,"t":380.4629978},"charspan":[0,35],"page_no":1}],"self_ref":"#/texts/9","text":"Certificate requirements (18 units)"}],"version":"1.10.0"}