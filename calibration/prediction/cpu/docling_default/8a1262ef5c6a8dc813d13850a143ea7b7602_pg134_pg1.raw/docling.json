9.2837612628937,"t":406.88419353961945},"col_span":1,"column_header":false,"end_col_offset_idx":4,"end_row_offset_idx":7,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":3,"start_row_offset_idx":6,"text":" "}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":353.94207763671875,"coord_origin":"BOTTOMLEFT","l":106.40966033935547,"r":531.5685424804688,"t":535.5561828613281},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"4.6.4 Learners' computer literacy and utilisation of online electronic books","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":693.1705454545454,"coord_origin":"BOTTOMLEFT","l":108.02,"r":492.7,"t":703.264},"charspan":[0,76],"page_no":1}],"self_ref":"#/texts/0","text":"4.6.4 Learners' computer literacy and utilisation of online electronic books"},{"children":[],"content_layer":"body","label":"text","orig":"The study also explored the influence of learners' computer literacy on utilisation of online electronic books. In order to accomplish this task, respondents were asked to indicate the extent  to  which  learners'  computer  literacy  influenced  utilisation  of  online  electronic books. The results are summarised in Table 4.31.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":582.964,"coord_origin":"BOTTOMLEFT","l":108.02,"r":543.0759999999999,"t":676.096},"charspan":[0,331],"page_no":1}],"self_ref":"#/texts/1","text":"The study also explored the influence of learners' computer literacy on utilisation of online electronic books. In order to accomplish this task, respondents were asked to indicate the extent  to  which  learners'  computer  literacy  influenced  utilisation  of  online  electronic books. The results are summarised in Table 4.31."},{"children":[],"content_layer":"body","label":"caption","orig":"Table 4.31: Learners' computer literacy and utilisation of online electronic books","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":541.3705454545454,"coord_origin":"BOTTOMLEFT","l":108.02,"r":526.06,"t":551.464},"charspan":[0,82],"page_no":1}],"self_ref":"#/texts/2","text":"Table 4.31: Learners' computer literacy and utilisation of online electronic books"},{"children":[],"content_layer":"body","label":"text","orig":"On the basis of data shown in Table 4.31, it emerges that 61 (23.6%) and 79 (30.4%) respondents scored in the Not at all and less extent level respectively. The information in Table 4.31 also reveal that 22 (10.6%) and 37 (14.3%) respondents scored in the great extent and very great extent, respectively while 55(21.1%) said they were not sure. The data gives the impression that majority 140 (54%) respondents did not support the view that learners' computer literacy influence utilisation of online electronic books compared to only, 59 (24.9%) respondents supporting the opinion. The implication of this finding is that  there  was  less  influence  of  learners'  computer  literacy  on  utilisation  of  online electronic books among the distance learning standards at the University of Nairobi.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":92.44799999999998,"coord_origin":"BOTTOMLEFT","l":108.02,"r":543.1,"t":323.606},"charspan":[0,801],"page_no":1}],"self_ref":"#/texts/3","text":"On the basis of data shown in Table 4.31, it emerges that 61 (23.6%) and 79 (30.4%) respondents scored in the Not at all and less extent level respectively. The information in Table 4.31 also reveal that 22 (10.6%) and 37 (14.3%) respondents scored in the great extent and very great extent, respectively while 55(21.1%) said they were not sure. The data gives the impression that majority 140 (54%) respondents did not support the view that learners' computer literacy influence utilisation of online electronic books compared to only, 59 (24.9%) respondents supporting the opinion. The implication of this finding is that  there  was  less  influence  of  learners'  computer  literacy  on  utilisation  of  online electronic books among the distance learning standards at the University of Nairobi."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"113","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":50.68799999999999,"coord_origin":"BOTTOMLEFT","l":315.05,"r":336.07,"t":61.01999999999998},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/4","text":"113"}],"version":"1.10.0"}