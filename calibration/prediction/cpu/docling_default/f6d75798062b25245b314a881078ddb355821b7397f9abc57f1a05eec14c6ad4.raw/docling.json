/pictures/0"},"prov":[{"bbox":{"b":559.6966722750802,"coord_origin":"BOTTOMLEFT","l":146.356125384,"r":221.789415456,"t":565.2518278},"charspan":[0,26],"page_no":1}],"self_ref":"#/texts/53","text":"Quantum communication rate"},{"children":[],"content_layer":"body","label":"text","orig":"Classical communication rate","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":614.50453184,"coord_origin":"BOTTOMLEFT","l":64.446828306,"r":70.33826836298931,"t":685.0192807200001},"charspan":[0,28],"page_no":1}],"self_ref":"#/texts/54","text":"Classical communication rate"},{"children":[],"content_layer":"body","label":"text","orig":"Classically-enhanced quantum coding","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":713.7087874350802,"coord_origin":"BOTTOMLEFT","l":182.252122528,"r":280.54659955,"t":719.26394296},"charspan":[0,35],"page_no":1}],"self_ref":"#/texts/55","text":"Classically-enhanced quantum coding"},{"children":[],"content_layer":"body","label":"text","orig":"Time-sharin","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":706.9725502350802,"coord_origin":"BOTTOMLEFT","l":182.252122528,"r":214.05073954600002,"t":712.52770576},"charspan":[0,11],"page_no":1}],"self_ref":"#/texts/56","text":"Time-sharin"},{"children":[],"content_layer":"body","label":"text","orig":"g","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":706.9725502350802,"coord_origin":"BOTTOMLEFT","l":214.05073954600002,"r":217.248430098,"t":712.52770576},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/57","text":"g"},{"children":[],"content_layer":"body","label":"caption","orig":"FIG. 5: (Color online) The figure plots the CQE capacity region for an Unruh channel with acceleration parameter z = 0 . 95. It features three distinct surfaces. The first is the flat vertical plane that arises from the bound R +2 Q ≤ C EAC , where C EAC is the entanglement-assisted classical capacity of an Unruh channel. The plane extends infinitely upward because we can always achieve these rate triples simply by wasting entanglement. The second surface is that below and to the left of the plane, formed by combining the CE trade-off curve with the inverse of super-dense coding, as described in Section III C. The final surface is that below and to the right of the plane, formed by combining the CQ trade-off curve with the inverse of entanglement distribution, as described in Section III C.","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":92.3150894340057,"coord_origin":"BOTTOMLEFT","l":53.99999999999999,"r":299.08578432,"t":236.1410512},"charspan":[0,801],"page_no":1}],"self_ref":"#/texts/58","text":"FIG. 5: (Color online) The figure plots the CQE capacity region for an Unruh channel with acceleration parameter z = 0 . 95. It features three distinct surfaces. The first is the flat vertical plane that arises from the bound R +2 Q ≤ C EAC , where C EAC is the entanglement-assisted classical capacity of an Unruh channel. The plane extends infinitely upward because we can always achieve these rate triples simply by wasting entanglement. The second surface is that below and to the left of the plane, formed by combining the CE trade-off curve with the inverse of super-dense coding, as described in Section III C. The final surface is that below and to the right of the plane, formed by combining the CQ trade-off curve with the inverse of entanglement distribution, as described in Section III C."},{"children":[],"content_layer":"body","label":"text","orig":"0","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":273.0256350058289,"coord_origin":"BOTTOMLEFT","l":294.618979827,"r":298.09770502699996,"t":279.76296257},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/59","text":"0"},{"children":[],"content_layer":"body","label":"text","orig":"0.2","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":270.83667786582885,"coord_origin":"BOTTOMLEFT","l":267.294782154,"r":275.99785185400003,"t":277.57400542999994},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/60","text":"