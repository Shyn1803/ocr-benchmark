e_no":1}],"self_ref":"#/texts/24","text":"Social plug-ins,"},{"children":[],"content_layer":"body","label":"text","orig":"performance","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":615.7780191695313,"coord_origin":"BOTTOMLEFT","l":340.918,"r":384.51265501200066,"t":622.8819303695312},"charspan":[0,11],"page_no":1}],"self_ref":"#/texts/25","text":"performance"},{"children":[],"content_layer":"body","label":"text","orig":"analytics","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":604.7780191695313,"coord_origin":"BOTTOMLEFT","l":347.40000000000003,"r":378.0332169360018,"t":611.8819303695312},"charspan":[0,9],"page_no":1}],"self_ref":"#/texts/26","text":"analytics"},{"children":[],"content_layer":"body","label":"text","orig":"Behavioral","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":626.7780191695313,"coord_origin":"BOTTOMLEFT","l":419.789,"r":456.6813388879993,"t":633.8819303695312},"charspan":[0,10],"page_no":1}],"self_ref":"#/texts/27","text":"Behavioral"},{"children":[],"content_layer":"body","label":"text","orig":"advertising,","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":615.7780191695313,"coord_origin":"BOTTOMLEFT","l":418.598,"r":459.049494110003,"t":622.8819303695312},"charspan":[0,12],"page_no":1}],"self_ref":"#/texts/28","text":"advertising,"},{"children":[],"content_layer":"body","label":"text","orig":"tracking services","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":604.7780191695313,"coord_origin":"BOTTOMLEFT","l":409.141,"r":467.32907244800253,"t":611.8819303695312},"charspan":[0,17],"page_no":1}],"self_ref":"#/texts/29","text":"tracking services"},{"children":[],"content_layer":"body","label":"text","orig":"essential and, thus, not exempted. This is the case of profiling cookies.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":534.6920191695311,"coord_origin":"BOTTOMLEFT","l":51.024,"r":286.3004257739748,"t":556.0804308695311},"charspan":[0,73],"page_no":1}],"self_ref":"#/texts/30","text":"essential and, thus, not exempted. This is the case of profiling cookies."},{"children":[],"content_layer":"body","label":"text","orig":"However, such guidelines are not part of the ePrivacy Directive. Hence, the definition of a 'necessary element' to offer a service is subject to interpretation by National Data Protection Authorities. We illustrate different approaches in Table 4, based on different definitions of necessary cookie. Helped by Opinion 04/2012, we identify four types of cookies, represented as columns in the table. Starting from the left, they are sorted from the most to the least likely to be necessary. Indeed, first-party cookies are very likely to be necessary (e.g., for authentication), while profiling cookies, installed by e.g., behavioral advertising platforms, are very far from being essential. We then formalize five different interpretations of the ePrivacy Directive that differ in the type of cookies subject to consent. The most permissive approach (A) represents the extreme scenario where no cookie is subject to consent, that clearly breaks the spirit of the Directive. On the opposite side, the approach (E) represents the strictest interpretation, which mandates that all cookies need prior consent. In this work, we verify the compliance to the interpretation (B), which is the most tolerant approach that mandates consent for some kind of unnecessary cookies. According to (B), only profiling cookies need prior users's consent, while all others do not. Thus, our definition of violations becomes very conservative - i.e., we prefer to neglect some violations, than to incur false positives.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":183.69201916953114,"coord_origin":"BOTTOMLEFT","l":50.67200000000001,"r":287.9334585649749,"t":530.0804308695311},"charspan":[0,1499],"page_no":1}],"self_ref":"#/texts/31","text":"However, such guidelines are not part of the ePrivacy Directive. Hence, the definition of a 'necessary element' to offer a service is subject to interpretation by National Data Protection Authorities. We illustrate different approaches in Table 4, based on different definitions of necessary cookie. Helped by Opinion 04/2012, we identify four types of cookies, represented as columns in the table. Starting from the left, they are sorted from the most to the least likely to be necessary. Indeed, first-party cookies are very likely to be necessary (e.g., for authentication), while profiling cookies, installed by e.g., behavioral advertising platforms, are very far from being essential. We then formalize five different interpretations of the ePrivacy Directive that differ in the type of cookies subject to consent. The most permissive approach (A) represents the extreme scenario where no cookie is subject to consent, that clearly breaks the spirit of the Directive. On the opposite side, the approach (E) represents the strictest interpretation, which mandates that all cookies need prior consent. In this work, we verify the compliance to the interpretation (B), which is the most tolerant approach that mandates consent for some kind of unnecessary cookies. According to (B), only profiling cookies need prior users's consent, while all others do not. Thus, our definition of violations becomes very conservative - i.e., we prefer to neglect some violations, than to incur false positives."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"7.2.2 Transposition into national legislation","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":144.69201916953114,"coord_origin":"BOTTOMLEFT","l":51.02400000000001,"r":240.7911516890078,"t":153.1279303695312},"charspan":[0,45],"page_no":1}],"self_ref":"#/texts/32","text":"7.2.2 Transposition into national legislation"},{"children":[],"content_layer":"body","label":"text","orig":"The European regulatory landscape is not homogeneous. All EU MSs must transpose EU Directives into their legislation as a minimum level of harmonization. As such, EU MSs have transposed the ePrivacy Directive in dif- ferent ways [44, 56]. For the sake of simplification, we group such transpositions into three categories. A graphical representation of ePrivacy Directive interpretations (and EU MSs of application) is provided in Figure 12.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":79.69201916953114,"coord_origin":"BOTTOMLEFT","l":50.66200000000001,"r":288.1970536429586,"t":127.08043086953114},"charspan":[0,216],"page_no":1},{"bbox":{"b":235.14901916953124,"coord_origin":"BOTTOMLEFT","l":296.495,"r":534.5427094319665,"t":282.5374308695312},"charspan":[217,441],"page_no":1}],"self_ref":"#/texts/33","text":"The European regulatory landscape is not homogeneous. All EU MSs must transpose EU Directives into their legislation as a minimum level of harmonization. As such, EU MSs have transposed the ePrivacy Directive in dif- ferent ways [44, 56]. For the sake of simplification, we group such transpositions into three categories. A graphical representation of ePrivacy Directive interpretations (and EU MSs of application) is provided in Figure 12."},{"children":[],"content_layer":"body","label":"caption","orig":"Fig. 12. ePrivacy Directive transposition into EU MSs legislation.","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":317.7390191695312,"coord_origin":"BOTTOMLEFT","l":297.638,"r":529.9906816120007,"t":324.8429303695312},"charspan":[0,66],"page_no":1}],"self_ref":"#/texts/34","text":"Fig. 12. ePrivacy Directive transposition into EU MSs legislation."},{"children":[],"content_layer":"body","label":"text","orig":"Opt-In","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":539.7009887695312,"coord_origin":"BOTTOMLEFT","l":330.3333333333333,"r":343.6666666666667,"t":545.0343221028646},"charspan":[0,6],"page_no":1}],"self_ref":"#/texts/35","text":"Opt-In"},{"children":[],"content_layer":"body","label":"text","orig":"Opt-in","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":532.367655436198,"coord_origin":"BOTTOMLEFT","l":330.3333333333333,"r":343.6