m homotopy commutative:","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":581.9092420000001,"coord_origin":"BOTTOMLEFT","l":126.71945000000005,"r":485.3049543200001,"t":604.9792309000002},"charspan":[0,138],"page_no":1}],"self_ref":"#/texts/4","text":"By definition, liftcat f ′ ( µ ) ⩽ n if and only if there exists a map Φ: X → T n ( µ ) making the following diagram homotopy commutative:"},{"children":[],"content_layer":"body","label":"text","orig":"/d50","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":555.47016648,"coord_origin":"BOTTOMLEFT","l":330.2398,"r":330.2398,"t":566.0604528},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/5","text":"/d50"},{"children":[],"content_layer":"body","label":"text","orig":"/d50","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":556.147626,"coord_origin":"BOTTOMLEFT","l":330.2398,"r":330.2398,"t":566.0604528},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/6","text":"/d50"},{"children":[],"content_layer":"body","label":"text","orig":"/d15","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":549.5901684800001,"coord_origin":"BOTTOMLEFT","l":346.43945,"r":346.43945,"t":560.1804548000001},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/7","text":"/d15"},{"children":[],"content_layer":"body","label":"text","orig":"/d15","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":550.2676280000001,"coord_origin":"BOTTOMLEFT","l":346.43945,"r":346.43945,"t":560.1804548000001},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/8","text":"/d15"},{"children":[],"content_layer":"body","label":"text","orig":"T","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":562.5479464800001,"coord_origin":"BOTTOMLEFT","l":333.23945000000003,"r":339.05763176000005,"t":571.8530522400001},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/9","text":"T"},{"children":[],"content_layer":"body","label":"text","orig":"n","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":566.8273981000001,"coord_origin":"BOTTOMLEFT","l":340.55976000000004,"r":345.4832981,"t":573.29