6.75382316112518,"coord_origin":"TOPLEFT","l":275.11005902290344,"r":277.9330174922943,"t":218.2449108362198},"col_span":1,"column_header":false,"end_col_offset_idx":4,"end_row_offset_idx":11,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":3,"start_row_offset_idx":10,"text":""}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":611.5486602783203,"coord_origin":"BOTTOMLEFT","l":39.736732482910156,"r":291.825927734375,"t":742.0003128051758},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"furniture","label":"page_header","orig":"Dorrigiv D, et al","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":775.4933,"coord_origin":"BOTTOMLEFT","l":268.08,"r":329.87448974999995,"t":785.3752999999999},"charspan":[0,17],"page_no":1}],"self_ref":"#/texts/0","text":"Dorrigiv D, et al"},{"children":[],"content_layer":"body","label":"caption","orig":"Table 1. Dimensions of the CEA","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":745.83662,"coord_origin":"BOTTOMLEFT","l":113.76,"r":220.59034776000024,"t":754.67048},"charspan":[0,30],"page_no":1}],"self_ref":"#/texts/1","text":"Table 1. Dimensions of the CEA"},{"children":[],"content_layer":"body","label":"caption","orig":"Figure 1. A: The CEA and B: the smCEA drawn in COMSOL multiphysic.","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":472.836428,"coord_origin":"BOTTOMLEFT","l":56.52,"r":257.55597243,"t":490.85048},"charspan":[0,66],"page_no":1}],"self_ref":"#/texts/2","text":"Figure 1. A: The CEA and B: the smCEA drawn in COMSOL multiphysic."},{"children":[],"content_layer":"body","label":"text","orig":"same as Dean vortices are created in the entrance of contraction region, where the flow is accelerated 15, 16,22-24 . Our CTC separation device is a straight channel with contraction arrays that separates the cells based on their sizes.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":385.156118,"coord_origin":"BOTTOMLEFT","l":56.69999999999996,"r":282.2782079999997,"t":442.267796},"charspan":[0,236],"page_no":1}],"self_ref":"#/texts/3","text":"same as Dean vortices are created in the entrance of contraction region, where the flow is accelerated 15, 16,22-24 . Our CTC separation device is a straight channel with contraction arrays that separates the cells based on their sizes."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Materials and Methods","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":362.05600999999996,"coord_origin":"BOTTOMLEFT","l":118.4404864,"r":217.9203999999999,"t":373.14814999999993},"charspan":[0,21],"page_no":1}],"self_ref":"#/texts/4","text":"Materials and Methods"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"COMSOL simulation","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":349.15598,"coord_origin":"BOTTOMLEFT","l":56.7,"r":140.804,"t":360.24812},"charspan":[0,17],"page_no":1}],"self_ref":"#/texts/5","text":"COMSOL simulation"},{"children":[],"content_layer":"body","label":"text","orig":"There are several empirical studies on inertial microfluidic separation devices. However, to our knowledge, no group has focused on the computational simulation of these devices. In this study, simulation was conducted based on the data from a past empirical work called the Contraction Expansion Array (CEA) as a reference (Figure  1A)  to  verify  the  simulations 16 .  The  CEA  is  a straight channel with six contraction regions, two inlets, and two outlets. The dimensions of the CEA are in table 1. The general objective in this part is to modify the configuration of the system to improve the separation efficiency. From theory, it is known that both Dean Drag force and inertial lift force are affected by the geometry of the channel. Hence, manipulating the channel geometry can affect the separation. The design of the CEA was elaborated by manipulating its geometry with a software. The software COMSOL Multiphysics 5.2® was used to simulate the 3D module of the particles flowing in  the  CEA.  Primary  assumptions  were  about  rigid spherical particles diffused in a laminar flow of a liquid with the characteristics of water. Laminar flow and particle tracing physics are the physics used in COMSOL","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":96.55666999999994,"coord_origin":"BOTTOMLEFT","l":56.700649600000006,"r":282.2349536,"t":349.08784399999996},"charspan":[0,1216],"page_no":1}],"self_ref":"#/texts/6","text":"There are several empirical studies on inertial microfluidic separation devices. However, to our knowledge, no group has focused on the computational simulation of these devices. In this study, simulation was conducted based on the data from a past empirical work called the Contraction Expansion Array (CEA) as a reference (Figure  1A)  to  verify  the  simulations 16 .  The  CEA  is  a straight channel with six contraction regions, two inlets, and two outlets. The dimensions of the CEA are in table 1. The general objective in this part is to modify the configuration of the system to improve the separation efficiency. From theory, it is known that both Dean Drag force and inertial lift force are affected by the geometry of the channel. Hence, manipulating the channel geometry can affect the separation. The design of the CEA was elaborated by manipulating its geometry with a software. The software COMSOL Multiphysics 5.2® was used to simulate the 3D module of the particles flowing in  the  CEA.  Primary  assumptions  were  about  rigid spherical particles diffused in a laminar flow of a liquid with the characteristics of water. Laminar flow and particle tracing physics are the physics used in COMSOL"},{"children":[],"content_layer":"body","label":"caption","orig":"Figure 2. Fabricated device prepared with soft lithography.","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":614.7966200000001,"coord_origin":"BOTTOMLEFT","l":323.22,"r":513.9380100000004,"t":623.63048},"charspan":[0,59],"page_no":1}],"self_ref":"#/texts/7","text":"Figure 2. Fabricated device prepared with soft lithography."},{"children":[],"content_layer":"body","label":"text","orig":"environment. Dean drag force equation is assumed to follow stokes drag equation all over the device and the inertial lift force term was inserted manually, different for contractions and expansions regions. Then, the effect of the angle between two inlets, the depth of the channel, the shape of expansion arrays and the ratio between the two inlet flow rates with simulation were evaluated. Figure 1B shows the properties of the optimized CEA according to simulation results. The optimized device is called the simulation-modified CEA (smCEA).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":469.637342,"coord_origin":"BOTTOMLEFT","l":315.6593472,"r":541.200636799999,"t":584.229068},"charspan":[0,544],"page_no":1}],"self_ref":"#/texts/8","text":"environment. Dean drag force equation is assumed to follow stokes drag equation all over the device and the inertial lift force term was inserted manually, different for contractions and expansions regions. Then, the effect of the angle between two inlets, the depth of the channel, the shape of expansion arrays and the ratio between the two inlet flow rates with simulation were evaluated. Figure 1B shows the properties of the optimized CEA according to simulation results. The optimized device is called the simulation-modified CEA (smCEA)."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Fabrication of the design","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":448.57598,"coord_origin":"BOTTOMLEFT","l":315.6596334,"r":414.344,"t":459.66812},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/9","text":"Fabrication of the design"},{"children":[],"content_layer":"body","label":"text","orig":"The smCEA was fabricated according to the simulation outcome. The smCEA, similar to the CEA, has two inlets for a flow containing cells (particle fluid) and a particle-less fluid with the same physical charac","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":402.915842,"coord_origin":"BOTTOMLEFT","l":315.66035839999995,"r":541.1475616000009,"t":448.507844},"charspan":[0,208],"page_no":1}],"self_ref":"#/texts/10","text":"The smCEA was fabricated according to the simulation outcome. The smCEA, similar to the CEA, has two inlets for a flow containing cells (particle fluid) and a particle-less fluid with the same physical charac"},{"children":[],"content_layer":"body","label":"text","orig":"ͦ","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":310.93625,"coord_origin":"BOTTOMLEFT","l":474.65950399999997,"r":474.65950399999997,"t":322.02838999999994},"charspan":[0,1],"page_no":1}],"self_ref":"#/texts/11","text":"ͦ"},{"children":[],"content_layer":"body","label":"text","orig":"teristics  (focusing fluid) to focus on the particles, and two outlets. The devices were prepared by soft lithography protocol 25 .  In  this  method,  molds  of  the  smCEA were prepared with SU-8 photoresist on a glass substrate following  the  conventional  photolithography  process. Then, Poly Di-methyl Siloxane (PDMS) and its curing agent (Sylgard 184; Dow Corning, MI) in a ratio of 10:1 were poured on stamps and cured in a 65 oven overnight. The  PDMS  layer  was  detached  from  the  stamp  and bonded to a glass slide by treating both surfaces with an air-plasma  treatment  process  in  low  pressure  (500 mTorr) chamber (Figure 2). The plasma treatment process made PDMS hydrophilic.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":253.45651999999995,"coord_origin":"BOTTOMLEFT","l":315.66035839999995,"r":541.1877792000007,"t":402.54810799999996},"charspan":[0,699],"page_no":1}],"self_ref":"#/texts/12","text":"teristics  (focusing fluid) to focus on the particles, and two outlets. The devices were prepared by soft lithography protocol 25 .  In  this  method,  molds  of  the  smCEA were prepared with SU-8 photoresist on a glass substrate following  the  conventional  photolithography  process. Then, Poly Di-methyl Siloxane (PDMS) and its curing agent (Sylgard 184; Dow Corning, MI) in a ratio of 10:1 were poured on stamps and cured in a 65 oven overnight. The  PDMS  layer  was  detached  from  the  stamp  and bonded to a glass slide by treating both surfaces with an air-plasma  treatment  process  in  low  pressure  (500 mTorr) chamber (Figure 2). The plasma treatment process made PDMS hydrophilic."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Sample preparation","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":238.15598,"coord_origin":"BOTTOMLEFT","l":315.66,"r":391.48400000000004,"t":249.24811999999997},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/13","text":"Sample preparation"},{"children":[],"content_layer":"body","label":"text","orig":"Two  approaches  in  the  preparation  of  the  particle fluid were used while the focusing fluid was the same during the experiments. PBS was used as the focusing fluid. For the first set of experiment, a combination of fixed mouse fibroblast cell line (L929) (10-15 μ m in diameter) and breast cancer cell line (MCF7) (18-25 μ m in diameter) with a predefined density was suspended in PBS to form the particle fluid. For the second set of experiment, first, the whole blood was diluted 100 times with PBS, and then a suspension of MCF7 fixed cells was spiked into the blood. Whole blood was obtained from Iranian Blood Transfusion Organization (IBTO).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":100.51625000000001,"coord_origin":"BOTTOMLEFT","l":315.6588736,"r":541.2031680000003,"t":238.08784400000002},"charspan":[0,653],"page_no":1}],"self_ref":"#/texts/14","text":"Two  approaches  in  the  preparation  of  the  particle fluid were used while the focusing fluid was the same during the experiments. PBS was used as the focusing fluid. For the first set of experiment, a combination of fixed mouse fibroblast cell line (L929) (10-15 μ m in diameter) and breast cancer cell line (MCF7) (18-25 μ m in diameter) with a predefined density was suspended in PBS to form the particle fluid. For the second set of experiment, first, the whole blood was diluted 100 times with PBS, and then a suspension of MCF7 fixed cells was spiked into the blood. Whole blood was obtained from Iranian Blood Transfusion Organization (IBTO)."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"Avicenna Journal of Medical Biotechnology, Vol. 11, No. 4, October-December 2019","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":56.8134,"coord_origin":"BOTTOMLEFT","l":143.85538929999998,"r":453.60462126000004,"t":66.69540000000006},"charspan":[0,80],"page_no":1}],"self_ref":"#/texts/15","text":"Avicenna Journal of Medical Biotechnology, Vol. 11, No. 4, October-December 2019"},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"279","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":55.733299999999986,"coord_origin":"BOTTOMLEFT","l":557.7,"r":572.9082451500001,"t":65.61529999999993},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/16","text":"279"}],"version":"1.10.0"}