tion":false,"row_span":1,"start_col_offset_idx":1,"start_row_offset_idx":5,"text":"155"},{"bbox":{"b":282.06000143289566,"coord_origin":"TOPLEFT","l":474.346999168396,"r":482.31429862976074,"t":274.1911763548851},"col_span":1,"column_header":false,"end_col_offset_idx":3,"end_row_offset_idx":6,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":2,"start_row_offset_idx":5,"text":"49"}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":557.240966796875,"coord_origin":"BOTTOMLEFT","l":346.30181884765625,"r":539.946533203125,"t":640.6107940673828},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/1"}],"texts":[{"children":[],"content_layer":"furniture","label":"page_header","orig":"Downloaded from http://adc.bmj.com/ on June 21, 2017 - Published by group.bmj.com","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":827.3440244140626,"coord_origin":"BOTTOMLEFT","l":140.20826,"r":444.79193999999984,"t":834.7440244140626},"charspan":[0,81],"page_no":1}],"self_ref":"#/texts/0","text":"Downloaded from http://adc.bmj.com/ on June 21, 2017 - Published by group.bmj.com"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"Immunisation state and its documentation in hospital patients","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":801.923220455398,"coord_origin":"BOTTOMLEFT","l":42.42,"r":233.4581553061844,"t":809.1362244140626},"charspan":[0,61],"page_no":1}],"self_ref":"#/texts/1","text":"Immunisation state and its documentation in hospital patients"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"765","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":801.6832304553975,"coord_origin":"BOTTOMLEFT","l":526.7999999999995,"r":537.9607019999995,"t":808.7762244140621},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/2","text":"765"},{"children":[],"content_layer":"body","label":"caption","orig":"Table I Providers of immunisations to 204 inpatients according to where patients lived","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":771.877248118355,"coord_origin":"BOTTOMLEFT","l":143.63999999999996,"r":442.0800030000001,"t":779.4962244140626},"charspan":[0,86],"page_no":1}],"self_ref":"#/texts/3","text":"Table I Providers of immunisations to 204 inpatients according to where patients lived"},{"children":[],"content_layer":"body","label":"text","orig":"viewed and immunisation data verified for all of them. There were 87 (43%) girls and 117 boys, mean age 11-7 months. Of the 204 children, 159 (78%) had received all the required first year doses of triple antigen, and of the 33 children old enough to have received the 18 month booster dose, 15 had received this dose as triple antigen, and three as combined diphtheriatetanus. Thus 144 (71%) were appropriately immunised for age with triple antigen, and an additional 20 (9%) had received some doses of combined diphtheria-tetanus instead of triple antigen. One hundred and seventy six (86%) children had received the correct number of oral polio vaccine doses, and 48 (81%) of the 59 children aged 16 months or older had received measles-mumps/measles-mumps-rubella. Overall, only 135 of the 204 children (66%) had complied fully with the recommended schedule.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":482.35072252217,"coord_origin":"BOTTOMLEFT","l":142.91999999999993,"r":335.87984399999993,"t":678.1516244140626},"charspan":[0,862],"page_no":1}],"self_ref":"#/texts/4","text":"viewed and immunisation data verified for all of them. There were 87 (43%) girls and 117 boys, mean age 11-7 months. Of the 204 children, 159 (78%) had received all the required first year doses of triple antigen, and of the 33 children old enough to have received the 18 month booster dose, 15 had received this dose as triple antigen, and three as combined diphtheriatetanus. Thus 144 (71%) were appropriately immunised for age with triple antigen, and an additional 20 (9%) had received some doses of combined diphtheria-tetanus instead of triple antigen. One hundred and seventy six (86%) children had received the correct number of oral polio vaccine doses, and 48 (81%) of the 59 children aged 16 months or older had received measles-mumps/measles-mumps-rubella. Overall, only 135 of the 204 children (66%) had complied fully with the recommended schedule."},{"children":[],"content_layer":"body","label":"text","orig":"COMPARISON OF INPATIENTS WITH OUTPATIENTS One hundred forty four of 204 inpatients (71%) had received all triple antigen doses for age compared with 93 of 111 outpatients (84%). This difference is significant (X2=6-0, p<0.02). In addition, 176 inpatients (86%) had received all oral polio vaccine doses for age, compared with 106 outpatients (95%). This difference is significant (X2=5-6, p<0 02). The compliance with measles-mumps immunisation in the two groups was similar (X2=0-0, p>0-95).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":345.6660132852861,"coord_origin":"BOTTOMLEFT","l":142.19999999999996,"r":333.6003218939999,"t":457.8180344140619},"charspan":[0,492],"page_no":1}],"self_ref":"#/texts/5","text":"COMPARISON OF INPATIENTS WITH OUTPATIENTS One hundred forty four of 204 inpatients (71%) had received all triple antigen doses for age compared with 93 of 111 outpatients (84%). This difference is significant (X2=6-0, p<0.02). In addition, 176 inpatients (86%) had received all oral polio vaccine doses for age, compared with 106 outpatients (95%). This difference is significant (X2=5-6, p<0 02). The compliance with measles-mumps immunisation in the two groups was similar (X2=0-0, p>0-95)."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"USE OF THE PERSONAL HEALTH RECORD","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":316.1375347479252,"coord_origin":"BOTTOMLEFT","l":142.08000000000004,"r":303.95856000000003,"t":322.58562441406195},"charspan":[0,33],"page_no":1}],"self_ref":"#/texts/6","text":"USE OF THE PERSONAL HEALTH RECORD"},{"children":[],"content_layer":"body","label":"text","orig":"When 24 of the 204 children either born outside New South Wales and the Australian Capital Territory, or before the introduction of the personal health record, were excluded from the analysis, 176 (98%) of a possible 180 children had a personal health record; in the remainder the mothers had not been given them. Many parents, however, did not bring the personal health record into hospital at the time of admission, so that the personal health record was available for only 46% of children. Of 88 children admitted urgently (the casualty department, doctor's rooms, or interhospital transfer) only 30 (34%) had their personal health record on admission, compared with 51 of 87 children (59%) admitted electively (X2=9-6, p<0-01).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":136.74601328528615,"coord_origin":"BOTTOMLEFT","l":141.23999999999978,"r":334.92048,"t":313.104024414062},"charspan":[0,731],"page_no":1}],"self_ref":"#/texts/7","text":"When 24 of the 204 children either born outside New South Wales and the Australian Capital Territory, or before the introduction of the personal health record, were excluded from the analysis, 176 (98%) of a possible 180 children had a personal health record; in the remainder the mothers had not been given them. Many parents, however, did not bring the personal health record into hospital at the time of admission, so that the personal health record was available for only 46% of children. Of 88 children admitted urgently (the casualty department, doctor's rooms, or interhospital transfer) only 30 (34%) had their personal health record on admission, compared with 51 of 87 children (59%) admitted electively (X2=9-6, p<0-01)."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"PROVIDERS OF IMMUNISATIONS","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":108.6575347479253,"coord_origin":"BOTTOMLEFT","l":140.7599999999998,"r":264.1789270199998,"t":115.21802441406203},"charspan":[0,26],"page_no":1}],"self_ref":"#/texts/8","text":"PROVIDERS OF IMMUNISATIONS"},{"children":[],"content_layer":"body","label":"text","orig":"For analysis of usage patterns, the 204 children were divided into two groups according to where they lived: 'Sydney' (that is, those residing in central, eastern, northern, southern, western or south western health areas) and","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":56.96476018512726,"coord_origin":"BOTTOMLEFT","l":140.03999999999988,"r":332.16016799999994,"t":106.71161441406207},"charspan":[0,226],"page_no":1}],"self_ref":"#/texts/9","text":"For analysis of usage patterns, the 204 children were divided into two groups according to where they lived: 'Sydney' (that is, those residing in central, eastern, northern, southern, western or south western health areas) and"},{"children":[],"content_layer":"body","label":"caption","orig":"Table 2 Accuracy of documentation of inpatients' immunisation state in medical records when compared with immunisation records held by parents or providers of immunisations","parent":{"$ref":"#/tables/1"},"prov":[{"bbox":{"b":644.8712857813116,"coord_origin":"BOTTOMLEFT","l":347.51999999999987,"r":540.2395693079998,"t":675.996224414062},"charspan":[0,172],"page_no":1}],"self_ref":"#/texts/10","text":"Table 2 Accuracy of documentation of inpatients' immunisation state in medical records when compared with immunisation records held by parents or providers of immunisations"},{"children":[],"content_layer":"body","label":"text","orig":"'elsewhere'. Immunisation providers were grouped for purposes of analysis into: 'private doctors' (general practitioners, medical practices, and paediatricians), 'local council', and 'Department of Health facilities' (comprising hospital immunisation clinics and early childhood centres) (table 1). There were 160 children living in 'Sydney' and 44 living 'elsewhere'. Most used private doctors exclusively for their immunisations, and a relatively small number used only local council clinics. When the users of multiple services were taken into account, private doctors were used for some or all immunisations by 131 Sydney residents (82%), and by 31 of those living elsewhere (70%). Similarly, local councils were used for some or all immunisations by 30 Sydney residents (19%) and by four of those living elsewhere (9%).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":346.6447601851272,"coord_origin":"BOTTOMLEFT","l":347.39999999999975,"r":539.9999279999998,"t":531.871624414062},"charspan":[0,824],"page_no":1}],"self_ref":"#/texts/11","text":"'elsewhere'. Immunisation providers were grouped for purposes of analysis into: 'private doctors' (general practitioners, medical practices, and paediatricians), 'local council', and 'Department of Health facilities' (comprising hospital immunisation clinics and early childhood centres) (table 1). There were 160 children living in 'Sydney' and 44 living 'elsewhere'. Most used private doctors exclusively for their immunisations, and a relatively small number used only local council clinics. When the users of multiple services were taken into account, private doctors were used for some or all immunisations by 131 Sydney residents (82%), and by 31 of those living elsewhere (70%). Similarly, local councils were used for some or all immunisations by 30 Sydney residents (19%) and by four of those living elsewhere (9%)."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"ACCURACY OF MEDICAL NOTES","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":315.98948942201116,"coord_origin":"BOTTOMLEFT","l":347.15999999999974,"r":469.20029999999963,"t":322.4504344140621},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/12","text":"ACCURACY OF MEDICAL NOTES"},{"children":[],"content_layer":"body","label":"text","orig":"The adequacy of documentation of immunisations in the children's medical notes compared with other records is shown in table 2. Overall, documentation of immunisations was correct in 155 medical records (76%), and incorrect or absent in 49 (24%). Immunisation state was incorrect or undocumented in 32 (19%) of the 155 medical notes of the children who were appropriately immunised and in 17 of 49 (35%) of those incompletely immunised.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":211.38059420738477,"coord_origin":"BOTTOMLEFT","l":346.4399999999996,"r":538.3223039999995,"t":313.59162441406204},"charspan":[0,436],"page_no":1}],"self_ref":"#/texts/13","text":"The adequacy of documentation of immunisations in the children's medical notes compared with other records is shown in table 2. Overall, documentation of immunisations was correct in 155 medical records (76%), and incorrect or absent in 49 (24%). Immunisation state was incorrect or undocumented in 32 (19%) of the 155 medical notes of the children who were appropriately immunised and in 17 of 49 (35%) of those incompletely immunised."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Discussion","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":180.44864953329898,"coord_origin":"BOTTOMLEFT","l":346.1999999999996,"r":392.3965199999993,"t":189.01642441406216},"charspan":[0,10],"page_no":1}],"self_ref":"#/texts/14","text":"Discussion"},{"children":[],"content_layer":"body","label":"text","orig":"These data show that the population of young children attending a children's hospital had a level of immunisation uptake lower than the 90-95% required for herd immunity to prevail in the general child population.'6 17 The casualty and outpatients survey showed vaccine uptakes of 79% for measles-mumps, 90% for first year triple antigen, and 95% for oral polio vaccine. These data aire difficult to compare with other studies because of differences in the populations surveyed and in other methods used, but a similar survey of children in casualty","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":56.37878784808436,"coord_origin":"BOTTOMLEFT","l":344.99999999999955,"r":537.2401199999996,"t":177.44022441406207},"charspan":[0,549],"page_no":1}],"self_ref":"#/texts/15","text":"These data show that the population of young children attending a children's hospital had a level of immunisation uptake lower than the 90-95% required for herd immunity to prevail in the general child population.'6 17 The casualty and outpatients survey showed vaccine uptakes of 79% for measles-mumps, 90% for first year triple antigen, and 95% for oral polio vaccine. These data aire difficult to compare with other studies because of differences in the populations surveyed and in other methods used, but a similar survey of children in casualty"}],"version":"1.10.0"}