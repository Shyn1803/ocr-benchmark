span":[0,13],"page_no":1}],"self_ref":"#/texts/0","text":"PRESTONS POST"},{"children":[],"content_layer":"body","label":"text","orig":"FROM THE PRINCIPALS DESK:","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":751.5866495768229,"coord_origin":"BOTTOMLEFT","l":409.6666666666667,"r":570.3333333333334,"t":763.5866495768229},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/1","text":"FROM THE PRINCIPALS DESK:"},{"children":[],"content_layer":"body","label":"text","orig":"Dear parents,","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":481.2219822378874,"coord_origin":"BOTTOMLEFT","l":175.2,"r":238.41503999999998,"t":489.6211029101563},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/2","text":"Dear parents,"},{"children":[],"content_layer":"body","label":"text","orig":"Great student achievement results from out of school events continue this week.  In the International Competitions and Assessments for Schools Spelling test Aimun Nauman and Kevin Noronha both achieved Distinctions and Anosha Ahmed Ghori, Daiyan Zahid and Ramna Safda achieved Credits.  In the Writing test Christina LoGiudice achieved a High Distinction, Aimun Nauman and Henrissa Pama both achieved Distinctions and Anagha Janakiraman and Diayan Zahid achieved Credits. Congratulations to all students who entered and participated in these tests.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":363.1602222378875,"coord_origin":"BOTTOMLEFT","l":175.2,"r":553.1323200000003,"t":464.3063829101563},"charspan":[0,548],"page_no":1}],"self_ref":"#/texts/3","text":"Great student achievement results from out of school events continue this week.  In the International Competitions and Assessments for Schools Spelling test Aimun Nauman and Kevin Noronha both achieved Distinctions and Anosha Ahmed Ghori, Daiyan Zahid and Ramna Safda achieved Credits.  In the Writing test Christina LoGiudice achieved a High Distinction, Aimun Nauman and Henrissa Pama both achieved Distinctions and Anagha Janakiraman and Diayan Zahid achieved Credits. Congratulations to all students who entered and participated in these tests."},{"children":[],"content_layer":"body","label":"text","orig":"This week a letter will be coming home to ask if you no longer require a paper edition of the weekly newsletter as you access it via the Prestons PS web page at www.prestons-p.schools.nsw.edu.au.  This will assist the school in lowering our carbon footprint as well as reducing printing costs. We thank you for your support in this matter.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":276.0219822378874,"coord_origin":"BOTTOMLEFT","l":175.19904,"r":554.9419200000011,"t":346.2446229101564},"charspan":[0,339],"page_no":1}],"self_ref":"#/texts/4","text":"This week a letter will be coming home to ask if you no longer require a paper edition of the weekly newsletter as you access it via the Prestons PS web page at www.prestons-p.schools.nsw.edu.au.  This will assist the school in lowering our carbon footprint as well as reducing printing costs. We thank you for your support in this matter."},{"children":[],"content_layer":"body","label":"text","orig":"Next week is Literacy Numeracy Week and the school has planned several engaging student centred activities to celebrate including: Indigenous Book Swap; Mad Hatter's Picnic; Read-A-Thon; Literacy/Numeracy Fun Day. As well, we will also be celebrating Fruit and Vegetable Week at the same time. Mrs Beavis has planned daily activities during play breaks for students to participate. What an exciting week to look forward to!","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":173.31686223788734,"coord_origin":"BOTTOMLEFT","l":175.18799999999996,"r":558.5630400000014,"t":259.1063829101563},"charspan":[0,423],"page_no":1}],"self_ref":"#/texts/5","text":"Next week is Literacy Numeracy Week and the school has planned several engaging student centred activities to celebrate including: Indigenous Book Swap; Mad Hatter's Picnic; Read-A-Thon; Literacy/Numeracy Fun Day. As well, we will also be celebrating Fruit and Vegetable Week at the same time. Mrs Beavis has planned daily activities during play breaks for students to participate. What an exciting week to look forward to!"},{"children":[],"content_layer":"body","label":"text","orig":"The Principal's Class of the Week Award goes to class 4BP who have demonstrated fantastic behaviour and engagement in learning over the past weeks. Congratulations students, Mrs Boss and Mrs Bayley-Patton (class teachers).","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":117.04598223788742,"coord_origin":"BOTTOMLEFT","l":175.18799999999996,"r":546.6177600000011,"t":156.40126291015633},"charspan":[0,222],"page_no":1}],"self_ref":"#/texts/6","text":"The Principal's Class of the Week Award goes to class 4BP who have demonstrated fantastic behaviour and engagement in learning over the past weeks. Congratulations students, Mrs Boss and Mrs Bayley-Patton (class teachers)."},{"children":[],"content_layer":"body","label":"text","orig":"Be Safe","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":78.63924008467154,"coord_origin":"BOTTOMLEFT","l":234.96,"r":285.0816,"t":88.78462291015626},"charspan":[0,7],"page_no":1}],"self_ref":"#/texts/7","text":"Be Safe"},{"children":[],"content_layer":"body","label":"text","orig":"Be","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":79.00356008467156,"coord_origin":"BOTTOMLEFT","l":367.3296,"r":386.96976,"t":89.14894291015628},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/8","text":"Be"},{"children":[],"content_layer":"body","label":"text","orig":"8 Yearning {oaring","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":4.9439588426540695,"coord_origin":"BOTTOMLEFT","l":280.0148684556841,"r":402.30875376054723,"t":30.561131818248214},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/9","text":"8 Yearning {oaring"},{"children":[],"content_layer":"body","label":"text","orig":"Be a Learner","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":79.35924008467157,"coord_origin":"BOTTO