51 heterosexual women  aged 18-35 at high risk of  infection "},{"bbox":{"b":252.6621701717377,"coord_origin":"TOPLEFT","l":218.44813752174377,"r":278.79065799713135,"t":225.39581009745604},"col_span":1,"column_header":false,"end_col_offset_idx":3,"end_row_offset_idx":4,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":2,"start_row_offset_idx":3,"text":"Kenya, South  Africa, Tanzania"},{"bbox":{"b":251.07404315471652,"coord_origin":"TOPLEFT","l":291.2030156850815,"r":351.1222714185715,"t":226.87529960274702},"col_span":1,"column_header":false,"end_col_offset_idx":4,"end_row_offset_idx":4,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":3,"start_row_offset_idx":3,"text":"Daily oral TDF/ FTC"},{"bbox":{"b":250.47159129381183,"coord_origin":"TOPLEFT","l":361.88358294963837,"r":443.531333565712,"t":226.78166323900228},"col_span":1,"column_header":false,"end_col_offset_idx":5,"end_row_offset_idx":4,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":4,"start_row_offset_idx":3,"text":"Trial discontinued for  futility in April 2011."},{"bbox":{"b":281.2899743914604,"coord_origin":"TOPLEFT","l":463.51329588890076,"r":553.8380038738251,"t":224.50428539514547},"col_span":1,"column_header":false,"end_col_offset_idx":6,"end_row_offset_idx":4,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":5,"start_row_offset_idx":3,"text":"Adherence assessment  with monthly clinical  samples to measure  drug concentration is  pending."},{"bbox":{"b":311.62420803308487,"coord_origin":"TOPLEFT","l":54.5913633853197,"r":92.2372771948576,"t":286.3811933398247},"col_span":1,"column_header":false,"end_col_offset_idx":1,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":0,"start_row_offset_idx":4,"text":"VOICE   MTN-003"},{"bbox":{"b":322.56581300497055,"coord_origin":"TOPLEFT","l":112.17396566271782,"r":212.09180736541748,"t":286.708977162838},"col_span":1,"column_header":false,"end_col_offset_idx":2,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":1,"start_row_offset_idx":4,"text":"5,029 heterosexual women  aged 18-45 in high- prevalence areas"},{"bbox":{"b":313.6215096116066,"coord_origin":"TOPLEFT","l":219.07869160175323,"r":283.1668667793274,"t":286.75791853666306},"col_span":1,"column_header":false,"end_col_offset_idx":3,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":2,"start_row_offset_idx":4,"text":"Uganda, South  Africa, Zimbabwe "},{"bbox":{"b":333.5342946052552,"coord_origin":"TOPLEFT","l":290.28939539194107,"r":353.92247200012207,"t":286.08365857601166},"col_span":1,"column_header":false,"end_col_offset_idx":4,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":3,"start_row_offset_idx":4,"text":"Daily oral TDF or  daily oral TDF/ FTC or daily  topical TFV gel "},{"bbox":{"b":415.08666300773626,"coord_origin":"TOPLEFT","l":360.20156252384186,"r":459.27289736270905,"t":286.56682097911835},"col_span":1,"column_header":false,"end_col_offset_idx":5,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":4,"start_row_offset_idx":4,"text":"No study drug significantly  reduced the risk of HIV  acquisition. Estimates of  effectiveness were less  than 0 for TDF and TDF/ FTC daily oral dosing  (negative 48.8% and  negative 4.2% TDF/FTC  respectively), and reduced  risk of HIV infection of  14.7% for TDF gel. "},{"bbox":{"b":365.0767632722855,"coord_origin":"TOPLEFT","l":463.5029811859131,"r":555.3840029239655,"t":287.0741661787033},"col_span":1,"column_header":false,"end_col_offset_idx":6,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":5,"start_row_offset_idx":4,"text":"Adherence to study  drugs was low; TFV  was detected in 30% of  the oral TDF arm, 29%  in the oral TDF/FTC  arm, and 25% in the  TDF gel arm."}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":378.06085205078125,"coord_origin":"BOTTOMLEFT","l":52.706485748291016,"r":559.0831909179688,"t":723.0403213500977},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"body","label":"caption","orig":"Table 4. Clinical Trials of Pre-Exposure Prophylaxis","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":727.9337360623781,"coord_origin":"BOTTOMLEFT","l":54.0,"r":311.807,"t":737.8247},"charspan":[0,52],"page_no":1}],"self_ref":"#/texts/0","text":"Table 4. Clinical Trials of Pre-Exposure Prophylaxis"},{"children":[],"content_layer":"body","label":"text","orig":"Key to Acronyms: FTC = emtricitabine; TDF = tenofovir disoproxil fumarate; TFV = tenofovir","parent":{"$ref":"#/groups/0"},"prov":[{"bbox":{"b":366.5682497237569,"coord_origin":"BOTTOMLEFT","l":54.0,"r":382.9252250000004,"t":375.5227},"charspan":[0,90],"page_no":1}],"self_ref":"#/texts/1","text":"Key to Acronyms: FTC = emtricitabine; TDF = tenofovir disoproxil fumarate; TFV = tenofovir"},{"children":[],"content_layer":"body","label":"text","orig":"Source: Adapted from: Kashuba et al., Pre-exposure prophylaxis for HIV prevention: how to predict success: Table Antiretroviral-based HIV prevention studies. Lancet . 2012;379(9835): 2409-2411.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":338.2366933206107,"coord_origin":"BOTTOMLEFT","l":54.0,"r":546.3165000000008,"t":358.5127},"charspan":[0,193],"page_no":1}],"self_ref":"#/texts/2","text":"Source: Adapted from: Kashuba et al., Pre-exposure prophylaxis for HIV prevention: how to predict success: Table Antiretroviral-based HIV prevention studies. Lancet . 2012;379(9835): 2409-2411."},{"children":[],"content_layer":"furniture","la