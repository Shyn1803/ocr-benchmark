    "font" : "Calibri",
    "font size" : 10.998,
    "text color" : "[0.0, 0.0, 0.0]",
    "content" : "Grounded in the author's 30 years of experience as a highly esteemed nurse researcher, the book guides nurses step by step through all aspects of program development."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 50,
