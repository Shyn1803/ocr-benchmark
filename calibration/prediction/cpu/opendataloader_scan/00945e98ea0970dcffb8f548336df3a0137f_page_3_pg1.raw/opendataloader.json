    "page number" : 1,
    "bounding box" : [ 54.667, 122.89, 288.0, 169.89 ],
    "font" : "Arial-BoldMT",
    "font size" : 9.96,
    "text color" : "[0.0]",
    "content" : "will be presented to sufficiently master this equivalence as the relationship between movement, global coordinates, modal coordinates, and modal parameters.  "
  }, {
