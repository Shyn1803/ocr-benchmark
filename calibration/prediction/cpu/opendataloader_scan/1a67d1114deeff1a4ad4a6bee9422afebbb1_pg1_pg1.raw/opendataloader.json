    "font" : "MyriadPro-Light",
    "font size" : 7.5,
    "text color" : "[0.0, 0.0, 0.0, 1.0]",
    "content" : "This figure is adjusted to take into consideration clients whose appeals were withdrawn or who didn’t attend their hearings."
  }, {
    "type" : "paragraph",
