    "type" : "list",
    "pdfua_tag" : "L",
    "level" : "2",
    "page number" : 1,
    "bounding box" : [ 296.495, 114.383, 534.545, 231.873 ],
    "numbering style" : "roman numbers in lower case",
    "number of list items" : 2,
    "list items" : [ {
