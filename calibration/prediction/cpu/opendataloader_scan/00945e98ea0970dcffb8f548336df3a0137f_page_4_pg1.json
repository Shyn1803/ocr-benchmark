      },
      "text": "Frequency",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.7117152379736459,
        "y0": 0.6639822304576608,
        "x1": 0.7285141682177679,
