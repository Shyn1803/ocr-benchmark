    "font size" : 11.04,
    "text color" : "[0.0]",
    "content" : "Other ways to improve peer review include"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 35,
    "page number" : 1,
    "bounding box" : [ 96.0, 627.333, 548.333, 655.0 ],
    "font" : "Calibri",
    "font size" : 11.04,
    "text color" : "[0.0]",
    "content" : "Leverage expertise – review would mirror the way we do science. Collaboration among reviewers to evaluate their area of expertise for each article."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 36,
