      "text": "The meeting was designed to update the steering group on the progress made since the last meeting and to discuss new streams of work for the future of the FQP.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "heading",
      "box": {
        "page": 0,
        "x0": 0.1781045751633987,
        "y0": 0.7609431818181818,
        "x1": 0.5043578431372548,
