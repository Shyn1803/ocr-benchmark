    "font" : "CMR10",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "Proof. First assume R d ( Q ) is spherical. We reduce to the claimed situation in several steps, always using the previous lemma."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 46,
    "level" : "1",
    "page number" : 1,
