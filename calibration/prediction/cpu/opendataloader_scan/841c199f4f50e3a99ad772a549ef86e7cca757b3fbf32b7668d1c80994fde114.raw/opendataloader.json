    "page number" : 1,
    "bounding box" : [ 113.0, 380.333, 549.667, 421.0 ],
    "font" : "Goudy",
    "font size" : 10.2,
    "text color" : "[0.0, 0.0, 0.0, 1.0]",
    "content" : "A Share Option Incentive Plan has been established where employees of the consolidated entity with appropriate seniority and length of service have been issued with options over ordinary shares of Mermaid Marine Australia Limited."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
