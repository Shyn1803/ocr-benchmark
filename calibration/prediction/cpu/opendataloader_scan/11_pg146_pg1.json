        "y0": 0.6,
        "x1": 0.33427323943661974,
        "y1": 0.6264362068965517
      },
      "text": "Part. Lydgate. God that sittls 1n Trlnité,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
