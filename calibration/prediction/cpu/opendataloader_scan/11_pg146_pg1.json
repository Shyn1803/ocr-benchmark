        "y0": 0.6482758620689655,
        "x1": 0.3417830985915493,
        "y1": 0.6637931034482758
      },
      "text": "Alle that lovys of melody,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.12769859154929578,
        "y0": 0.6603448275862069,
        "x1": 0.44694929577464787,
        "y1": 0.6747120689655173
      },
      "text": "Offhevon bllsse God graunte tham perty,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
