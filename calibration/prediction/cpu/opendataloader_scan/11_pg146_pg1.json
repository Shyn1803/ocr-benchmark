        "y0": 0.6241379310344828,
        "x1": 0.36807605633802815,
        "y1": 0.6517241379310346
      },
      "text": "Gyffe thaym grace wel to the, That lystyns me whyle ;",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
