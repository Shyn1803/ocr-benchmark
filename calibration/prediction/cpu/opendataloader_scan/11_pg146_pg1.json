        "y0": 0.754598275862069,
        "x1": 0.952112676056338,
        "y1": 0.7816086206896552
      },
      "text": "Causid the gentill prynce to remeve, siche was Goddes myzte",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
