_span":2,"column_header":false,"end_col_offset_idx":2,"end_row_offset_idx":9,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":0,"start_row_offset_idx":8,"text":"Contract B: Contract C Contract D Contract E Contract G: Contract H:"},{"bbox":{"b":454.6666666666667,"coord_origin":"TOPLEFT","l":128.66666666666666,"r":767.6666666666666,"t":396.6666666666667},"col_span":8,"column_header":false,"end_col_offset_idx":10,"end_row_offset_idx":9,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":2,"start_row_offset_idx":8,"text":"The development of a new European market as a new business objective requires adaptations in the system (in particular registration) . These individually necessary changes in the system are charged only to the bank. Customer ratings are a legal requirement (Basel Il) in case of loan applications Desired changes in the kind of customer data to be stored are implemented regularly: The demands on the system (accountancy; staff and goods economy) do not depend on the strategic direction: Currently the foundation of competence centre in the banking group (for IT with this ITO)."}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":120.9615478515625,"coord_origin":"BOTTOMLEFT","l":49.88563537597656,"r":793.5762939453125,"t":354.5964660644531},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"furniture","label":"page_header","orig":"Appendix C _ Analysis and discussion of case study results","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":496.0,"coord_origin":"BOTTOMLEFT","l":521.6666666666666,"r":785.6666666666666,"t":509.3333333333333},"charspan":[0,58],"page_no":1}],"self_ref":"#/texts/0","text":"Appendix C _ Analysis and discussion of case study results"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Success Factor Category: Environment","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":452.0,"coord_origin":"BOTTOMLEFT","l":55.666666666666664,"r":227.0,"t":466.0},"charspan":[0,36],"page_no":1}],"self_ref":"#/texts/1","text":"Success Factor Category: Environment"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Success Factor: Stable internal environment (strategic direction)","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":432.66666666666663,"coord_origin":"BOTTOMLEFT","l":55.0,"r":335.6666666666667,"t":445.66666666666663},"charspan":[0,65],"page_no":1}],"self_ref":"#/texts/2","text":"Success Factor: Stable internal environment (strategic direction)"},{"children":[],"content_layer":"body","label":"text","orig":"A stable internal environment in terms of strategic direction of the outsourcing bank influences ITO success. Firstly, environmental changes can obviate the need or can change the desire for ITO in general. change in strategic direction against ITO can be caused by a new internal management too: Secondly; environmental stability supports the ability to define stable IT requirements for the lifetime of the ITO contract and thus avoids costly_contractual amendments if possible at all.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":395.33333333333337,"coord_origin":"BOTTOMLEFT","l":55.0,"r":790.3333333333334,"t":428.66666666666663},"charspan":[0,487],"page_no":1}],"self_ref":"#/texts/3","text":"A stable internal environment in terms of strategic direction of the outsourcing bank influences ITO success. Firstly, environmental changes can obviate the need or can change the desire for ITO in general. change in strategic direction against ITO can be caused by a new internal management too: Secondly; environmental stability supports the ability to define stable IT requirements for the lifetime of the ITO contract and thus avoids costly_contractual amendments if possible at all."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Summary of case studies","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":363.33333333333337,"coord_origin":"BOTTOMLEFT","l":55.0,"r":179.0,"t":377.66666666666663},"charspan":[0,23],"page_no":1}],"self_ref":"#/texts/4","text":"Summary of case studies"},{"children":[],"content_layer":"body","label":"text","orig":"In cases C and E the system requirements are not dependent on the strategic objectives of the enterprise; hence; the success factor is not relevant in these cases. In cases A B, D; F, G and H the stability of the strategic enterprise objectives is classified as partly necessary for the achievement of ITO success during the term of the ITO.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":75.0,"coord_origin":"BOTTOMLEFT","l":55.333333333333336,"r":787.0,"t":109.66666666666669},"charspan":[0,341],"page_no":1}],"self_ref":"#/texts/5","text":"In cases C and E the system requirements are not dependent on the strategic objectives of the enterprise; hence; the success factor is not relevant in these cases. In cases A B, D; F, G and H the stability of the strategic enterprise objectives is classified as partly necessary for the achievement of ITO success during the term of the ITO."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"332","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":60.0,"coord_origin":"BOTTOMLEFT","l":410.3333333333333,"r":431.6666666666667,"t":72.0},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/6","text":"332"}],"version":"1.10.0"}