1"}],"schema_name":"DoclingDocument","tables":[],"texts":[{"children":[],"content_layer":"furniture","label":"page_header","orig":"130","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":751.7000122070312,"coord_origin":"BOTTOMLEFT","l":46.666666666666664,"r":66.0,"t":761.7000122070312},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/0","text":"130"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"MATER RES TECHNOL. 2018,7(2).126-134","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":751.0333455403646,"coord_origin":"BOTTOMLEFT","l":223.0,"r":374.6666666666667,"t":760.3666788736979},"charspan":[0,36],"page_no":1}],"self_ref":"#/texts/1","text":"MATER RES TECHNOL. 2018,7(2).126-134"},{"children":[],"content_layer":"body","label":"text","orig":"ferrite phases were distinct. It is however possible to clearly separate the content of phases in the tested composites This suggests that the incorporation ofnano particles in the crystal structure of iron changes its network parameters [22] Fig: 3d shows a homogeneous distribution of TiN in the steel matrix with a general tendency of the reinforcing TiN phase to locate itself at the vicinity of boundaries in the matrix grain","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":648.3666788736979,"coord_origin":"BOTTOMLEFT","l":45.333333333333336,"r":288.3333333333333,"t":730.0333455403646},"charspan":[0,430],"page_no":1}],"self_ref":"#/texts/2","text":"ferrite phases were distinct. It is however possible to clearly separate the content of phases in the tested composites This suggests that the incorporation ofnano particles in the crystal structure of iron changes its network parameters [22] Fig: 3d shows a homogeneous distribution of TiN in the steel matrix with a general tendency of the reinforcing TiN phase to locate itself at the vicinity of boundaries in the matrix grain"},{"children":[],"content_layer":"body","label":"text","orig":"Microstructural examinations from previous studies have shown that the favored sites for the formation of phases are boundaries and the reinforcementmatrix interface [27]. The phase of iron nitride formed in the XRD result (Fig: 2) is obviously due to the diffusion of iron and nitride at the boundary as indicated in the EDS result (Fig: 3b1). It is worthy to state that during the SPS process, non-equilibrium conditions exists in the material, which has a significant influence on diffusion and the reactions taking place during sintering: The formation ofFeNoo68 phasein thestudied compositesis as a result of intense phenomena place during SPS (surface activation, diffusion; surface melting, necking between the particles of sintered powder; and plastic flow [28]). During sintering, mass transport increases and eventually results in grain grain taking","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":487.70001220703125,"coord_origin":"BOTTOMLEFT","l":45.0,"r":289.0,"t":649.7000122070312},"charspan":[0,859],"page_no":1}],"self_ref":"#/texts/3","text":"Microstructural examinations from previous studies have shown that the favored sites for the formation of phases are boundaries and the reinforcementmatrix interface [27]. The phase of iron nitride formed in the XRD result (Fig: 2) is obviously due to the diffusion of iron and nitride at the boundary as indicated in the EDS result (Fig: 3b1). It is worthy to state that during the SPS process, non-equilibrium conditions exists in the material, which has a significant influence on diffusion and the reactions taking place during sintering: The formation ofFeNoo68 phasein thestudied compositesis as a result of intense phenomena place during SPS (surface activation, diffusion; surface melting, necking between the particles of sintered powder; and plastic flow [28]). During sintering, mass transport increases and eventually results in grain grain taking"},{"children":[],"content_layer":"body","label":"caption","orig":"Fig. 4 - Effect of sintering temperature variation on the densification and hardness of DSS 2205-STiN.","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":501.03334554036456,"coord_origin":"BOTTOMLEFT","l":303.0,"r":525.0,"t":524.0333455403645},"charspan":[0,102],"page_no":1}],"self_ref":"#/texts/4","text":"Fig. 4 - Effect of sintering temperature variation on the densification and hardness of DSS 2205-STiN."},{"children":[],"content_layer":"body","label":"text","orig":"99.0","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":720.0333455403646,"coord_origin":"BOTTOMLEFT","l":321.0,"r":334.3333333333333,"t":726.7000122070312},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/5","text":"99.0"},{"children":[],"content_layer":"body","label":"text","orig":"Density","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":711.0333455403646,"coord_origin":"BOTTOMLEFT","l":484.6666666666667,"r":506.6666666666667,"t":719.0333455403646},"charspan":[0,7],"page_no":1}],"self_ref":"#/texts/6","text":"Density"},{"children":[],"content_layer":"body","label":"text","orig":"Hardness","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":703.3666788736979,"coord_origin":"BOTTOMLEFT","l":485.0,"r":512.3333333333334,"t":710.0333455403646},"charspan":[0,8],"page_no":1}],"self_ref":"#/texts/7","text":"Hardness"},{"children":[],"content_layer":"body","label":"text","orig":"295","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":705.3666788736979,"coord_origin":"BOTTOMLEFT","l":519.0,"r":530.3333333333334,"t":712.0333455403646},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/8","text":"295"},{"children":[],"content_layer":"body","label":"text","orig":"98.0","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":672.0333455403646,"coord_origin":"BOTTOMLEFT","l":321.0,"r":334.3333333333333,"t":678.0333455403646},"charspan":[0,4],"page_no":1}],"self_ref":"#/texts/9","text":"98.0"},{"children":[],"content_layer":"body","label":"text","orig":"290","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":674.0333455403646,"coord_origin":"BOTTOMLEFT","l":519.0,"r":530.3333