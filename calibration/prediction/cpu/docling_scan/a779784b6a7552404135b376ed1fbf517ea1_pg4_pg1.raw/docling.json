igin":"BOTTOMLEFT","l":163.0,"r":541.6666666666666,"t":187.0},"charspan":[0,400],"page_no":1}],"self_ref":"#/texts/54","text":"William has been selected to represent WA in the upcoming All Australian Basketball Tour to USA. He will participate in several competitions on the West Coast of America and play against some of the best USA College Basketball Teams: The tour takes in LA, San Las Vegas and Phoenix and will last from 28th Nov to 23d Dec: Well done William and good luck for the Tour. We are very proud of you: Diego,"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"HAVE YOUR SAY ON PUBLIC TRANSPORT IN YOUR LOCAL COMMUNITY ADVANCING PERTHS EASTERN REGION","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":98.66666666666663,"coord_origin":"BOTTOMLEFT","l":171.66666666666666,"r":531.3333333333334,"t":121.0},"charspan":[0,89],"page_no":1}],"self_ref":"#/texts/55","text":"HAVE YOUR SAY ON PUBLIC TRANSPORT IN YOUR LOCAL COMMUNITY ADVANCING PERTHS EASTERN REGION"},{"children":[],"content_layer":"body","label":"text","orig":"Seven Public Transport Forums are being held across the region during October and November 2010. These forums aim to engage and encourage the community to become more aware of the vision for increased transport and the options and delivery modes that exist. You can register by contacting Samantha Robshaw on email samantha robshaw@emrc org au public","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":51.0,"coord_origin":"BOTTOMLEFT","l":159.66666666666666,"r":544.3333333333334,"t":98.66666666666663},"charspan":[0,350],"page_no":1}],"self_ref":"#/texts/56","text":"Seven Public Transport Forums are being held across the region during October and November 2010. These forums aim to engage and encourage the community to become more aware of the vision for increased transport and the options and delivery modes that exist. You can register by contacting Samantha Robshaw on email samantha robshaw@emrc org au public"}],"version":"