        "y0": 0.7781609195402298,
        "x1": 0.9314553990610329,
        "y1": 0.7954022988505747
      },
      "text": "Lowe, how the good Lorde hls owne gentill kuyzle,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
