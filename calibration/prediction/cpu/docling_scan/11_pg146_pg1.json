        "y0": 0.7545977011494254,
        "x1": 0.952112676056338,
        "y1": 0.7816091954022988
      },
      "text": "Causid the gentill prynce to remeve, siche was Goddes myzte",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
