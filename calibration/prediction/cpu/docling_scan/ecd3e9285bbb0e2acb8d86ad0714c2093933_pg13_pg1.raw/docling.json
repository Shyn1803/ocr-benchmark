 daily topical TFV gel"},{"bbox":{"b":413.0,"coord_origin":"TOPLEFT","l":363.0,"r":461.0,"t":287.3333333333333},"col_span":1,"column_header":false,"end_col_offset_idx":5,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":4,"start_row_offset_idx":4,"text":"No study drug significantly reduced the risk of HIV acquisition: Estimates of effectiveness were less than 0 for TDF and TDFI FTC daily oral (negative 48.8% and negative 4.2% TDFIFTC respectively) , and reduced risk of HIV infection of 14.7% for TDF gel. dosing"},{"bbox":{"b":368.3333333333333,"coord_origin":"TOPLEFT","l":466.3333333333333,"r":553.3333333333334,"t":287.6666666666667},"col_span":1,"column_header":false,"end_col_offset_idx":6,"end_row_offset_idx":5,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":5,"start_row_offset_idx":4,"text":"Adherence to study drugs was TFV was detected in 30% of the oral TDF arm, 29% in the oral TDFIFTC arm, and 25% in the TDF gel arm. low;"}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":378.06085205078125,"coord_origin":"BOTTOMLEFT","l":52.706485748291016,"r":559.0831909179688,"t":723.0403213500977},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"body","label":"caption","orig":"Table 4. Clinical Trials of Pre-Exposure Prophylaxis","parent":{"$ref":"#/tables/0"},"prov":[{"bbox":{"b":724.6666666666666,"coord_origin":"BOTTOMLEFT","l":52.666666666666664,"r":314.0,"t":740.6666666666666},"charspan":[0,52],"page_no":1}],"self_ref":"#/texts/0","text":"Table 4. Clinical Trials of Pre-Exposure Prophylaxis"},{"children":[],"content_layer":"body","label":"text","orig":"to Acronyms: FTC = emtricitabine; TDF = tenofovir disoproxil fumarate; TFV = tenofovir","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":363.6666666666667,"coord_origin":"BOTTOMLEFT","l":69.0,"r":385.6666666666667,"t":3