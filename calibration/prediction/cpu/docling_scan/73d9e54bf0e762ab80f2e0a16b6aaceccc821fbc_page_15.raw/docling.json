":379.3333333333333,"t":613.0343221028646},"charspan":[0,9],"page_no":1}],"self_ref":"#/texts/26","text":"analytics"},{"children":[],"content_layer":"body","label":"text","orig":"tracking services","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":603.7009887695312,"coord_origin":"BOTTOMLEFT","l":407.6666666666667,"r":468.3333333333333,"t":614.3676554361979},"charspan":[0,17],"page_no":1}],"self_ref":"#/texts/27","text":"tracking services"},{"children":[],"content_layer":"body","label":"text","orig":"This is the case of profiling cookies.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":532.7009887695312,"coord_origin":"BOTTOMLEFT","l":49.666666666666664,"r":287.3333333333333,"t":557.7009887695312},"charspan":[0,38],"page_no":1}],"self_ref":"#/texts/28","text":"This is the case of profiling cookies."},{"children":[],"content_layer":"body","label":"text","orig":"However, such guidelines are not part of the ePrivacy Directive. Hence; the definition of a \"necessary element to offer service is subject to interpretation by National Data Protection Authorities. We illustrate different  approaches in Table 4, based on different defini tions of necessary cookie_ Helped by Opinion 04/2012, we identify four types of cookies; represented as columns in the table. Starting from the left, are sorted from the most to the least likely to be necessary.  Indeed, first-party cookies are very likely to be necessary (e.g.= for authentication) , while profiling cookies; installed by e.g., behavioral advertising platforms; are very far from essential. We then formalize five different inter pretations of the ePrivacy Directive that differ in the type of cookies subject to consent. The most permissive approach (A) represents the extreme scenario where no cookie is subject to consent, that clearly breaks the spirit of the Directive. On the opposite side, the approach (E) represents the strictest interpretation; which mandates that all cookies need prior consent . In this work; we ver ify the compliance to the interpretation (B), which is the most tolerant approach that mandates consent for some kind of unnecessary cookies. According to (B), only procookies need prior users's consent, while all others do not. Thus, our definition of violations becomes very conservative we prefer to neglect some violations; than to incur false positives. they being filing","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":182.03432210286462,"coord_origin":"BOTTOMLEFT","l":49.0,"r":289.3333333333333,"t":533.367655436198},"charspan":[0,1495],"page_no":1}],"self_ref":"#/texts/29","text":"However, such guidelines are not part of the ePrivacy Directive. Hence; the definition of a \"necessary element to offer service is subject to interpretation by National Data Protection Authorities. We illustrate different  approaches in Table 4, based on different defini tions of necessary cookie_ Helped by Opinion 04/2012, we identify four types of cookies; represented as columns in the table. Starting from the left, are sorted from the most to the least likely to be necessary.  Indeed, first-party cookies are very likely to be necessary (e.g.= for authentication) , while profiling cookies; installed by e.g., behavioral advertising platforms; are very far from essential. We then formalize five different inter pretations of the ePrivacy Directive that differ in the type of cookies subject to consent. The most permissive approach (A) represents the extreme scenario where no cookie is subject to consent, that clearly breaks the spirit of the Directive. On the opposite side, the approach (E) represents the strictest interpretation; which mandates that all cookies need prior consent . In this work; we ver ify the compliance to the interpretation (B), which is the most tolerant approach that mandates consent for some kind of unnecessary cookies. According to (B), only procookies need prior users's consent, while all others do not. Thus, our definition of violations becomes very conservative we prefer to neglect some violations; than to incur false positives. they being filing"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"7.2.2 Transposition into national legislation","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":142.70098876953125,"coord_origin":"BOTTOMLEFT","l":50.0,"r":242.33333333333334,"t":154.70098876953125},"charspan":[0,45],"page_no":1}],"self_ref":"#/texts/30","text":"7.2.2 Transposition into national legislation"},{"children":[],"content_layer":"body","label":"text","orig":"The European regulatory landscape is not homogeneous All EU MSs must transpose EU Directives into their islation as a minimum level of harmonization. As such, EU MSs have transposed the ePrivacy Directive in difleg- ferent ways [44, 56]. For the sake of simplification; we group such transpositions into three categories. A graphical representation of ePrivacy Directive interpretations (and EU MSs of application) is provided in Figure 12.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":77.36765543619788,"coord_origin":"BOTTOMLEFT","l":49.333333333333336,"r":289.0,"t":129.70098876953125},"charspan":[0,215],"page_no":1},{"bbox":{"b":231.36765543619788,"coord_origin":"BOTTOMLEFT","l":295.6666666666667,"r":536.0,"t":284.70098876953125},"charspan":[216,440],"page_no":1}],"self_ref":"#/texts/31","text":"The European regulatory landscape is not homogeneous All EU MSs must transpose EU Directives into their islation as a minimum level of harmonization. As such, EU MSs have transposed the ePrivacy Directive in difleg- ferent ways [44, 56]. For the sake of simplification; we group such transpositions into three categories. A graphical representation of ePrivacy Directive interpretations (and EU MSs of application) is provided in Figure 12."},{"children":[],"content_layer":"body","label":"caption","orig":"12. ePrivacy Directive transposition into EU MSs legislation Fig:","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":315.07984212482955,"coo