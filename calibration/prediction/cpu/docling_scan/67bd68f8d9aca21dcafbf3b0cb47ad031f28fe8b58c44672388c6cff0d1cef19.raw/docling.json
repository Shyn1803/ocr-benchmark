333333333,"r":430.3333333333333,"t":287.0},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/34","text":"Event"},{"children":[],"content_layer":"body","label":"text","orig":"No Expansion Enclosures","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":264.0,"coord_origin":"BOTTOMLEFT","l":217.33333333333334,"r":283.6666666666667,"t":272.0},"charspan":[0,23],"page_no":1}],"self_ref":"#/texts/35","text":"No Expansion Enclosures"},{"children":[],"content_layer":"body","label":"text","orig":"No Expansion Enclosures","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":264.0,"coord_origin":"BOTTOMLEFT","l":416.0,"r":482.6666666666667,"t":272.0},"charspan":[0,23],"page_no":1}],"self_ref":"#/texts/36","text":"No Expansion Enclosures"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"4.4 Configuring user authentication","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":193.0,"coord_origin":"BOTTOMLEFT","l":63.666666666666664,"r":341.0,"t":215.0},"charspan":[0,35],"page_no":1}],"self_ref":"#/texts/37","text":"4.4 Configuring user authentication"},{"children":[],"content_layer":"body","label":"text","orig":"There are two methods of user authentication to control access to the GUI and to the CLI:","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":170.0,"coord_origin":"BOTTOMLEFT","l":136.0,"r":534.0,"t":180.66666666666663},"charspan":[0,89],"page_no":1}],"self_ref":"#/texts/38","text":"There are two methods of user authentication to control access to the GUI and to the CLI:"},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"Local authentication is performed within the Storwize V7OOO system. Local GUI authentication is done with user name and password. Local CLI authentication is done either with an SSH public or a user name and password. key","parent":{"$ref":"#/groups/1"},"prov":[{"bbox":{"b":126.38197612049339,"coord_origin":"BOTTOMLEFT","l":149.33333333333334,"r":533.6666666666666,"t":165.33333333333337},"charspan":[0,221],"page_no":1}],"self_ref":"#/texts/39","text":"Local authentication is performed within the Storwize V7OOO system. Local GUI authentication is done with user name and password. Local CLI authentication is done either with an SSH public or a user name and password. key"},{"children":[],"content_layer":"body","enumerated":false,"label":"list_item","marker":"","orig":"Remote authentication allows users to authenticate to the system using credentials stored on an external authentication service.  This feature allows you to use user credentials and user groups defined on the remote service to simplify user management and access; enforce password policies more efficiently; and separate user management from storage management.","parent":{"$ref":"#/groups/1"},"prov":[{"bbox":{"b":61.66666666666663,"coord_origin":"BOTTOMLEFT","l":150.33333333333334,"r":546.3333333333334,"t":124.0},"charspan":[0,361],"page_no":1}],"self_ref":"#/texts/40","text":"Remote authentication allows users to authenticate to the system using credentials stored on an external authentication service.  This feature allows you to use user credentials and user groups defined on the remote service to simplify user management and access; enforce password policies more efficiently; and separate user management from storage management."},{"children":[],"content_layer":"furniture","label":"page_footer","orig":"108 Implementing the IBM Storwize V7OOO with IBM Spectrum Virtualize V8.2.1","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":25.66666666666663,"coord_origin":"BOTTOMLEFT","l":64.0,"r":410.3333333333333,"t":39.33333333333337},"charspan":[0,75],"page_no":1}],"self_ref":"#/texts/41","text":"108 Implementing the IBM Storwize V7OOO with IBM Spectrum Virtualize V8.2.1"}],"version":"1.10.0"}