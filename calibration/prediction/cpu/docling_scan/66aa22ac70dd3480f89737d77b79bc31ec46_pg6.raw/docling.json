666667},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/10","text":"0,238"},{"children":[],"content_layer":"body","label":"text","orig":"Organizational culture","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":405.6666666666667,"coord_origin":"BOTTOMLEFT","l":154.66666666666666,"r":246.66666666666666,"t":419.6666666666667},"charspan":[0,22],"page_no":1}],"self_ref":"#/texts/11","text":"Organizational culture"},{"children":[],"content_layer":"body","label":"text","orig":"Based on the calculation of the correlation coefficient and the criteria for the relationship between the independent variables, the following results show that the relationship between the Competency variable and the Organizational Culture variable is obtained with a coefficient value of 0.238. Thus it can be said that the relationship between the two variables is in the low category.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":318.6666666666667,"coord_origin":"BOTTOMLEFT","l":69.66666666666667,"r":542.3333333333334,"t":368.3333333333333},"charspan":[0,388],"page_no":1}],"self_ref":"#/texts/12","text":"Based on the calculation of the correlation coefficient and the criteria for the relationship between the independent variables, the following results show that the relationship between the Competency variable and the Organizational Culture variable is obtained with a coefficient value of 0.238. Thus it can be said that the relationship between the two variables is in the low category."},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"5.3 Proposed Improvements","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":295.3333333333333,"coord_origin":"BOTTOMLEFT","l":71.0,"r":205.66666666666666,"t":309.3333333333333},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/13","text":"5.3 Proposed Improvements"},{"children":[],"content_layer":"body","label":"text","orig":"The overall description of the answers regarding employee organizational culture gives a high average organizational culture variable; which means that organizational culture consisting of the dimensions of involvement; consistency; adaptability and mission are interpreted as high criteria. Of these dimensions; the Consistency dimension provides the highest contribution; while the Involvement dimension provides the weakest contribution. Even though it has criteria, there is still a low indicator, namely adaptability . Therefore; this is one of the factors that must be addressed. The discussion of the results of this research is enriched by the views of relevant experts in the field of the relationship between employee competence and organizational culture provide an in-depth look at the impact; challenges and implications of these relationships in the 2lst century workforce: Following are some expert opinions that can support the discussion of research results: 1) Edgar H. Schein (2010): In Schein's view; organizational culture is software that guides behavior within the organization. In the context of the results of this research, this approach supports the understanding of how an organizational culture that supports learning and innovation can help develop employee competencies. Schein views that an organization that has a culture that encourages individual competence will create productive work environment. 2) Peter F Drucker (1999): Drucker highlighted  the importance of strong They","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":76.66666666666663,"coord_origin":"BOTTOMLEFT","l":69.66666666666667,"r":542.3333333333334,"t":230.0},"charspan":[0,1511],"page_no":1}],"self_ref":"#/texts/14","text":"The overall description of the answers regarding employee organizational culture gives a high average organizational culture variable; which means that organizational culture consisting of the dimensions of involvement; consistency; adaptability and mission are interpreted as high criteria. Of these dimensions; the Consistency dimension provides the highest contribution; while the Involvement dimension provides the weakest contribution. Even though it has criteria, there is still a low indicator, namely adaptability . Therefore; this is one of the factors that must be addressed. The discussion of the results of this research is enriched by the views of relevant experts in the field of the relationship between employee competence and organizational culture provide an in-depth look at the impact; challenges and implications of these relationships in the 2lst century workforce: Following are some expert opinions that can support the discussion of research results: 1) Edgar H. Schein (2010): In Schein's view; organizational culture is software that guides behavior within the organization. In the context of the results of this research, this approach supports the understanding of how an organizational culture that supports learning and innovation can help develop employee competencies. Schein views that an organization that has a culture that encourages individual competence will create productive work environment. 2) Peter F Drucker (1999): Drucker highlighted  the importance of strong They"},{"children":[],"content_layer":"body","label":"text","orig":"The overall description of the answers regarding employee competence gives an average value of high employee competency variables; which means that employee competence which consists of the dimensions ofknowledge; skills, self-concept and values; personal characteristics and motives is interpreted in high criteria. Of these dimensions; the contribution: Even though it has high criteria; there are still low indicators; namely employee competence indicators_ Therefore, this is one of the factors that must be addressed.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":227.66666666666663,"coord_origin":"BOTTOMLEFT","l":70.0,"r":542.0,"t":298.0},"charspan":[0,522],"page_no":1}],"self_ref":"#/texts/15","text":"The overall description of the answers regarding employee competence gives an average value of high employee competency variables; which means that employee competence which consists of the dimensions ofknowledge; skills, self-concept and values; personal characteristics and motives is interpreted in high criteria. Of these dimensions; the contribution: Even though it has high criteria; there are still low indicators; namely employee competence indicators_ Therefore, this is one of the factors that must be addressed."}],"version":"1.10.0"}