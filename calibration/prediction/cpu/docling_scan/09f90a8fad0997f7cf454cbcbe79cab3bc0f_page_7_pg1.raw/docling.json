:"TOPLEFT","l":412.6666666666667,"r":428.0,"t":118.66666666666667},"col_span":1,"column_header":false,"end_col_offset_idx":2,"end_row_offset_idx":3,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":1,"start_row_offset_idx":2,"text":"127"},{"bbox":{"b":159.33333333333334,"coord_origin":"TOPLEFT","l":323.3333333333333,"r":395.3333333333333,"t":140.0},"col_span":1,"column_header":false,"end_col_offset_idx":1,"end_row_offset_idx":4,"fillable":false,"row_header":true,"row_section":false,"row_span":1,"start_col_offset_idx":0,"start_row_offset_idx":3,"text":"Incorrect answers KB-based)"},{"bbox":{"b":149.33333333333334,"coord_origin":"TOPLEFT","l":458.6666666666667,"r":470.0,"t":140.0},"col_span":1,"column_header":false,"end_col_offset_idx":3,"end_row_offset_idx":4,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":2,"start_row_offset_idx":3,"text":"38"},{"bbox":{"b":149.33333333333334,"coord_origin":"TOPLEFT","l":497.3333333333333,"r":526.6666666666666,"t":140.0},"col_span":1,"column_header":false,"end_col_offset_idx":4,"end_row_offset_idx":4,"fillable":false,"row_header":false,"row_section":false,"row_span":1,"start_col_offset_idx":3,"start_row_offset_idx":3,"text":"90.04%"}]},"footnotes":[],"label":"table","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":628.9411010742188,"coord_origin":"BOTTOMLEFT","l":315.4969787597656,"r":539.4703369140625,"t":721.5316619873047},"charspan":[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/1"}],"texts":[{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"5 Evaluation","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":707.0,"coord_origin":"BOTTOMLEFT","l":71.33333333333333,"r":156.33333333333334,"t":719.6666666666666},"charspan":[0,12],"page_no":1}],"self_ref":"#/texts/0","text":"5 Evaluation"},{"children":[],"content_layer":"body","label":"text","orig":"Both qualitative and quantitative evaluation of the integration of surface text-based and knowledgebased methods for Q/A is imposed. Quantitatively; Table 3 summarizes the scores obtained when only shallow methods were employed, in contrast with the results when knowledge-based methods were integrated. We have separately measured the effect of the integration of the knowledge-based methods at question processing and answer processing level. We have also evaluated the precision of the SyS tem when both integrations were implemented. The results were the first five answers returned within 250 bytes of text, when approximatively half million TREC documents are mined. We have used the 200 questions from TREC-8, and the correct answers provided by NIST. The performance was measured both with the NIST scoring method employed in the TREC-8 and by simply assigning a score of 1 for the question having a correct answer, regardless of its position.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":477.0,"coord_origin":"BOTTOMLEFT","l":69.66666666666667,"r":299.0,"t":705.0},"charspan":[0,951],"page_no":1}],"self_ref":"#/texts/1","text":"Both qualitative and quantitative evaluation of the integration of surface text-based and knowledgebased methods for Q/A is imposed. Quantitatively; Table 3 summarizes the scores obtained when only shallow methods were employed, in contrast with the results when knowledge-based methods were integrated. We have separately measured the effect of the integration of the knowledge-based methods at question processing and answer processing level. We have also evaluated the precision of the SyS tem when both integrations were implemented. The results were the first five answers returned within 250 bytes of text, when approximatively half million TREC documents are mined. We have used the 200 questions from TREC-8, and the correct answers provided by NIST. The performance was measured both with the NIST scoring method employed in the TREC-8 and by simply assigning a score of 1 for the question having a correct answer, regardless of its position."},{"children":[],"content_layer":"body","label":"caption","orig":"Table 3: Accuracy performance","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":303.6666666666667,"coord_origin":"BOTTOMLEFT","l":115.0,"r":254.33333333333334,"t":317.0},"charspan":[0,29],"page_no":1}],"self_ref":"#/texts/2","text":"Table 3: Accuracy performance"},{"children":[],"content_layer":"body","label":"text","orig":"Percentage of","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":466.0,"coord_origin":"BOTTOMLEFT","l":180.66666666666666,"r":237.66666666666666,"t":478.0},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/3","text":"Percentage of"},{"children":[],"content_layer":"body","label":"text","orig":"NIST score","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":467.3333333333333,"coord_origin":"BOTTOMLEFT","l":247.33333333333334,"r":294.0,"t":477.3333333333333},"charspan":[0,10],"page_no":1}],"self_ref":"#/texts/4","text":"NIST score"},{"children":[],"content_layer":"body","label":"text","orig":"correct answers","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":457.3333333333333,"coord_origin":"BOTTOMLEFT","l":173.0,"r":236.66666666666666,"t":466.3333333333333},"charspan":[0,15],"page_no":1}],"self_ref":"#/texts/5","text":"correct answers"},{"children":[],"content_layer":"body","label":"text","orig":"in top","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":446.0,"coord_origin":"BOTTOMLEFT","l":171.33333333333334,"r":197.33333333333334,"t":456.0},"charspan":[0,6],"page_no":1}],"self_ref":"#/texts/6","text":"in top"},{"children":[],"content_layer":"body","label":"text","orig":"5 returns","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":447.3333333333333,"coord_origin":"BOTTOMLEFT","l":199.33333333333334,"r":237.33333333333334,"t":455.3333333333333},"charspan":[0,9],"page_no":1}],"self_ref":"#/texts/7","text":"5 returns"},{"children":[],"content_layer":"body","label":"text","orig":"Text-surface-based","parent":{"$ref":"#/pictures/0"},"pro