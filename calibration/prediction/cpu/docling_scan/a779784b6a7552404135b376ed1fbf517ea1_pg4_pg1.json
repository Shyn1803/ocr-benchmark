    {
      "block_type": "heading",
      "box": {
        "page": 0,
        "x0": 0.4788145795298728,
        "y0": 0.7462391132224862,
        "x1": 0.7924241286956375,
        "y1": 0.7794932699920823
      },
      "text": "STUDENT CONGRATULATIONS William Edge Year IILaurencel",
      "html": null,
      "level": 1,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.27384833846796236,
        "y0": 0.7779097387173397,
        "x1": 0.9100277096327991,
        "y1": 0.8479809976247031
      },
      "text": "William has been selected to represent WA in the upcoming All Australian Basketball Tour to USA. He will participate in several competitions on the West Coast of America and play against some of the best USA College Basketball Teams: The tour takes in LA, San Las Vegas and Phoenix and will last from 28th Nov to 23d Dec: Well done William and good luck for the Tour. We are very proud of you: Diego,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "heading",
      "box": {
        "page": 0,
        "x0": 0.2884087818220871,
        "y0": 0.8562945368171021,
        "x1": 0.8926671810182658,
        "y1": 0.882818685669042
      },
      "text": "HAVE YOUR SAY ON PUBLIC TRANSPORT IN YOUR LOCAL COMMUNITY ADVANCING PERTHS EASTERN REGION",
      "html": null,
      "level": 1,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.26824816794714507,
        "y0": 0.882818685669042,
        "x1": 0.914507846049453,
        "y1": 0.9394299287410927
      },
      "text": "Seven Public Transport Forums are being held across the region during October and November 2010. These forums aim to engage and encourage the community to become more aware of the vision for increased transport and the options and delivery modes that exist. You can register by contacting Samantha Robshaw on email samantha robshaw@emrc org au public",
      "html": null,
      "level": null,
      "section_hierarchy": []
    }
