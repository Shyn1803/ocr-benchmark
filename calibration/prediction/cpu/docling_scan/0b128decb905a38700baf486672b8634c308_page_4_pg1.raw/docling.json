:[0,0],"page_no":1}],"references":[],"self_ref":"#/tables/0"}],"texts":[{"children":[],"content_layer":"furniture","label":"page_header","orig":"| 5 2","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":289.0,"coord_origin":"BOTTOMLEFT","l":8.880743041200011,"r":18.666666666666668,"t":411.0},"charspan":[0,5],"page_no":1}],"self_ref":"#/texts/0","text":"| 5 2"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"Circulation Research","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":741.6666666666666,"coord_origin":"BOTTOMLEFT","l":71.33333333333333,"r":162.33333333333334,"t":752.3333333333334},"charspan":[0,20],"page_no":1}],"self_ref":"#/texts/1","text":"Circulation Research"},{"children":[],"content_layer":"furniture","label":"page_header","orig":"September 20, 2002","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":739.3333333333334,"coord_origin":"BOTTOMLEFT","l":179.33333333333334,"r":267.6666666666667,"t":753.0},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/2","text":"September 20, 2002"},{"children":[],"content_layer":"body","label":"section_header","level":1,"orig":"Effect of Treatment With SB 242784 on Soft Tissue Calcification in Rats Treated With Vitamin D","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":709.6666666666666,"coord_origin":"BOTTOMLEFT","l":46.0,"r":398.0,"t":720.0},"charspan":[0,94],"page_no":1}],"self_ref":"#/texts/3","text":"Effect of Treatment With SB 242784 on Soft Tissue Calcification in Rats Treated With Vitamin D"},{"children":[],"content_layer":"body","label":"text","orig":"Seven-week-old male rats received subcutaneous injections of 500'000 IU of vitamin Dlkg body wt at t=0, 24, and 48 hours. Subsets of these animals were also injected with either 10 or 40 mg SB 242784/kg body wt per beginning at 2 days before the first injection of vitamin D. Animals were killed 96 hours after the first vitamin D injection; and the abdominal aorta; one kidney, the lungs; and an anatomically uniform 1 cm of trachea were ashed (see Materials and Methods for further details) . The ashed tissues were extracted with acid to dissolve minerals, and each acid extract was analyzed for calcium as described in Materials and tissues analyzed.  Therefore; the increase in calcium content seen in the tissues from the vitamin D treatment group cannot be due to changes in the size or mass day","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":565.6666666666666,"coord_origin":"BOTTOMLEFT","l":45.333333333333336,"r":540.6666666666666,"t":626.3333333333334},"charspan":[0,802],"page_no":1}],"self_ref":"#/texts/4","text":"Seven-week-old male rats received subcutaneous injections of 500'000 IU of vitamin Dlkg body wt at t=0, 24, and 48 hours. Subsets of these animals were also injected with either 10 or 40 mg SB 242784/kg body wt per beginning at 2 days before the first injection of vitamin D. Animals were killed 96 hours after the first vitamin D injection; and the abdominal aorta; one kidney, the lungs; and an anatomically uniform 1 cm of trachea were ashed (see Materials and Methods for further details) . The ashed tissues were extracted with acid to dissolve minerals, and each acid extract was analyzed for calcium as described in Materials and tissues analyzed.  Therefore; the increase in calcium content seen in the tissues from the vitamin D treatment group cannot be due to changes in the size or mass day"},{"children":[],"content_layer":"body","label":"text","orig":"Data are mean+SD, n=4, for all groups.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":546.3333333333334,"coord_origin":"BOTTOMLEFT","l":54.0,"r":182.0,"t":555.6666666666666},"charspan":[0,38],"page_no":1}],"self_ref":"#/texts/5","text":"Data are mean+SD, n=4, for all groups."},{"children":[],"content_layer":"body","label":"text","orig":"*P=0.06 compared with vitamin D only.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":536.0,"coord_origin":"BOTTOMLEFT","l":53.666666666666664,"r":177.33333333333334,"t":546.0},"charspan":[0,37],"page_no":1}],"self_ref":"#/texts/6","text":"*P=0.06 compared with vitamin D only."},{"children":[],"content_layer":"body","label":"text","orig":"#P=0.063 compared with vitamin D only.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":516.0,"coord_origin":"BOTTOMLEFT","l":53.666666666666664,"r":182.0,"t":526.0},"charspan":[0,38],"page_no":1}],"self_ref":"#/texts/7","text":"#P=0.063 compared with vitamin D only."},{"children":[],"content_layer":"body","label":"text","orig":"SP=0.0003 compared with vitamin D only.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":506.0,"coord_origin":"BOTTOMLEFT","l":54.0,"r":187.33333333333334,"t":516.0},"charspan":[0,39],"page_no":1}],"self_ref":"#/texts/8","text":"SP=0.0003 compared with vitamin D only."},{"children":[],"content_layer":"body","label":"text","orig":"IlP=0.023 compared with vitamin D only.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":496.0,"coord_origin":"BOTTOMLEFT","l":54.0,"r":181.33333333333334,"t":506.0},"charspan":[0,39],"page_no":1}],"self_ref":"#/texts/9","text":"IlP=0.023 compared with vitamin D only."},{"children":[],"content_layer":"body","label":"text","orig":"control animals (Table) Calcium levels measured on serum obtained 96 hours after the first vitamin D injection were as (n=4), 14.0+0.9 for rats treated vitamin D plus the dose of SB 242784 (n=4) (P>0.5 versus vitamin with vitamin D plus the versus vitamin D alone), and 10.9+0.3 for untreated control mgldL with 10-mg 40-mg mg/dL","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":390.3333333333333,"coord_origin":"BOTTOMLEFT","l":45.333333333333336,"r":282.6666666666667,"t":483.3333333333333},"charspan":[0,329],"page_no":1}],"self_ref":"#/texts/10","text":"control animals (Table) Calcium levels measured on serum obtained 96 hours after the first vitamin D injection were as (n=4), 14.0+0.9 for rats treated vitamin D plus the dose of SB 242784 (n=4) (P>0.5 versus vitamin with vitamin D plus the versus vitamin D alone), and 10.9+0.3 for untreated control mgldL with 10-mg 40-mg mg/dL"},{"children":[],"content_layer":"body","label":"text","orig":"To confirm that SB 242784 did in fact inhibit bone resorption at the doses used in the above experiments; serum samples  obtained at death were analyzed to determine the level of cross-linked N-teleopeptides; specific marker for bone resorption activity that is released the osteoclast mediated breakdown of bone matrix collagen. As seen in Figure 4, the level of cross-linked N-teleopeptides was elevated by 140% in rats treated with vitamin D alone and was   reduced to below control levels in rats treated with vitamin D plus the higher dose of SB 242784. This result during arterial calcification   by accelerating bone   resorption and shows that SB 242784 treatment dose-dependently inhibits bone resorption activity in the vitamin D-treated rat.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":261.33333333333337,"coord_origin":"BOTTOMLEFT","l":44.666666666666664,"r":283.3333333333333,"t":378.3333333333333},"charspan":[0,577],"page_no":1},{"bbox":{"b":436.0,"coord_origin":"BOTTOMLEFT","l":303.6666666666667,"r":541.0,"t":472.6666666666667},"charspan":[578,752],"page_no":1}],"self_ref":"#/texts/11","text":"To confirm that SB 242784 did in fact inhibit bone resorption at the doses used in the above experiments; serum samples  obtained at death were analyzed to determine the level of cross-linked N-teleopeptides; specific marker for bone resorption activity that is released the osteoclast mediated breakdown of bone matrix collagen. As seen in Figure 4, the level of cross-linked N-teleopeptides was elevated by 140% in rats treated with vitamin D alone and was   reduced to below control levels in rats treated with vitamin D plus the higher dose of SB 242784. This result during arterial calcification   by accelerating bone   resorption and shows that SB 242784 treatment dose-dependently inhibits bone resorption activity in the vitamin D-treated rat."},{"children":[],"content_layer":"body","label":"text","orig":"The effect of SB 242784 on arterial calcification was also examined in rats treated with warfarin, treatment that inactivates the calcification-inhibitory activity of matrix Gla protein and thereby induces calcification of arteries and cartilage. In the first experiment; weanling rats were treated for week with warfarin alone or with warfarin plus 10 mg SB 242784/kg per This   experiment showed that  the dose of SB 242784 did not significantly inhibit arterial calcification as assessed by alizarin red staining. Subsequent analysis of bone resorption activity the  cross-linked N-teleopeptide   assay showed that   the dose of SB 242784 also did not  significantly   reduce bone resorption activity in the warfarin-treated  rats. When this experiment was repeated at the higher dose (40 mg/kg per of SB 242784, we observed that the strongly inhibited arterial rapid day . 10-mg using 10-mg day) drug","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":260.05130140314554,"coord_origin":"BOTTOMLEFT","l":303.0,"r":541.6666666666666,"t":436.6666666666667},"charspan":[0,904],"page_no":1}],"self_ref":"#/texts/12","text":"The effect of SB 242784 on arterial calcification was also examined in rats treated with warfarin, treatment that inactivates the calcification-inhibitory activity of matrix Gla protein and thereby induces calcification of arteries and cartilage. In the first experiment; weanling rats were treated for week with warfarin alone or with warfarin plus 10 mg SB 242784/kg per This   experiment showed that  the dose of SB 242784 did not significantly inhibit arterial calcification as assessed by alizarin red staining. Subsequent analysis of bone resorption activity the  cross-linked N-teleopeptide   assay showed that   the dose of SB 242784 also did not  significantly   reduce bone resorption activity in the warfarin-treated  rats. When this experiment was repeated at the higher dose (40 mg/kg per of SB 242784, we observed that the strongly inhibited arterial rapid day . 10-mg using 10-mg day) drug"},{"children":[],"content_layer":"body","label":"caption","orig":"Figure 4. Effect of SB 242784 on bone resorption activity as measured by serum cross-linked N-teleopeptides. Serum was obtained from each animal 96 hours after the first vitamin D injection in the experiment described in the Figure legend, and serum was also obtained from age-matched control rats. Each serum sample was analyzed to determine the level of cross-linked N-teleopeptides (OSTEOMARK NTx, Ostex) , specific marker for bone resorption activity (see Materials and Methods). Results are presented as meanSD a, P<0.01 compared with control; b, P<0.05 compared with vitamin D only; and c, P<0.0O1 compared with vitamin D only.","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":39.0,"coord_origin":"BOTTOMLEFT","l":45.333333333333336,"r":537.3333333333334,"t":85.66666666666663},"charspan":[0,633],"page_no":1}],"self_ref":"#/texts/13","text":"Figure 4. Effect of SB 242784 on bone resorption activity as measured by serum cross-linked N-teleopeptides. Serum was obtained from each animal 96 hours after the first vitamin D injection in the experiment described in the Figure legend, and serum was also obtained from age-matched control rats. Each serum sample was analyzed to determine the level of cross-linked N-teleopeptides (OSTEOMARK NTx, Ostex) , specific marker for bone resorption activity (see Materials and Methods). Results are presented as meanSD a, P<0.01 compared with control; b, P<0.05 compared with vitamin D only; and c, P<0.0O1 compared with vitamin D only."},{"children":[],"content_layer":"body","label":"text","orig":"180","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":242.0,"coord_origin":"BOTTOMLEFT","l":182.33333333333334,"r":191.66666666666666,"t":248.66666666666663},"charspan":[0,3],"page_no":1}],"self_ref":"#/texts/14","text":"180"},{"children":[],"content_layer":"body","label":"text","orig":"160","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox