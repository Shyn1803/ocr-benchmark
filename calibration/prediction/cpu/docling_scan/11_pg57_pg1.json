        "x1": 0.9220657276995304,
        "y1": 0.5655172413793104
      },
      "text": "LORDS-ROOM. The stage-box in theatre was formerly so called. Jonson.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
