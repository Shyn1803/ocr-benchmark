        "x1": 0.916431924882629,
        "y1": 0.5258620689655172
      },
      "text": "LORDS-AND-LADIES See Bulls-and-Cows LORDSHIP . Supreme poner. (A.-s)",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
