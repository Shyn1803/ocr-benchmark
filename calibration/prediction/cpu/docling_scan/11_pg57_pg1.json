        "x1": 0.8103286384976527,
        "y1": 0.5787356321839081
      },
      "text": "LORDSWYK A traitor. Ritson.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
