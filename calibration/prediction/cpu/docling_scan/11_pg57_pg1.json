        "y0": 0.8045977011494253,
        "x1": 0.37746478873239436,
        "y1": 0.8183908045977012
      },
      "text": "Bot wlatsome glette and lopyrd blode.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
