        "y0": 0.7810344827586206,
        "x1": 0.1267605633802817,
        "y1": 0.792528735632184
      },
      "text": "And In myrke donjowne, in fowle stede of corrupcyowne,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
