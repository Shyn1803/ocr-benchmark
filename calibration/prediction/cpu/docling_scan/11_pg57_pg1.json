        "y0": 0.7908045977011494,
        "x1": 0.2591549295774648,
        "y1": 0.8057471264367816
      },
      "text": "Whare he had no fode,",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
