        "x1": 0.6103286384976525,
        "y1": 0.5367816091954023
      },
      "text": "LORD-SIZE .",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
        "x0": 0.4807511737089202,
