        "y0": 0.8666666666666667,
        "x1": 0.2892018779342723,
        "y1": 0.8844827586206897
      },
      "text": "LOPPING. Lame. Dorset.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
    {
      "block_type": "text",
      "box": {
        "page": 0,
