68229},"charspan":[0,25],"page_no":1}],"self_ref":"#/texts/1","text":"FROM THE PRINCIPALS DESK:"},{"children":[],"content_layer":"body","label":"text","orig":"Dear parents,","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":478.25331624348956,"coord_origin":"BOTTOMLEFT","l":174.33333333333334,"r":237.66666666666666,"t":491.58664957682294},"charspan":[0,13],"page_no":1}],"self_ref":"#/texts/2","text":"Dear parents,"},{"children":[],"content_layer":"body","label":"text","orig":"Great student achievement results from out of school events continue this week. In the International Competitions and Assessments for Schools Spelling test Aimun Nauman and Kevin Noronha both achieved Distinctions and Anosha Ahmed Ghori, Daiyan Zahid and Ramna Safda achieved Credits.   In the Writing test Christina LoGiudice achieved a High Distinction, Aimun Nauman and Henrissa Pama both achieved Distinctions and Anagha Janakiraman and Diayan Zahid achieved Credits. Congratulations to all students who entered and participated in these tests.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":360.25331624348956,"coord_origin":"BOTTOMLEFT","l":173.66666666666666,"r":552.0,"t":466.91998291015625},"charspan":[0,548],"page_no":1}],"self_ref":"#/texts/3","text":"Great student achievement results from out of school events continue this week. In the International Competitions and Assessments for Schools Spelling test Aimun Nauman and Kevin Noronha both achieved Distinctions and Anosha Ahmed Ghori, Daiyan Zahid and Ramna Safda achieved Credits.   In the Writing test Christina LoGiudice achieved a High Distinction, Aimun Nauman and Henrissa Pama both achieved Distinctions and Anagha Janakiraman and Diayan Zahid achieved Credits. Congratulations to all students who entered and participated in these tests."},{"children":[],"content_layer":"body","label":"text","orig":"This week a letter will be coming home to ask if you no longer require a paper edition of the weekly newsletter as you access it via the Prestons PS web page at This will assist the school in lowering our carbon footprint as well as reducing printing costs. We thank you for your support in this matter.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":275.2533162434896,"coord_origin":"BOTTOMLEFT","l":173.33333333333334,"r":554.6666666666666,"t":350.25331624348956},"charspan":[0,303],"page_no":1}],"self_ref":"#/texts/4","text":"This week a letter will be coming home to ask if you no longer require a paper edition of the weekly newsletter as you access it via the Prestons PS web page at This will assist the school in lowering our carbon footprint as well as reducing printing costs. We thank you for your support in this matter."},{"children":[],"content_layer":"body","label":"text","orig":"Next week is Literacy Numeracy Week and the school has planned several engaging student centred activities to celebrate including: Indigenous Book Mad Hatter's Picnic; Read-A-Thon; Literacy/Numeracy Fun As well, we will also be celebrating Fruit and Vegetable Week at the same time. Mrs Beavis has planned daily activities during play breaks for students to participate. What an exciting week to look forward to! Swap; Day.","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":171.58664957682288,"coord_origin":"BOTTOMLEFT","l":173.33333333333334,"r":557.6666666666666,"t":261.91998291015625},"charspan":[0,423],"page_no":1}],"self_ref":"#/texts/5","text":"Next week is Literacy Numeracy Week and the school has planned several engaging student centred activities to celebrate including: Indigenous Book Mad Hatter's Picnic; Read-A-Thon; Literacy/Numeracy Fun As well, we will also be celebrating Fruit and Vegetable Week at the same time. Mrs Beavis has planned daily activities during play breaks for students to participate. What an exciting week to look forward to! Swap; Day."},{"children":[],"content_layer":"body","label":"text","orig":"The Principal's Class of the Week Award goes to class 4BP who have demonstrated fantastic behaviour and engagement in learning over the past weeks. Congratulations students, Mrs Boss and Mrs Bayley-Patton (class teachers) .","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":114.25331624348962,"coord_origin":"BOTTOMLEFT","l":173.66666666666666,"r":545.6666666666666,"t":158.25331624348962},"charspan":[0,223],"page_no":1}],"self_ref":"#/texts/6","text":"The Principal's Class of the Week Award goes to class 4BP who have demonstrated fantastic behaviour and engagement in learning over the past weeks. Congratulations students, Mrs Boss and Mrs Bayley-Patton (class teachers) ."},{"children":[],"content_layer":"body","label":"text","orig":"Be Safe","parent":{"$ref":"#/pictures/0"},"prov":[{"bbox":{"b":77.58664957682288,"coord_origin":"BOTTOMLEFT","l":235.0,"r":283.0,"t":90.25331624348962},"charspan":[0,7],"page_no":1}],"self_ref":"#/texts/7","text":"Be Safe"},{"children":[],"content_layer":"body","label":"text","orig":"Be","parent":{"$ref":"#/pictures/1"},"prov":[{"bbox":{"b":79.25331624348962,"coord_origin":"BOTTOMLEFT","l":368.0,"r":384.6666666666667,"t":89.91998291015625},"charspan":[0,2],"page_no":1}],"self_ref":"#/texts/8","text":"Be"},{"children":[],"content_layer":"body","label":"text","orig":"8 Yearning {oaring","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":4.9439588426540695,"coord_origin":"BOTTOMLEFT","l":280.0148684556841,"r":402.30875376054723,"t":30.561131818248214},"charspan":[0,18],"page_no":1}],"self_ref":"#/texts/9","text":"8 Yearning {oaring"},{"children":[],"content_layer":"body","label":"text","orig":"Be a Learner","parent":{"$ref":"#/pictures/2"},"prov":[{"bbox":{"b":77.25331624348962,"coord_origin":"BOTTOMLEFT","l":455.6666666666667,"r":535.6666666666666,"t":91.25331624348962},"charspan":[0,12],"page_no":1}],"self_ref":"#/texts/10","text":"Be a Learner"},{"children":[],"content_layer":"body","label":"text","orig":"KURRAJONG ROAD PRISTONS PO BOX 230 P: 02 9602 7435 F:02 9821 1/92","parent":{"$ref":"#/body"},"prov":[{"bbox":{"b":624.5866495768229,"coord_or