    "bounding box" : [ 130.56, 287.124, 381.437, 308.525 ],
    "font" : "NimbusSanL-LigCon",
    "font size" : 9.5,
    "text color" : "[0.0]",
    "content" : "Zu schwaches Spülprogramm. Stärkeres Spülprogramm wählen. Empfindlichkeit der Sensorik erhöhen."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
