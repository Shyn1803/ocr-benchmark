    "font" : "NimbusSanL-LigConIta",
    "font size" : 9.5,
    "text color" : "[0.0]",
    "content" : "Siebe 1Z verschmutzt. Siebe reinigen. ~ \"Reinigen und warten\" auf Seite 35"
