    "bounding box" : [ 130.56, 360.624, 389.326, 382.025 ],
    "font" : "NimbusSanL-LigCon",
    "font size" : 9.5,
    "text color" : "[0.0]",
    "content" : "Sprüharmdüsen verstopft. Sprüharmdüsen reinigen. ~ \"Reinigen und warten\" auf Seite 35"
