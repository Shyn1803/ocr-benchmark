    "bounding box" : [ 72.0, 530.199, 353.453, 563.387 ],
    "font" : "CMR12",
    "font size" : 11.955,
    "text color" : "[0.0]",
    "content" : "V (T1) ∩ V (Tj) ̸= ∅ it follows that"
