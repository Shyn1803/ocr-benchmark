    "font" : "Palatino-Roman",
    "font size" : 9.2,
    "text color" : "[0.0, 0.0, 0.0]",
    "content" : "hardware and inform the public about its mandate."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 8,
    "page number" : 1,
    "bounding box" : [ 51.023, 504.914, 206.687, 537.525 ],
    "font" : "Palatino-Roman",
    "font size" : 9.2,
    "text color" : "[0.0, 0.0, 0.0]",
    "content" : "This annual event was packed with a wide variety of activities for the whole family, including food stalls"
