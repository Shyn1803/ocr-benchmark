    "id" : 52,
    "page number" : 1,
    "bounding box" : [ 20.6, 62.69, 205.037, 69.11 ],
    "font" : "GlyphLessFont",
    "font size" : 6.417,
    "text color" : "[0.0]",
    "content" : "estimated at 15,000sq.m. The ports on the coast are the mouths"
  }, {
