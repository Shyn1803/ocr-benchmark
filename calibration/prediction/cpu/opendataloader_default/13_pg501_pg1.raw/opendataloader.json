    "page number" : 1,
    "bounding box" : [ 214.8, 100.795, 397.834, 112.844 ],
    "font" : "GlyphLessFont",
    "font size" : 6.028,
    "text color" : "[0.0]",
    "content" : "aaa chiefs were present at the federal durbar held at Kuala angsar in Perak in 1897."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 48,
