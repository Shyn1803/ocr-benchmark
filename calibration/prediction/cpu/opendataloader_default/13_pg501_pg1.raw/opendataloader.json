    "font" : "GlyphLessFont",
    "font size" : 6.222,
    "text color" : "[0.0]",
    "content" : "bounded on the N. by the independent native states of Kelantan"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
