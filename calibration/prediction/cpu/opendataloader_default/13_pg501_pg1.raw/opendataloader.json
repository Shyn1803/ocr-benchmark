    "page number" : 1,
    "bounding box" : [ 21.0, 159.09, 207.664, 164.926 ],
    "font" : "GlyphLessFont",
    "font size" : 5.833,
    "text color" : "[0.0]",
    "content" : "federation is at Seremban in Sungei Ujong, where the Resident is"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 93,
    "page number" : 1,
    "bounding box" : [ 214.6, 159.013, 397.805, 164.46 ],
    "font" : "GlyphLessFont",
    "font size" : 5.444,
    "text color" : "[0.0]",
    "content" : "strength for a second disturbance, and raided Pahang from Kelantan,"
  }, {
