    "bounding box" : [ 214.6, 135.906, 398.268, 141.548 ],
    "font" : "GlyphLessFont",
    "font size" : 5.639,
    "text color" : "[0.0]",
    "content" : "and Kelantan by the Resident of Pahang (Mr Hugh Clifford) in 1895,"
  }, {
