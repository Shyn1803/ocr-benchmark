    "bounding box" : [ 21.0, 69.983, 205.898, 76.597 ],
    "font" : "GlyphLessFont",
    "font size" : 6.611,
    "text color" : "[0.0]",
    "content" : "130m.  The state is the largest in the peninsula, its area being"
  }, {
