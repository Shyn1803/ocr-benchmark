  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 87,
    "page number" : 1,
    "bounding box" : [ 214.6, 216.691, 397.424, 222.138 ],
    "font" : "GlyphLessFont",
    "font size" : 5.444,
    "text color" : "[0.0]",
