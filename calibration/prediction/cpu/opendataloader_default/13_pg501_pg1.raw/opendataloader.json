    "id" : 100,
    "page number" : 1,
    "bounding box" : [ 214.6, 68.89, 398.135, 74.337 ],
    "font" : "GlyphLessFont",
    "font size" : 5.444,
    "text color" : "[0.0]",
    "content" : "in 1905 was estimated at 100,000, the increase being due to immigra-"
  }, {
    "type" : "paragraph",
