    "id" : 50,
    "page number" : 1,
    "bounding box" : [ 20.8, 77.29, 205.288, 83.71 ],
    "font" : "GlyphLessFont",
    "font size" : 6.417,
    "text color" : "[0.0]",
    "content" : "the greatest length is about 210 m., and greatest breadth about"
