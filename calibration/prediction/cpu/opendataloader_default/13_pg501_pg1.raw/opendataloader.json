    "bounding box" : [ 20.4, 114.103, 207.64, 127.927 ],
    "font" : "GlyphLessFont",
    "font size" : 6.417,
    "text color" : "[0.0]",
    "content" : "PAHANG, on the east coast of the peninsula, is situated between parallels 2° 28  and 3° 45  N. and 101° 30  and 103° 30  E. It is"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
