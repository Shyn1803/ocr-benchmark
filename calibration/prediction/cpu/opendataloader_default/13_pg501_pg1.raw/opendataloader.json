    "page number" : 1,
    "bounding box" : [ 372.4, 77.902, 397.899, 82.765 ],
    "font" : "GlyphLessFont",
    "font size" : 4.861,
    "text color" : "[0.0]",
    "content" : "Population."
  }, {
