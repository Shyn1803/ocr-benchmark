    "bounding box" : [ 20.8, 129.872, 168.039, 136.097 ],
    "font" : "GlyphLessFont",
    "font size" : 6.222,
    "text color" : "[0.0]",
    "content" : "of the pleasure resorts of this part of the peninsula."
  }, {
