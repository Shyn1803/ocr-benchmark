    "font" : "CMR10",
    "font size" : 10.909,
    "text color" : "[0.0]",
    "content" : "V := {u ∈ H1(D)2 : ∇ · u = 0, u|∂D = 0}. We denote the norms associated to H and V respectively as | · | and · ."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
