    "bounding box" : [ 28.351, 214.552, 263.079, 246.852 ],
    "font" : "Calibri-Light",
    "font size" : 9.5,
    "text color" : "[0.0, 0.0, 0.0]",
    "content" : "Deux conseillers par cantons élus lors des élections cantonales dans le Jura: 17 cantons, 34 conseillers en binôme élus pour six ans: 2015-2021"
  }, {
    "type" : "heading",
    "pdfua_tag" : "H3",
