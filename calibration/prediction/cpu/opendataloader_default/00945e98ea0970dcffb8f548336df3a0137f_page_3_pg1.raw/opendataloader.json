    "bounding box" : [ 348.858, 272.396, 538.716, 286.815 ],
    "font" : "TimesNewRoman-Italic",
    "font size" : 9.572,
    "text color" : "[0.0]",
    "content" : "miqi  ciqi  kiqi  Qi (i 1,2) (4)"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
