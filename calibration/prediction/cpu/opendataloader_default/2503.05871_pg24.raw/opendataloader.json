      "text color" : "[0.0]",
      "content" : "uz = 0, (A.4) P = −2νρx + δP(t,x,y), (A.5)",
      "kids" : [ ]
    } ]
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
