    "text color" : "[0.0]",
    "content" : "N"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 5,
    "page number" : 1,
    "bounding box" : [ 197.64, 491.189, 205.64, 514.712 ],
    "font" : "CMMI10",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "1 N"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 9,
    "page number" : 1,
    "bounding box" : [ 225.6, 497.588, 478.705, 507.992 ],
    "font" : "CMMI10",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "p(xk(t),xℓ(t))(xℓ(t) − xk(t)) + uk(t) dt + σdWk(t), (1)"
  }, {
    "type" : "image",
    "pdfua_tag" : "Figure",
    "id" : 6,
    "page number" : 1,
    "bounding box" : [ 197.628, 502.788, 206.748, 503.268 ],
    "alt_source" : "missing",
    "source" : "2503.09549_pg3_images/imageFile1.png"
  }, {
