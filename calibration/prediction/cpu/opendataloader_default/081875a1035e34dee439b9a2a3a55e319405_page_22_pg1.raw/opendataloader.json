      "content" : "• use many different diagnostics.",
      "kids" : [ ]
    } ]
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 13,
    "page number" : 1,
    "bounding box" : [ 305.471, 53.151, 551.811, 136.626 ],
    "font" : "Galliard-Roman",
    "font size" : 11.0,
    "text color" : "[0.0, 0.0, 0.0]",
    "content" : "The manufacture of some W76 replacement components, scheduled to begin in late 2006, will be based in part on the results of the DARHT W76 test series. Before manufacturing begins, LANL will conduct confirmatory experiments to ensure that the new components perform as well as those built"
