        "pdfua_tag" : "P",
        "id" : 2,
        "page number" : 1,
        "bounding box" : [ 109.161, 589.19, 142.213, 599.153 ],
        "font" : "CMR10",
        "font size" : 9.963,
        "text color" : "[0.0]",
        "content" : "H(x) ="
