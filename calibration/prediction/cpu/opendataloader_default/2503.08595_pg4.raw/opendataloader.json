    "bounding box" : [ 96.995, 609.393, 347.536, 620.302 ],
    "font" : "CMR10",
    "font size" : 10.909,
    "text color" : "[0.0]",
    "content" : "We first give the following result, extracted from [7]."
  }, {
    "type" : "paragraph",
