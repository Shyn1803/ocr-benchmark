    "font" : "ArialMT",
    "font size" : 9.427,
    "text color" : "[0.0]",
    "content" : "‘Pre-existing right’: any industrial and intellectual property right on pre-existing material; it may consist in a right of ownership, a licence right and/or right of use belonging to the contractor, the creator, the contracting authority as well as to any other third parties;"
  }, {
    "type" : "image",
    "pdfua_tag" : "Figure",
