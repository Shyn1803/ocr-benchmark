    "font" : "ArialMT",
    "font size" : 9.427,
    "text color" : "[0.0]",
    "content" : "‘Professional conflicting interest’: a situation in which the contractor’s previous or ongoing professional activities affect its capacity to implement the FWC or to perform a specific contract to an appropriate quality standard;"
