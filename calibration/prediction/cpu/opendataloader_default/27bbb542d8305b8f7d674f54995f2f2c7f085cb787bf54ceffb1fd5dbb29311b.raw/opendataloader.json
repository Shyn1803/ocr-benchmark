    "font" : "ArialMT",
    "font size" : 9.427,
    "text color" : "[0.0]",
    "content" : "‘Related person’: any natural or legal person who is a member of the administrative, management or supervisory body of the contractor or who has powers of representation, decision or control with regard to the contractor;"
