    "font size" : 9.427,
    "text color" : "[0.0]",
    "content" : "‘Pre-existing material’: any material, document, technology or know-how which exists prior to the contractor using it for the production of a result in the implementation of the FWC;"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
