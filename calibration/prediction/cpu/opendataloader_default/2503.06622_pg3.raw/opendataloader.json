    "font" : "CMMI10",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "dXt = ˜b(t,Xt,Yt)dt + σ(t,Xt,Yt)dBt(ω) + f(t,Xt,Yt)dBt⊥(ω)"
