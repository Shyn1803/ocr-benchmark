        "text color" : "[0.0]",
        "content" : "N ∈ {1 − 75, 77 − 83, 85 − 89, 91, 92, 94 − 96, 98 − 101, 103, 104, 107, 111, 118, 119, 121, 123, 125, 128, 131, 141− 143, 145, 155, 159, 167, 191}."
