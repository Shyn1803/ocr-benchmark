    "page number" : 1,
    "bounding box" : [ 43.681, 71.909, 282.715, 105.512 ],
    "font" : "CMTI10",
    "font size" : 9.963,
    "text color" : "[0.0, 0.0, 0.0, 1.0]",
    "content" : "Problem 1 (Informativity) Find conditions under which the data (X˙,X,U) are informative for stabilization."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 24,
    "page number" : 1,
    "bounding box" : [ 306.721, 683.91, 545.717, 717.512 ],
    "font" : "CMTI10",
    "font size" : 9.963,
    "text color" : "[0.0, 0.0, 0.0, 1.0]",
    "content" : "Problem 2 (Controller design) Suppose the data (X˙,X,U) are informative for stabilization. Find a controller u = K(x) satisfying K(0) = 0 and (8)."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
