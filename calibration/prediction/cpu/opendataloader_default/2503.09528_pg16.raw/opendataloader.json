    "bounding box" : [ 138.628, 295.371, 491.543, 308.123 ],
    "font" : "CMR12",
    "font size" : 11.955,
    "text color" : "[0.0]",
    "content" : "The thickness estimate holds for all Cb,D,j because of the self-similarity."
  }, {
