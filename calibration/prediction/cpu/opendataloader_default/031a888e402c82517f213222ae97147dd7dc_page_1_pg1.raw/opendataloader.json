    "pdfua_tag" : "P",
    "id" : 29,
    "page number" : 1,
    "bounding box" : [ 321.92, 162.717, 374.671, 173.015 ],
    "font" : "CMR9",
    "font size" : 8.97,
    "text color" : "[0.0]",
    "content" : "KL2(X, Y ) ="
  }, {
