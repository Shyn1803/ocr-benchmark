    "bounding box" : [ 51.0, 386.476, 389.6, 402.577 ],
    "font" : "TimesNewRoman",
    "font size" : 11.0,
    "text color" : "[0.0]",
    "content" : "The solution of the system (2.10) is obtained under the condition ε0µ0С02 =1"
  }, {
    "type" : "paragraph",
