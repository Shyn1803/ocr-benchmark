    "font size" : 6.974,
    "text color" : "[0.0]",
    "content" : "Let (dn,k)n,k∈N"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 4,
    "page number" : 1,
    "bounding box" : [ 72.0, 696.329, 540.0, 719.242 ],
    "font" : "NimbusRomNo9L-Regu",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "be an infinite lower-triangular matrix over R. If there exists a pair (d(t),h(t)) such that the (n,k)-th element of the matrix is defined as:"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 3,
    "page number" : 1,
    "bounding box" : [ 134.924, 706.302, 138.314, 711.283 ],
