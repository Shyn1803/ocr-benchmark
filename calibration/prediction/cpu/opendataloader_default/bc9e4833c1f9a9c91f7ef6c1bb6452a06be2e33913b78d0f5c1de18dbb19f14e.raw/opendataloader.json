    "bounding box" : [ 79.38, 511.944, 515.616, 539.093 ],
    "font" : "Times New Roman",
    "font size" : 12.0,
    "text color" : "[0.0]",
    "content" : "Any reduction in price does not affect the contractor’s actual or potential liability or the contracting authority’s rights under Article II.17."
