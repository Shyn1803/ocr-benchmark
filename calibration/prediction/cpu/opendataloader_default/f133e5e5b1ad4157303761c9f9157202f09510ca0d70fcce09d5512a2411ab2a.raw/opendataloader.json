      "font size" : 8.0,
      "text color" : "[0.0, 0.0, 0.0, 1.0]",
      "content" : "• US$650 million of 5.45% senior notes due in 2043 (the October 2043 Notes).",
      "kids" : [ ]
    } ]
  }, {
