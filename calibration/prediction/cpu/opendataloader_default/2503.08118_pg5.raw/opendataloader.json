    "number of list items" : 2,
    "list items" : [ {
      "type" : "list item",
      "pdfua_tag" : "LI",
      "page number" : 1,
      "bounding box" : [ 138.627, 464.666, 380.583, 474.629 ],
      "font" : "CMMI10",
      "font size" : 9.963,
      "text color" : "[0.0]",
      "content" : "i) The vectors in the regular refinement are irreducible.",
      "kids" : [ ]
    }, {
      "type" : "list item",
      "pdfua_tag" : "LI",
      "page number" : 1,
      "bounding box" : [ 138.627, 445.638, 485.327, 462.923 ],
      "font" : "CMMI10",
      "font size" : 9.963,
      "text color" : "[0.0]",
      "content" : "ii) The resolution graph obtaining from the refinement does not have any −1",
      "kids" : [ ]
    } ]
  }, {
    "type" : "paragraph",
