    "font size" : 9.12,
    "text color" : "[0.0, 0.0, 0.0]",
    "content" : "Organised & Conceptualised by Stefano Beggiora, Ca Foscari University, Venice Diana Riboli, Panteio University, Athens Lidia Guzy, Marginalised & Endangered Worldviews Study Centre, University College Cork, Cork Davide Torri, Heidelberg University, Heidelberg"
  }, {
    "type" : "heading",
    "pdfua_tag" : "H2",
    "id" : 56,
    "level" : "Subtitle",
    "page number" : 1,
    "bounding box" : [ 151.44, 234.267, 323.362, 250.587 ],
