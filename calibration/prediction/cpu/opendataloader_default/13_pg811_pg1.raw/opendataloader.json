    "page number" : 1,
    "bounding box" : [ 212.2, 459.52, 394.718, 465.356 ],
    "font" : "GlyphLessFont",
    "font size" : 5.833,
    "text color" : "[0.0]",
    "content" : "down to the time of the Revolution, when it was finally and com-"
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 65,
