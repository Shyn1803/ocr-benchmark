    "bounding box" : [ 42.346, 50.487, 152.362, 86.387 ],
    "font" : "Optima",
    "font size" : 10.0,
    "text color" : "[0.0, 0.0, 0.0, 1.0]",
    "content" : "- Tautisulku ja sen oikeaoppinen käyttö on viimeistään nyt saatava ru-"
  }, {
    "type" : "paragraph",
