    "text color" : "[0.0, 0.0, 0.0, 1.0]",
    "content" : "Hannele Nauholz, terveydenhuoltoeläinlääkäri, Eläintautien torjuntayhdistys ETT ry"
  }, {
    "type" : "heading",
    "pdfua_tag" : "H1",
    "id" : 15,
