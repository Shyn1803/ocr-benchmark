      "font" : "CMR10",
      "font size" : 10.909,
      "text color" : "[0.0]",
      "content" : "(2) If TorRi (R/I,M) ∈ S for 0 i n, then TorRi (N,M) ∈ S for 0 i n.",
      "kids" : [ ]
    } ]
  }, {
    "type" : "paragraph",
