      "text color" : "[0.0, 0.0, 0.0, 1.0]",
      "content" : "3. s4 regulation 3(2)(a): reasonable steps cases (8 cases = 5.1% caseload): l 62.5% allowed, 37.5% dismissed",
      "kids" : [ ]
    } ]
