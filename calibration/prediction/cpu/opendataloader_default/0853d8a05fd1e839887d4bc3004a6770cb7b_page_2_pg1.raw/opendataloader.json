    "id" : 31,
    "page number" : 1,
    "bounding box" : [ 311.973, 189.901, 563.031, 213.86 ],
    "font" : "NimbusRomNo9L-Regu",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "The new ciphertext-only attack against a BRM is described below:"
  }, {
