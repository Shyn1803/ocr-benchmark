    "page number" : 1,
    "bounding box" : [ 240.962, 177.776, 370.322, 188.432 ],
    "font" : "CMMI10",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "H0 = H ⊳ H1 ⊳ ... ⊳ Hn = L."
  }, {
    "type" : "paragraph",
    "pdfua_tag" : "P",
    "id" : 22,
    "page number" : 1,
    "bounding box" : [ 133.802, 146.669, 477.407, 168.532 ],
    "font" : "SFTI1000",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "L’indice d’un sous-idéal désigne la longueur minimale d’une suite de la forme précédente."
  }, {
