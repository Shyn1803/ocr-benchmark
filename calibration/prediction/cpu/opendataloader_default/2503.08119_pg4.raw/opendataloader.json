    "font" : "TeXGyreTermesX-Regular",
    "font size" : 10.909,
    "text color" : "[0.0]",
    "content" : "We begin by reviewing the history of this problem:"
  }, {
    "type" : "list",
    "pdfua_tag" : "L",
    "id" : 5,
    "level" : "1",
    "page number" : 1,
    "bounding box" : [ 85.68, 499.222, 539.924, 666.066 ],
