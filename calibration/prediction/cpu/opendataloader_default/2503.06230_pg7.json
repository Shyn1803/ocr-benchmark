        "x1": 0.6051013071895425,
        "y1": 0.7755353535353535
      },
      "text": "H0 = H ⊳ H1 ⊳ ... ⊳ Hn = L.",
      "html": null,
      "level": null,
      "section_hierarchy": []
    },
