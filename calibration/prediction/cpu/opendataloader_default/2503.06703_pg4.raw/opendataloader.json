    "id" : 25,
    "page number" : 1,
    "bounding box" : [ 48.964, 314.117, 300.024, 338.076 ],
    "font" : "NimbusRomNo9L-Regu",
    "font size" : 9.963,
    "text color" : "[0.0]",
    "content" : "Under the above assumptions, the N-dimensional UL channel from UE k to AP m is [23]"
