          "bounding box" : [ 82.2, 614.208, 261.359, 624.832 ],
          "font" : "CMR10",
          "font size" : 9.963,
          "text color" : "[0.0]",
          "content" : "(3) Aκ(X) contains an ample X-module.",
          "kids" : [ ]
